            <button class="btn" id="doFix" title="棰樺簱绛旀鍐欓敊浜?/ 鑷繁鐐归敊浜嗭細鍙互鍦ㄨ繖閲屾敼锛屽彧褰卞搷鏈満鐨勫垽鍒?>${fixedAns ? '鏀圭瓟妗堬紙宸蹭慨姝ｏ級' : '鏀圭瓟妗?}</button>
            ${delT ? '<button class="btn" id="doEditQ" title="鐩存帴鏀硅繖閬撻鐨勯骞?/ 閫夐」 / 绛旀 / 瑙ｆ瀽锛堝啓鍥為搴擄紝鍐呯疆棰樺簱鍙锛?>鉁?鏀归鐩?/button>' : ''}
            <button class="btn" id="doAI" title="璁?AI 鍐欒В鏋愶紙鍙互甯︿笂鏈湴鐭ヨ瘑搴撶殑璧勬枡锛?>AI 瑙ｆ瀽</button>
            <button class="btn" id="doVariant" title="璁?AI 鐓ц繖閬撻鍑哄嚑閬撳悓鑰冪偣鐨勬柊棰橈紙鍙樺紡棰橈級锛岃繕鑳借窡搴撻噷鐩镐技鐨勮€侀骞舵帓瀵规瘮">AI 鍙樺紡棰?/button>
            <button class="btn" id="doWrongToggle" title="鎵嬪姩鎶婅繖閬撻鏀捐繘 / 绉诲嚭閿欓鏈紙涓嶅奖鍝嶄綔绛旇褰曢噷鐨勫閿欐鏁帮級">${(ANS[fk] && ANS[fk].wrong) ? '鈫?绉诲嚭閿欓鏈? : '锛?鍔犲叆閿欓鏈?}</button>
            ${delT ? '<button class="btn danger" id="doDelQ" title="鎶婅繖閬撻浠庨搴撻噷姘镐箙鍒犳帀锛堝畠鐨勪綔绛旇褰?/ 鏀惰棌 / 瑙ｆ瀽浼氫竴璧锋竻锛?>馃棏 鍒犻櫎鏈</button>' : ''}
