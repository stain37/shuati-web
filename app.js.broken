      <div class="actions qz-more">
        ${qType(q, ansOf(fk, q)) === 'X' ? `<button class="btn primary" id="doSubmit" ${locked || !picked.length ? 'disabled' : ''}>鎻愪氦绛旀</button>` : ''}
        ${speed ? '' : `<button class="btn" id="doMore" title="鏀硅В鏋?/ 鏀圭瓟妗?/ AI 瑙ｆ瀽 / AI 鍙樺紡棰?鈥斺€?杩欎簺绠＄悊鍔ㄤ綔鏀惰繘鎶藉眽閲岋紝涓嶆憡鍦ㄩ鐩笅闈?>鈰?鏇村</button>`}
      </div>
      ${speed ? '' : `<div class="qsheet" id="qSheet" hidden>
