}
function setLook(k, v) { SET[k] = v; writeLS(LS.set, SET); applyLook(); }
if (window.matchMedia) {
  try { window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { if (SET.theme !== 'light' && SET.theme !== 'dark') applyLook(); }); } catch (e) {}
}
applyLook();

/* ---------- 棰樺簱 ---------- */
let LIVE_PAPER = null;       // 姣忔棩澶嶄範杩欑被銆屼复鏃跺嵎銆嶏細鍙湪鍐呭瓨閲岋紝涓嶈繘濂楀嵎鍒楄〃銆佷笉鍐?localStorage
let _bankCache = null;
function invalidateBanks() { _bankCache = null; if (typeof bumpHay === 'function') bumpHay(); }

function allBanks() {
  if (!_bankCache) {
    const base = (window.__BANKS__ || []).map(b => normalizeBank(b, 'builtin'))
      .concat(LOCAL.map(b => normalizeBank(b, 'local')));
    _bankCache = base.concat(paperBanks(base));
  }
  return _bankCache;
}
function baseBanks() { return allBanks().filter(b => !b.paper); }
function bankById(id) { return allBanks().find(b => b.id === id); }

/* 涓婚〉棰樺簱鎺掑簭 UI 鍦?cat.js锛堢湡姝ｆ覆鏌撻椤电殑鏄?cat.js 鐨?catRenderHook锛夈€?   杩欓噷鍙繚鐣欏缓搴撴椂闂?createdAt锛屼緵銆屾渶杩戞坊鍔犮€嶆帓搴忕敤銆?*/
function findQIn(base, k) {
  for (const b of base) {
    const pre = b.id + '#';
    if (k.indexOf(pre) === 0) {
      const qid = k.slice(pre.length);
      const q = b.questions.find(x => String(x.id) === String(qid));
      if (q) return { bank: b, q: q };
    }
  }
  return null;
}
function paperBanks(base) {
  const out = [];
  (LIVE_PAPER ? PAPERS.concat([LIVE_PAPER]) : PAPERS).forEach(p => {
    const qs = [];
    (p.keys || []).forEach(k => {
      const f = findQIn(base, k);
      if (!f) return;
      qs.push(Object.assign({}, f.q, { id: 'p' + (qs.length + 1), _srcKey: k }));
    });
    if (qs.length) out.push({
      id: p.id, title: p.title || '涓存椂濂楀嵎', subtitle: (p.exam ? '妯℃嫙鑰冭瘯 路 ' : '涓存椂濂楀嵎 路 ') + qs.length + ' 棰?,
      paper: true, exam: !!p.exam, duration: p.duration || 0, createdAt: p.createdAt || 0, questions: qs
    });
  });
  return out;
}

function normalizeBank(b, source) {
  const qs = (b.questions || []).map((q, i) => normalizeQ(q, i + 1));
  const o = { id: b.id || ('bank-' + i2s()), title: b.title || '鏈懡鍚嶉搴?, subtitle: b.subtitle || '', source: source, paper: false, cat: (b.cat == null || b.cat === '' ? null : String(b.cat)), questions: qs };
  if (b.createdAt) o.createdAt = +b.createdAt || 0;   /* 寤哄簱鏃堕棿锛氥€屾渶杩戞坊鍔犮€嶆帓搴忕敤锛涜€佹暟鎹病鏈夎繖瀛楁锛屾帓搴忚蛋鍏滃簳 */
  if (b.ord != null) o.ord = +b.ord || 0;      // 鐩綍鍐呯殑鎵嬫帓椤哄簭
  return o;
}
function normalizeQ(q, fallbackId) {
  const opts = (q.options || []).map(String);
  let ans = q.answer == null ? [] : (Array.isArray(q.answer) ? q.answer : String(q.answer).replace(/[^A-Ha-h]/g, '').split(''));
  ans = Array.from(new Set(ans.map(a => String(a).toUpperCase()))).filter(a => 'ABCDEFGH'.includes(a)).sort();
  const o = {
    id: (q.id == null ? fallbackId : q.id),
    stem: String(q.stem || ''),
    options: opts,
    answer: ans,
    explain: String(q.explain || ''),
    group: q.group ? String(q.group) : '',
    groupTitle: q.groupTitle ? String(q.groupTitle) : ''
  };
  if (q._srcKey) o._srcKey = q._srcKey;
  return o;
}
function i2s() { return Math.random().toString(36).slice(2, 8); }

const qType = (q, ans) => ((ans || q.answer || []).length > 1 ? 'X' : 'A');
const typeLabel = (q, ans) => ((ans || q.answer || []).length > 1 ? '澶氶€? : '鍗曢€?);
/* 鈶?棰樺瀷锛圓BX锛夛細鏄惧紡瀛楁浼樺厛锛涘惁鍒欐寜缁撴瀯鎺ㄦ柇 鈥斺€?   X锛氱瓟妗堝浜庝竴涓紱B1锛氭湁鍏辩敤棰樺共锛堥厤浼嶉锛夛紱A2锛氶骞插儚鐥呬緥锛堟偅鑰?鐢凤紝45 宀侊級锛涘叾浣?A1銆?*/
function qTypeOf(q) {
  if (!q) return 'A1';
  var t = String(q.type || '').toUpperCase().replace(/[^ABXC0-9]/g, '');
  if (/^(A1|A2|B1|X|C)$/.test(t)) return t;
  if ((q.answer || []).length > 1) return 'X';
  if (q.group) return 'B1';
  var s = String(q.stem || '');
  if (/鎮ｈ€厊鐥呬汉|鐢穂锛?銆乚?\s*\d{1,2}\s*宀亅濂砙锛?銆乚?\s*\d{1,2}\s*宀亅\d{1,2}\s*宀乕鐢峰コ]鎬?.test(s)) return 'A2';
  return 'A1';
}
const TYPE_NAMES = { A1: 'A1 鍨嬶紙鍗曢€夛級', A2: 'A2 鍨嬶紙鐥呬緥锛?, B1: 'B1 鍨嬶紙閰嶄紞锛?, X: 'X 鍨嬶紙澶氶€夛級' };
function qTypeName(t) { return TYPE_NAMES[t] || t || ''; }
const key = (bankId, qid) => bankId + '#' + qid;
const kOf = (bank, q) => key(bank.id, q.id);
/* 瑗跨患鐪熼鍒嗗€硷細165 閬擄紝婊″垎 300銆傛寜**棰樺彿锛堥鐩湪鍗峰瓙閲岀殑椤哄簭锛?*绠楋紝涓嶆槸鎸夐鍨嬶細
   1鈥?0 姣忛 1.5锛?1鈥?15 姣忛 2锛?16鈥?35 姣忛 1.5锛?36鈥?65 姣忛 2銆?   鍒嗗€煎鐓э細A 鍨?1鈥?0锛?.5锛夌敓鐞?1鈥?6銆佺敓鍖?17鈥?8銆佺梾鐞?29鈥?0锛?   41鈥?15锛?锛夊唴绉?41鈥?6銆佸绉?57鈥?7銆佸唴绉戠梾渚?68鈥?2銆佸绉戠梾渚?93鈥?07銆佷汉鏂?108鈥?15锛?   B 鍨?116鈥?35锛?.5锛夌敓鐞?116鈥?19銆佺敓鍖?120鈥?23銆佺梾鐞?124鈥?27銆佸唴绉?128鈥?31銆佸绉?132鈥?35锛?   X 鍨?136鈥?65锛?锛夌敓鐞?136鈥?41銆佺敓鍖?142鈥?47銆佺梾鐞?148鈥?53銆佸唴绉?154鈥?59銆佸绉?160鈥?65銆?   棰樺簱/濂楀嵎姝ｅソ 165 棰樻椂鎸夎繖涓〃绠楋紱涓嶆槸 165 棰樼殑搴撻€€鍥炴寜棰樺瀷浼帮紙鍗曢€?1.5銆佸閫?2锛夛紝涓嶅奖鍝嶅垽鍒嗐€?*/
const XZ_LEN = 165;
const XZ_PT = n => (n >= 1 && n <= XZ_LEN) ? ((n <= 40 || (n >= 116 && n <= 135)) ? 1.5 : 2) : 0;
const XZ_SUB = [[1, 16, '鐢熺悊'], [17, 28, '鐢熷寲'], [29, 40, '鐥呯悊'], [41, 56, '鍐呯'], [57, 67, '澶栫'],
  [68, 92, '鍐呯'], [93, 107, '澶栫'], [108, 115, '浜烘枃'],
  [116, 119, '鐢熺悊'], [120, 123, '鐢熷寲'], [124, 127, '鐥呯悊'], [128, 131, '鍐呯'], [132, 135, '澶栫'],
  [136, 141, '鐢熺悊'], [142, 147, '鐢熷寲'], [148, 153, '鐥呯悊'], [154, 159, '鍐呯'], [160, 165, '澶栫']];
const XZ_SUB_ORDER = ['鐢熺悊', '鐢熷寲', '鐥呯悊', '鍐呯', '澶栫', '浜烘枃'];
const xzSubOf = n => { for (let i = 0; i < XZ_SUB.length; i++) { const r = XZ_SUB[i]; if (n >= r[0] && n <= r[1]) return r[2]; } return ''; };
const isXzPaper = list => Array.isArray(list) && list.length === XZ_LEN;
const qScore = q => (qType(q, (q && q.answer) || []) === 'X' ? 2 : 1.5);
/* 绗?i 棰橈紙0 鍩猴級鐨勫垎鍊硷細165 棰樼殑鍗峰瓙鎸夐鍙疯〃锛屽叾瀹冩寜棰樺瀷浼?*/
function ptAt(list, i) {
  if (isXzPaper(list)) return XZ_PT(i + 1);
  return qScore(list[i]);
}
function bankScore(bank) {
  const qs = (bank && bank.questions) || [];
  let s = 0;
  qs.forEach((q, i) => { s += ptAt(qs, i); });
  return Math.round(s * 10) / 10;
}
/* 165 棰樼殑鍗峰瓙缁欎竴浠姐€屽悇绉戞弧鍒嗐€嶆槑缁嗭紝鍏跺畠搴撹繑鍥?null */
function bankScoreBreak(bank) {
  const qs = (bank && bank.questions) || [];
  if (!isXzPaper(qs)) return null;
  const m = {};
  qs.forEach((q, i) => { const sub = xzSubOf(i + 1) || '鍏朵粬'; m[sub] = (m[sub] || 0) + XZ_PT(i + 1); });
  return m;
}
function bankScoreText(bank) {
  const t = bankScore(bank), m = bankScoreBreak(bank);
  if (!m) return '婊″垎 ' + t;
  return '婊″垎 ' + t + '锛? + XZ_SUB_ORDER.filter(s => m[s]).map(s => s + ' ' + m[s]).join('锛?) + '锛?;
}
/* 棰樺彿鏄剧ず锛氫复鏃跺鍗烽噷鐨勯鐩?id 鏄?p1/p2鈥︼紙paperBanks 缁欑殑閲嶇紪鍙凤級锛岃鍘绘帀鍓嶇紑 p锛?   棰樺簱 id 涓嶆槸绾暟瀛楃殑锛堟瘮濡傚鍏ユ椂缁欑殑 q1銆乽uid 閭ｇ锛夛紝灏遍€€鍥炪€屽畠鍦ㄩ搴撻噷鎺掔鍑犮€嶏紝
   鍏嶅緱鐣岄潰涓婂啋鍑恒€岀 q1 棰樸€嶈繖绉嶅唴閮ㄧ紪鍙枫€?   list 浼犻搴?璇曞嵎鐨勯鐩暟缁勶紱涓嶄紶灏卞彧鑳藉師鏍锋樉绀恒€?*/
const qNo = (q, list) => {
  const raw = String(q && q.id == null ? '' : q.id);
  const m = raw.match(/^p?(\d+)$/);
  if (m) return m[1];
  if (list && list.length) {
    const at = list.findIndex(x => String(x.id) === raw);
    if (at >= 0) return String(at + 1);
  }
  return raw || '?';
};
const favKey = (bank, q) => (bank.paper && q._srcKey) ? q._srcKey : key(bank.id, q.id);

/* 浣滅瓟璁板綍 */
function recOf(k) {
  const a = ANS[k];
  if (!a) return null;
  if (a.tries == null) { a.tries = 1; a.wrong = a.ok ? 0 : 1; a.ts = a.ts || 0; }
  return a;
}
const answered = k => { const a = ANS[k]; return !!a && !a.redo; };
/* 鍒版湡鏃堕棿锛氱瓟閿欑殑棰樺綋澶╁洖鍒伴槦鍒楋紝绛斿鍚庢寜闂撮殧鎺掓湡 */
/* 澶嶄範鎺掓湡鍙拡瀵广€屽仛閿欒繃銆嶇殑棰樷€斺€旀瘡鏃ュ涔?= 閿欓闆嗙殑鎺掓湡 */
function inSrs(k) { const a = ANS[k]; return !!a && (a.wrong || 0) > 0; }
function dueOf(k) {
  const a = ANS[k];
  if (!a) return null;
  return (a.due == null ? (a.ts || 0) : a.due);
}
function isDue(k) {
  if (!inSrs(k)) return false;
  const d = dueOf(k);
  return d != null && d <= Date.now();
}
function rateOf(a) { if (!a || !a.tries) return 0; return Math.round((a.tries - (a.wrong || 0)) / a.tries * 100); }
function noteOf(k) { return NOTES[k] || null; }
function explainOf(k, q) { const n = NOTES[k]; return (n && n.text) ? n.text : (q.explain || ''); }

/* ============================================================
   澶嶄範鏇茬嚎锛圫RS锛夛細鍙€夋ā寮?+ 鍙嚜瀹氫箟鍒濆鍙傛暟
   ============================================================ */
const SRS_PRESETS = {
  sm2: { label: '缁忓吀锛堥粯璁わ級', first: 1, second: 3, factor: 'ease', ease0: 2.5, easeUp: 0, easeDown: 0.2, minEase: 1.3, maxEase: 3, wrongIvl: 1, wrongToday: true, maxIvl: 365, daily: 0,
    desc: '绛斿锛? 鈫?3 鈫?闂撮殧脳鏄撳害锛涚瓟閿欙細鎵撳洖 1 澶┿€佹槗搴?-0.2锛屽綋澶╅噸鏂版帓闃? },
  anki: { label: 'Anki 椋庢牸', first: 1, second: 4, factor: 'ease', ease0: 2.5, easeUp: 0.15, easeDown: 0.2, minEase: 1.3, maxEase: 3, wrongIvl: 1, wrongToday: true, maxIvl: 365, daily: 0,
    desc: '姣曚笟 1 鈫?4 澶╋紝涔嬪悗闂撮殧脳鏄撳害锛涚瓟瀵规槗搴?+0.15锛岃秺鐔熺殑棰橀棿闅旀定寰楄秺蹇? },
  fast: { label: '蹇€熼€氳繃锛堥棿闅旂炕鍊嶏級', first: 1, second: 2, factor: 2, ease0: 2.5, easeUp: 0, easeDown: 0.2, minEase: 1.3, maxEase: 3, wrongIvl: 1, wrongToday: true, maxIvl: 30, daily: 0,
    desc: '闂撮殧鍥哄畾缈诲€嶃€佹渶闀?30 澶╋細閫傚悎鑰冨墠鎶婃暣鏈搴撳埛鐔? },
  sprint: { label: '鑰冨墠鍐插埡锛堢煭鍛ㄦ湡锛?, first: 1, second: 1, factor: 1.5, ease0: 2.5, easeUp: 0, easeDown: 0.2, minEase: 1.3, maxEase: 3, wrongIvl: 1, wrongToday: true, maxIvl: 10, daily: 60,
    desc: '1 鈫?1 鈫?脳1.5銆佹渶闀?10 澶╋紝澶╁ぉ瑙侀潰锛涢粯璁ゆ瘡澶╂渶澶氬涔?60 棰? },
  longterm: { label: '闀挎湡璁板繂锛堟參閫燂級', first: 2, second: 7, factor: 'ease', ease0: 2.6, easeUp: 0.1, easeDown: 0.15, minEase: 1.5, maxEase: 3.2, wrongIvl: 2, wrongToday: false, maxIvl: 500, daily: 0,
    desc: '2 鈫?7 鈫?闂撮殧脳鏄撳害锛岀瓟閿欓€€ 2 澶╁啀瑙侊細棰樺皯鑰岀ǔ锛岄€傚悎闀挎湡绉疮' },
  custom: { label: '鑷畾涔?, first: 1, second: 3, factor: 'ease', ease0: 2.5, easeUp: 0, easeDown: 0.2, minEase: 1.3, maxEase: 3, wrongIvl: 1, wrongToday: true, maxIvl: 365, daily: 0,
    desc: '鑷畾涔夛細瀹屽叏鎸変笅闈㈠～鐨勫弬鏁版潵' }
};
const SRS_FIELDS = ['first', 'second', 'factor', 'ease0', 'easeUp', 'easeDown', 'minEase', 'maxEase', 'wrongIvl', 'wrongToday', 'maxIvl', 'daily'];
function srsCfg() {
  const mode = SRS_PRESETS[SRS.mode] ? SRS.mode : 'sm2';
  const p = SRS_PRESETS[mode];
  const c = { mode: mode, label: p.label, desc: p.desc };
  SRS_FIELDS.forEach(k => { c[k] = (SRS[k] == null ? p[k] : SRS[k]); });
  return c;
}
function srsSave() { writeLS(LS.srs, SRS); }
/* 閫夋ā寮忥紳鎶婅妯″紡鐨勬帹鑽愬€间竴娆℃€у～濂斤紝涔嬪悗杩樿兘閫愰」寰皟 */
function setSrsMode(mode) {
  if (!SRS_PRESETS[mode]) return;
  SRS.mode = mode;
  SRS_FIELDS.forEach(k => { SRS[k] = SRS_PRESETS[mode][k]; });
  srsSave();
}
/* 鎵嬪姩鏀逛换涓€椤?鈫?鑷姩鍙樻垚銆岃嚜瀹氫箟銆嶏紝鍏跺畠椤逛繚鐣欏綋鍓嶅€?*/
function srsSetField(f, v) {
  const c = srsCfg();
  SRS_FIELDS.forEach(k => { SRS[k] = c[k]; });
  SRS[f] = v;
  SRS.mode = 'custom';
  srsSave();
}
/* 鍙畻涓嬩竴妗ｏ紝渚夸簬棰勮 */
function srsNext(ivl, ease, ok, c) {
  c = c || srsCfg();
  if (ok) {
    if (!ivl || ivl < c.first) ivl = c.first;
    else if (ivl <= c.first) ivl = c.second;
    else ivl = Math.round(ivl * (c.factor === 'ease' ? ease : (+c.factor || 2)));
    ease = Math.min(c.maxEase, ease + (+c.easeUp || 0));
    ivl = Math.max(1, Math.min(c.maxIvl, ivl));
  } else {
    ivl = Math.max(1, +c.wrongIvl || 1);
    ease = Math.max(c.minEase, ease - (+c.easeDown || 0));
  }
  return { ivl: ivl, ease: Math.round(ease * 100) / 100 };
}
function srsPreview(c) {
  c = c || srsCfg();
  let ivl = 0, ease = +c.ease0 || 2.5;
  const out = [];
  for (let i = 0; i < 8; i++) { const r = srsNext(ivl, ease, true, c); ivl = r.ivl; ease = r.ease; out.push(ivl); }
  return out;
}
function srsPreviewText(c) {
  c = c || srsCfg();
  return '绛斿鍚庣殑闂撮殧锛? + srsPreview(c).join(' 鈫?') + ' 澶┿€€路銆€绛旈敊锛?
    + (c.wrongToday ? '褰撳ぉ閲嶆柊鎺掗槦' : '閫€ ' + Math.max(1, +c.wrongIvl || 1) + ' 澶?)
    + '锛屾槗搴?-' + (+c.easeDown || 0)
    + (c.daily ? '銆€路銆€姣忓ぉ鏈€澶氬涔?' + c.daily + ' 棰? : '');
}

/* ============================================================
   鎵嬪姩淇绛旀锛氬彧鏀规湰鏈虹殑鍒ゅ垎渚濇嵁锛岄搴撴枃浠朵笉鍔?   閿笌閿欓鏈?鏀惰棌涓€鑷达紙濂楀嵎銆佹ā鑰冮噷鐨勯璁板湪鍘熼涓婏級
   ============================================================ */
function fixOf(k) { const f = FIX[k]; return (Array.isArray(f) && f.length) ? f.slice() : null; }
function hasFix(k) { return !!fixOf(k); }
function ansOf(k, q) { return fixOf(k) || ((q && q.answer) ? q.answer : []); }
function setFix(k, letters) {
  letters = Array.from(new Set((letters || []).map(x => String(x).toUpperCase()).filter(a => 'ABCDEFGH'.includes(a)))).sort();
  if (letters.length) {
    FIX[k] = letters;
    /* 鍒犻鏃朵細缁?FIX 璁拌繃澧撶锛? 澶╁唴鍙堟妸杩欓亾棰橈紙閲嶆柊瀵煎叆鍚庯級淇簡绛旀鐨勮瘽锛?       澧撶浼氭妸杩欐鍐欏叆鎸℃帀锛岃繖閲屼富鍔ㄦ妸澧撶鍒犳帀鈥斺€旇窡銆屽彇娑堟敹钘?鈫?鎾ら攢銆嶄竴涓璺?*/
    try { if (TOMB && TOMB.fix && TOMB.fix[k]) { delete TOMB.fix[k]; writeLS(TOMB_KEY, TOMB); } } catch (e) {}
  } else delete FIX[k];
  saveFix();
}
/* 鎸夋柊绛旀閲嶅垽杩欐潯浣滅瓟璁板綍锛氬師鏉ユ槸璇垽涓洪敊鐨勶紝鎶婇敊娆℃暟杩樺洖鍘?*/
function rejudgeRec(k, letters) {
  const a = ANS[k];
  if (!a) return null;
  const wasOk = !!a.ok, ok = sameAns(a.sel || [], letters);
  a.ok = ok;
  if (ok && !wasOk) a.wrong = Math.max(0, (a.wrong || 0) - 1);
  if (!ok && wasOk) a.wrong = (a.wrong || 0) + 1;
  a.redo = false;
  srsUpdate(a, ok);
  return ok;
}
function rejudgeAll() {
  let n = 0;
  Object.keys(FIX).forEach(k => { if (ANS[k]) { rejudgeRec(k, FIX[k]); n++; } });
  if (n) saveAns();
  return n;
}
/* 绛旈椤?/ 閿欓鏈噷鍏辩敤鐨勩€屾敼绛旀銆嶅皬闈㈡澘 */
function openAnsEditor(host, k, q, done) {
  if (!host) return;
  const cur = ansOf(k, q), orig = (q && q.answer) || [];
  const n = Math.min(8, Math.max(2, (q && q.options && q.options.length) || 4));
  const letters = 'ABCDEFGH'.slice(0, n).split('');
  const fixed = hasFix(k);
  host.innerHTML =
    '<div class="fixbox">' +
    '<div class="small muted">鍕鹃€夎繖閬撻<b>姝ｇ‘</b>鐨勯€夐」锛涘彧鏀规湰鏈虹殑鍒ゅ垎渚濇嵁锛岄搴撴枃浠朵笉鍔ㄣ€?/div>' +
    '<div class="fixrow">' + letters.map(L => '<label class="fixopt' + (cur.includes(L) ? ' on' : '') + '"><input type="checkbox" data-f="' + L + '"' + (cur.includes(L) ? ' checked' : '') + '><span>' + L + '</span></label>').join('') + '</div>' +
    '<div class="small muted">棰樺簱鍘熺瓟妗?<b>' + (orig.join('') || '鈥?) + '</b>' + (fixed ? '銆€路銆€宸蹭慨姝ｄ负 <b>' + cur.join('') + '</b>' : '') + '</div>' +
    '<label class="chk small" style="margin-top:6px"><input type="checkbox" id="fxRe" checked> 淇濆瓨鍚庨『甯﹂噸鍒ゆ垜鍋氳繃鐨勮繖閬撻锛堥敊娆℃暟鍜屽涔犳帓鏈熶竴璧锋敼锛?/label>' +
    '<div class="actions"><button class="btn primary" id="fxOk">淇濆瓨</button>' +
    '<button class="btn" id="fxOrig"' + (fixed ? '' : ' disabled') + '>鎭㈠棰樺簱鍘熺瓟妗?/button>' +
    '<button class="btn" id="fxCancel">鍙栨秷</button></div></div>';
  host.querySelectorAll('.fixopt input').forEach(cb => cb.onchange = () => cb.parentNode.classList.toggle('on', cb.checked));
  const pick = () => Array.from(host.querySelectorAll('.fixopt input')).filter(cb => cb.checked).map(cb => cb.dataset.f);
  host.querySelector('#fxOk').onclick = () => {
    const L = pick();
    if (!L.length) { toast('鑷冲皯鍕句竴涓纭€夐」'); return; }
    setFix(k, L);
    let msg = '宸叉妸绛旀鏀规垚 ' + (fixOf(k) || []).join('');
    if (host.querySelector('#fxRe').checked && ANS[k]) {
      const okk = rejudgeRec(k, fixOf(k));
      saveAns();
      msg += okk ? '锛岃繖閬撻宸查噸鍒や负绛斿' : '锛屾寜鏂扮瓟妗堜粛绠楃瓟閿?;
    }
    host.innerHTML = '';
    toast(msg);
    if (done) done();
  };
  host.querySelector('#fxOrig').onclick = () => {
    delete FIX[k];
    saveFix();
    if (ANS[k]) { rejudgeRec(k, orig); saveAns(); }
    host.innerHTML = '';
    toast('宸叉仮澶嶉搴撳師绛旀');
    if (done) done();
  };
  host.querySelector('#fxCancel').onclick = () => { host.innerHTML = ''; };
}

/* ---------- 杩愯鏃剁姸鎬?---------- */
const QZ = { bankId: null, filter: 'all', subject: '', cur: null, pending: {}, excl: {}, order: null, streak: 0, focusCur: false };
const SS = {
  get: k => { try { return sessionStorage.getItem(k); } catch (e) { return null; } },
  set: (k, v) => { try { sessionStorage.setItem(k, v); } catch (e) {} },
  del: k => { try { sessionStorage.removeItem(k); } catch (e) {} }
};

/* ---------- 灏忓伐鍏?---------- */
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
/* 瀹夊叏缁戝畾锛歩d 涓嶅瓨鍦ㄤ篃涓嶄細涓柇鍚庨潰鐨勭粦瀹?*/
function on(id, fn, ev) { const el = $(id); if (el) el['on' + (ev || 'click')] = fn; return el; }
/* 閫夐」鏂囨湰锛氶搴撻噷甯稿啓鎴愩€孉. 鐢茶娉曘€嶏紝鐣岄潰涓婂凡缁忓彟鏈?A/B/C/D 寰界珷锛?   杩欓噷鎶婁笌寰界珷閲嶅鐨勯偅涓墠缂€鍘绘帀锛屽厤寰楀嚭鐜般€孉  A. 鐢茶娉曘€?*/
function optText(t, K) {
  const s = String(t == null ? '' : t);
  if (!K) return s;
  const m = s.match(/^\s*([A-Ha-h])\s*[.銆侊紟路:锛?锛塢\s*/);
  return (m && m[1].toUpperCase() === String(K).toUpperCase()) ? s.slice(m[0].length) : s;
}
/* 姘旀场鎻愮ず锛歬ind = ok / bad / 绌猴紙鏅€氾級銆傛斁搴曢儴锛屾墜鏈轰笂涓嶄細琚墜鎸囨尅浣忋€?   action = { label, fn }锛氱粰杩欎釜姘旀场鎸備竴涓寜閽紙銆屾挙閿€銆嶉偅绉嶏級锛岀偣瀹屽氨娑堝け */
function toast(msg, ms, kind, action) {
  const d = document.createElement('div');
  d.className = 'toast' + (kind === 'ok' ? ' ok' : kind === 'bad' ? ' bad' : '') + (action ? ' has-act' : '');
  const ic = document.createElement('span');
  ic.className = 'tic';
  ic.textContent = kind === 'ok' ? '鉁? : kind === 'bad' ? '!' : 'i';
  const tx = document.createElement('span');
  tx.textContent = msg;
  d.appendChild(ic); d.appendChild(tx);
  let timer = null, gone = false;
  const kill = () => { if (gone) return; gone = true; clearTimeout(timer); d.classList.remove('show'); setTimeout(() => d.remove(), 260); };
  if (action && action.label) {
    const b = document.createElement('button');
    b.className = 'btn tiny toast-act';
    b.textContent = action.label;
    b.onclick = () => { try { action.fn && action.fn(); } catch (e) {} kill(); };
    d.appendChild(b);
  }
  document.body.appendChild(d);
  requestAnimationFrame(() => d.classList.add('show'));
  timer = setTimeout(kill, ms || (action ? 5200 : 1700));
  return d;
}
/* 鍔ㄦ晥寮€鍏筹細绯荤粺寮€浜嗐€屽噺灏戝姩鎬佹晥鏋溿€嶅氨杩炶剦鍐?/ 闇囧姩涓€璧风渷鎺夛紙sticky 鍒版湰椤碉級 */
function uiMotionOK() {
  try { if (typeof SET !== 'undefined' && SET && SET.reduceMotion) return false; } catch (e) {}
  try { return !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches); } catch (e) { return true; }
}
/* 鍒ゅ垎鍚庣殑鍗虫椂鍙嶉锛堝€欒ˉ姹?B锛夛細瑙﹀睆杞昏交闇囦竴涓?+ 閫夐」鑴夊啿涓€娆?+ 绛旈敊缁欎竴鍙ュ皬鎻愮ず */
function uiFeedbackPulse(bank, q, st, picked) {
  if (!uiMotionOK()) return;
  try {
    if (navigator.vibrate && (window.matchMedia && window.matchMedia('(hover:none)').matches)) {
      navigator.vibrate(st.ok ? 18 : [22, 60, 22]);
    }
  } catch (e) {}
  try {
    const keys = st.ok ? ansOf(favKey(bank, q), q) : (picked || []);
    document.querySelectorAll('#view .opts .opt').forEach(el => {
      if (keys.indexOf(el.dataset.k) < 0) return;
      el.classList.remove(st.ok ? 'pulse-ok' : 'pulse-bad');
      void el.offsetWidth;                       /* 閲嶆柊瑙﹀彂鍔ㄧ敾 */
      el.classList.add(st.ok ? 'pulse-ok' : 'pulse-bad');
      setTimeout(() => el.classList.remove('pulse-ok', 'pulse-bad'), 700);
    });
  } catch (e) {}
  if (!st.ok) toast('宸茶鍏ラ敊棰樻湰', 1500, 'bad');
}
/* 鍒ゅ垎鎻ず锛氶€夐」鎸?~55ms 娣″叆 + 寰缉锛岀粨鏋滄璺熺潃杞昏交浜竴涓嬨€?   涓嶅仛 3D 缈荤墝 / 娉㈡氮 / 澶栨墿鍏夊湀锛涚郴缁熷紑浜嗐€屽噺灏戝姩鎬佹晥鏋溿€嶅氨鏁存璺宠繃銆?*/
function uiReveal(bank, q, st) {
  if (!uiMotionOK()) return;
  const opts = [...document.querySelectorAll('#view .opts .opt')];
  const marks = opts.filter(el => el.classList.contains('right') || el.classList.contains('wrong'));
  if (!marks.length) return;
  const plan = marks.map(el => ({ el: el, cls: el.classList.contains('right') ? 'right' : 'wrong' }));
  plan.forEach(m => m.el.classList.remove('right', 'wrong'));   /* 鍏堥€€鍥炲幓锛屽啀杞昏交鎻ず */
  const fb = $('fb');
  if (fb) fb.classList.add('fb-hold');
  plan.forEach((m, i) => {
    setTimeout(() => {
      m.el.classList.add(m.cls, 'flip-in');
      setTimeout(() => m.el.classList.remove('flip-in'), 320);
      if (i === plan.length - 1 && fb) {
        setTimeout(() => { fb.classList.remove('fb-hold'); fb.classList.add('fb-pop'); setTimeout(() => fb.classList.remove('fb-pop'), 420); }, 160);
      }
    }, 55 + i * 55);
  });
}
/* 搂3.6-P0鈶?杩炲 streak锛氱瓟瀵圭疮鍔犮€佺瓟閿欐竻闆讹紝鍙湪 3 杩炲璧枫€佷箣鍚庢瘡 5 杩炲杞绘彁绀轰竴娆★紙涓嶅姩 fx.js 閭ｅ褰╁甫锛?*/
function uiStreakBump(ok) {
  if (!ok) { QZ.streak = 0; return; }
  QZ.streak = (QZ.streak || 0) + 1;
  const n = QZ.streak;
  if (n >= 3 && (n === 3 || n % 5 === 0)) toast('杩炲 ' + n + ' 棰?馃敟', 1600, 'ok');
}
/* 澶嶅埗涓€娈垫枃鏈細绔欓噷涓€鐩寸敤 execCommand 杩欎竴濂楋紙file:// 涓?navigator.clipboard 甯歌鎷︼級 */
function uiCopyText(txt, okMsg) {
  try {
    const t = document.createElement('textarea');
    t.value = String(txt);
    t.style.position = 'fixed'; t.style.opacity = '0';
    document.body.appendChild(t); t.select();
    const ok = document.execCommand('copy');
    t.remove();
    toast(ok ? (okMsg || '宸插鍒?) : '澶嶅埗澶辫触锛岃鎵嬪姩閫変腑', 1400, ok ? 'ok' : 'bad');
  } catch (e) { toast('澶嶅埗澶辫触锛岃鎵嬪姩閫変腑', 1600, 'bad'); }
}
/* 鍊欒ˉ姹?A锛氳Е灞忓乏鍙虫粦鍔ㄧ炕棰橈紙宸︽粦锛濅笅涓€棰橈紝鍙虫粦锛濅笂涓€棰橈級
   鍙湪瑙﹀睆涓婂惎鐢紱妯悜浣嶇Щ > 30px 涓旀í鍚戞槑鏄惧ぇ浜庣旱鍚戞墠绠楋紱
   浠庨€夐」 / 杈撳叆妗?/ 鎸夐挳涓婅捣鎵嬬殑涓嶇畻锛堜笉鐒躲€岀偣閫夐」銆嶄細琚綋鎴愮炕椤碉級 */
function uiBindSwipe(bank) {
  const host = $('view');
  if (!host) return;
  if (!(('ontouchstart' in window) || (window.matchMedia && window.matchMedia('(hover:none)').matches))) return;
  const card = host.querySelector('.card');
  if (!card) return;
  let x0 = null, y0 = 0, t0 = 0, moved = false;
  card.addEventListener('touchstart', e => {
    x0 = null;
    if (e.touches.length !== 1) return;
    const el = e.target;
    /* 绗?3 鏉★細鍦ㄨВ鏋愰噷妯悜鍒掞紙鐪嬪琛ㄦ牸 / 鍏紡 / 闀夸唬鐮侊級浠ュ墠琚綋鎴愮炕椤点€?       瑙ｆ瀽鍖恒€佸彲妯悜婊氬姩鐨勫潡銆佹粦鏉′竴寰嬩笉璧锋墜缈婚〉銆?*/
    if (el && el.closest && el.closest('input,select,textarea,button,.opts,.kbrow,.exp,.exp-wrap,.rich-edit,.rich-imgs,pre,.md-code,table,[data-noswipe]')) return;
    if (el && el.closest && el.closest('.card') && el.closest('.card').scrollWidth > el.closest('.card').clientWidth + 4) return;   /* 鍗＄墖鏈韩鑳芥í鍚戞粴灏卞埆鎶㈡墜鍔?*/
    x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; t0 = Date.now(); moved = false;
  }, { passive: true });
  card.addEventListener('touchmove', e => {
    if (x0 == null || e.touches.length !== 1) return;
    const dx = e.touches[0].clientX - x0, dy = e.touches[0].clientY - y0;
    if (Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy)) moved = true;
  }, { passive: true });
  card.addEventListener('touchend', e => {
    if (x0 == null) return;
    const t = e.changedTouches && e.changedTouches[0];
    const x1 = x0; x0 = null;
    if (!t) return;
    const dx = t.clientX - x1, dy = t.clientY - y0, dt = Date.now() - t0;
    if (!moved || dt > 900) return;
    if (Math.abs(dx) < 30 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
    if (Math.abs(dy) > 40) return;   /* 鎵嬪線涓?涓嬪甫浜嗗緢澶氾細閭ｆ槸婊氬姩锛堢 3 鏉★級锛屼笉缈婚〉 */
    if (typeof aiBusy === 'function' && aiBusy()) return;    /* 姝ｅ湪鐢熸垚瑙ｆ瀽灏卞埆缈婚〉 */
    try { e.preventDefault(); } catch (err) {}               /* 鍘嬫帀绱ч殢鍏跺悗鐨?click */
    step(dx < 0 ? 1 : -1);
  }, { passive: false });
}
/* 鍊欒ˉ姹?H锛氶暱鎸夐骞?600ms 寮逛竴涓皬鑿滃崟锛堝鍒堕骞?/ AI 瑙ｆ瀽 / 鏀惰棌锛?*/
function uiBindStemLongPress(bank, q, fk) {
  const stem = document.querySelector('#view .stem');
  if (!stem) return;
  let timer = null;
  const clear = () => { if (timer) { clearTimeout(timer); timer = null; } };
  const openMenu = () => {
    clear();
    if ($('stemMenu')) return;
    const m = document.createElement('div');
    m.className = 'stemmenu';
    m.id = 'stemMenu';
    m.innerHTML = '<button class="btn tiny" data-a="copy">澶嶅埗棰樺共</button>'
      + '<button class="btn tiny" data-a="ai">AI 瑙ｆ瀽</button>'
      + '<button class="btn tiny" data-a="fav">' + (FAV[fk] ? '鍙栨秷鏀惰棌' : '鏀惰棌') + '</button>'
      + '<button class="btn tiny" data-a="x">鍏抽棴</button>';
    stem.appendChild(m);
    m.onclick = ev => {
      const b = ev.target && ev.target.closest ? ev.target.closest('[data-a]') : null;
      if (!b) return;
      const a = b.dataset.a;
      const el = $('stemMenu'); if (el) el.remove();
      if (a === 'copy') uiCopyText(q.stem || '', '棰樺共宸插鍒?);
      else if (a === 'ai') { if (typeof aiOpenPanel === 'function') aiOpenPanel($('aiHost'), fk, q); else toast('AI 妯″潡娌″姞杞斤紙ai.js锛?, 1600, 'bad'); }
      else if (a === 'fav') toggleFav(fk, $('btnFav'));
    };
    setTimeout(() => document.addEventListener('click', () => { const el = $('stemMenu'); if (el) el.remove(); }, { once: true }), 30);
  };
  stem.addEventListener('pointerdown', e => {
    if (e.pointerType && e.pointerType !== 'touch') return;   /* 榧犳爣闀挎寜涓嶅脊 */
    clear();
    timer = setTimeout(openMenu, 600);
  });
  ['pointerup', 'pointermove', 'pointercancel', 'pointerleave'].forEach(ev => stem.addEventListener(ev, clear));
}
/* 搴曟爮婊戝姩鎸囩ず鍣細涓€涓寔缁瓨鍦ㄧ殑鑳跺泭锛屽湪 active 鎸夐挳涓嬮潰婊戣繃鍘汇€?   nav 鏈韩涓嶉噸鐢伙紝鎵€浠ユ崲椤垫椂鏄繛缁姩鐢伙紱鎸夐挳鍥炬爣鍐嶅仛杞诲井鍥炲脊銆?*/
function uiBottomNavInit() {
  const nav = document.querySelector('.bnav');
  if (!nav || nav.querySelector('.bnav-ind')) return;
  const ind = document.createElement('span');
  ind.className = 'bnav-ind';
  ind.setAttribute('aria-hidden', 'true');
  nav.insertBefore(ind, nav.firstChild);
  const paint = () => {
    const on = nav.querySelector('.btn.on');
    if (!on || !on.offsetWidth) { ind.style.opacity = '0'; return; }
    const nr = nav.getBoundingClientRect();
    const br = on.getBoundingClientRect();
    const bl = parseFloat(getComputedStyle(nav).borderLeftWidth) || 0;
    ind.style.opacity = '1';
    ind.style.width = br.width + 'px';
    ind.style.transform = 'translateX(' + (br.left - nr.left - bl) + 'px)';
  };
  nav.__bnavPaint = paint;
  paint();
  window.addEventListener('resize', paint);
  if ('MutationObserver' in window) {
    new MutationObserver(paint).observe(nav, { attributes: true, attributeFilter: ['class'], subtree: true, childList: true });
  }
}

/* 搴曟爮楂樹寒褰撳墠鎵€鍦ㄩ〉锛堢浜屾壒涔嬪悗锛屽叆鍙ｉ兘鍦ㄥ簳閮ㄥ鑸笂锛?*/
function markTop(name) {
  const map = { home: 'bnHome', wrong: 'btnGoWrong', fav: 'btnGoFav', search: 'btnGoSearch', kb: 'btnGoKb', sync: 'btnGoSync' };
  Object.keys(map).forEach(n => {
    const el = $(map[n]);
    if (!el) return;
    const on_ = n === name;
    el.classList.toggle('on', on_);
    if (on_) el.setAttribute('aria-current', 'page'); else el.removeAttribute('aria-current');
  });
  const nav = document.querySelector('.bnav');
  if (nav && nav.__bnavPaint) nav.__bnavPaint();
}
/* 搂3.6-P0鈶?寰呭涔犺鏍囷細鏁颁竴閬嶃€屽仛閿欒繃涓斾粖澶╁埌鏈熴€嶇殑棰橈紝鎶婃暟瀛楁寕鍒板簳閮ㄥ鑸殑銆岄敊棰樸€嶄笂銆?   绾 ANS锛坄wrong > 0` + `due <= now`锛屽拰 isDue 鍚屼竴濂楀垽鎹級锛屼笉鏂板浠讳綍璁板綍銆佷笉鏀规暟鎹眰銆?*/
function uiDueCount() {
  const now = Date.now();
  let n = 0;
  for (const k in ANS) {
    const a = ANS[k];
    if (!a || !(a.wrong > 0)) continue;
    const d = (a.due == null ? (a.ts || 0) : a.due);
    if (d <= now) n++;
  }
  return n;
}
function uiPaintBadge() {
  const n = uiDueCount();
  const els = [];
  const byId = $('btnGoWrong');
  if (byId) els.push(byId);
  const bn = document.querySelector('.bnav');
  if (bn) bn.querySelectorAll('button').forEach(b => {
    if (/閿欓/.test(b.textContent || '') && els.indexOf(b) < 0) els.push(b);
  });
  els.forEach(b => {
    let s = b.querySelector('.nb-badge');
    if (!n) { if (s) s.remove(); if (!b.hasAttribute('data-due')) b.removeAttribute('title'); return; }
    if (!s) { s = document.createElement('span'); s.className = 'nb-badge'; b.appendChild(s); }
    s.textContent = n > 99 ? '99+' : String(n);
    s.title = '浠婂ぉ鏈?' + n + ' 閬撻敊棰樺埌鏈熻澶嶄範';
    b.setAttribute('data-due', String(n));
  });
}
/* 璺ㄩ浂鐐?/ 鍒囧洖鍓嶅彴 / 绯荤粺鏃堕棿琚敼锛氳鏍囧拰棣栭〉銆屽緟澶嶄範銆嶆暟瀛楄窡鐫€鍒锋柊銆?   鍙敼杩欎袱涓湴鏂癸紝涓嶉噸鐢绘暣椤?鈥斺€?鍏嶅緱鎶婃鍦ㄨ緭鍏ョ殑瀵硅瘽/鎼滅储妗嗗啿鎺夈€?*/
function uiDayKey() {
  const d = new Date();
  return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
}
let _uiDueDay = uiDayKey();
function uiRefreshDueNow() {
  try { uiPaintBadge(); } catch (e) {}
  const btn = document.querySelector('.hstat [data-act="review"]');
  if (!btn) return;
  const n = uiDueCount();
  const b = btn.querySelector('b');
  if (b) b.textContent = String(n);
  btn.classList.toggle('off', !n);
  btn.title = n ? '寮€濮嬩粖鏃ュ涔? : '浠婂ぉ娌℃湁璇ュ涔犵殑棰?;
  /* 棣栭〉閭ｉ銆屼粖鏃ュ涔?N 棰樸€嶈窡鐫€鏀癸紱鍙樻垚 0 灏辨敹璧锋潵 */
  const rv = document.getElementById('toReview');
  if (rv) {
    if (!n) rv.remove();
    else {
      const cap = +srsCfg().daily || 0;
      rv.textContent = '浠婃棩澶嶄範 ' + (cap && n > cap ? cap + ' / ' + n : n) + ' 棰?;
    }
  }
}
function uiDueDayTick() {
  const k = uiDayKey();
  if (k === _uiDueDay) return;
  _uiDueDay = k;
  uiRefreshDueNow();
}
setInterval(uiDueDayTick, 30000);
document.addEventListener('visibilitychange', function () { if (!document.hidden) uiRefreshDueNow(); });
window.addEventListener('focus', uiRefreshDueNow);

/* 涓€閿埌搴?/ 涓€閿埌椤讹細鍙充笅瑙掍竴涓诞鍔ㄦ寜閽紝鎸夊綋鍓嶆粴鍔ㄤ綅缃垏鏂瑰悜銆?   闀块〉闈紙棰樺簱銆佺粺璁°€佽В鏋愶級鎵嶆湁锛涘唴瀹逛笉澶熶竴灞忓氨鑷姩闅愯棌銆?*/
function uiScrollJumpInit() {
  if (document.getElementById('scrollJump')) return;
  const wrap = document.createElement('div');
  wrap.id = 'scrollJump';
  wrap.className = 'scroll-jump';
  wrap.innerHTML = '<button type="button" class="sj-top" aria-label="鍥炲埌椤堕儴" title="鍥炲埌椤堕儴">鈫?/button>'
    + '<button type="button" class="sj-bottom" aria-label="璺冲埌椤甸潰搴曢儴" title="璺冲埌椤甸潰搴曢儴">鈫?/button>';
  document.body.appendChild(wrap);
  const upBtn = wrap.querySelector('.sj-top');
  const downBtn = wrap.querySelector('.sj-bottom');
  const doc = document.documentElement;
  const maxY = () => Math.max(0, ((doc && doc.scrollHeight) || document.body.scrollHeight || 0) - window.innerHeight);
  /* 鑱婂ぉ椤垫暣椤甸珮搴﹀浐瀹氾紝鐪熸婊氱殑鏄?#chatLog锛涘叾瀹冮〉闈㈡粴 window銆?*/
  function target() {
    const page = document.querySelector('.chat-page');
    const log = page && document.getElementById('chatLog');
    if (log) {
      const max = (log.scrollHeight || 0) - (log.clientHeight || 0);
      if (max > 80) return { y: log.scrollTop || 0, max: max, el: log, win: false };
    }
    return { y: window.scrollY || doc.scrollTop || 0, max: maxY(), el: null, win: true };
  }
  function goTo(t, top, smooth) {
    const behavior = smooth ? 'smooth' : 'auto';
    if (!t.win && t.el) {
      try { t.el.scrollTo({ top: top, behavior: behavior }); }
      catch (e) { t.el.scrollTop = top; }
    } else {
      try { window.scrollTo({ top: top, behavior: behavior }); }
      catch (e) { window.scrollTo(0, top); }
    }
  }
  let raf = 0;
  function paint() {
    raf = 0;
    const t = target();
    const show = t.max > 120;
    wrap.classList.toggle('show', show);
    if (!show) return;
    wrap.classList.toggle('at-top', t.y <= 2);
    wrap.classList.toggle('at-bottom', t.y >= t.max - 4);
  }
  const kick = () => { if (!raf) raf = requestAnimationFrame(paint); };
  const jump = (toTop) => {
    const t = target();
    const smooth = !(typeof uiMotionOK === 'function' && !uiMotionOK());
    goTo(t, toTop ? 0 : t.max, smooth);
    paint();                         /* 鍗虫椂婊氬姩鏃剁珛鍒诲垏鎹㈢澶达紱骞虫粦婊氬姩鐢?scroll 浜嬩欢鎺ョ潃鍒?*/
    setTimeout(kick, 120);
  };
  upBtn.onclick = () => jump(true);
  downBtn.onclick = () => jump(false);
  window.addEventListener('hashchange', function () { setTimeout(paint, 0); });
  /* 閿洏鑱氱劍鍒版诞閽椂锛孍nter / 绌烘牸鍙Е鍙戞寜閽紝鍒绛旈椤电殑鍏ㄥ眬 Enter 蹇嵎閿啀璧颁竴棰?*/
  wrap.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') e.stopPropagation();
  });
  window.addEventListener('scroll', kick, { passive: true });
  document.addEventListener('scroll', kick, { capture: true, passive: true });  /* 鎺ヤ綇 #chatLog 鍐呴儴婊氬姩 */
  window.addEventListener('resize', kick);
  const view = document.getElementById('view');
  if (view && 'MutationObserver' in window) {
    new MutationObserver(kick).observe(view, { childList: true, subtree: true, characterData: true });
  }
  paint();
  setTimeout(paint, 60);     /* 棣栭〉鍐呭鐢?cat.js 绋嶅悗鎸傝繘鏉ワ細鍐嶅埛涓€娆★紝纭瀵艰埅/娴挳鐘舵€?*/
  setInterval(paint, 600);   /* 鑱婂ぉ璁板綍鏄唴閮ㄦ粴鍔ㄣ€侀珮搴︿細鑷繁闀匡紱瀹氭椂鍏滃簳锛屽埆绛夌敤鎴锋粴涓€涓嬫墠鍑虹幇 */
}

uiScrollJumpInit();

/* ============================================================
   涓荤晫闈㈡€诲鑸細鐙珛鎮诞鑳跺泭锛屽彲鎷栧姩锛屾澗鎵嬪惛闄勫乏鍙宠竟锛屼綅缃浣忋€?   鍙湪棣栭〉鏄剧ず锛涚偣寮€鏄€岄《閮?/ 瀛︿範姒傝 / 鍏ㄩ儴棰樺簱 / 涓存椂濂楀嵎 / 鏁版嵁澶囦唤 / 搴曢儴銆嶃€?   ============================================================ */
function uiHomeNavInit() {
  if (document.getElementById('homeNavFab')) return;
  const fab = document.createElement('div');
  fab.id = 'homeNavFab';
  fab.className = 'home-nav-fab';
  fab.setAttribute('role', 'button');
  fab.setAttribute('tabindex', '0');
  fab.setAttribute('aria-label', '涓荤晫闈㈠鑸?);
  fab.setAttribute('aria-expanded', 'false');
  fab.innerHTML = '<span class="hnf-ic">鈽?/span><span class="hnf-tx">瀵艰埅</span>';
  const menu = document.createElement('div');
  menu.id = 'homeNavMenu';
  menu.className = 'home-nav-menu';
  menu.setAttribute('role', 'menu');
  menu.hidden = true;
  menu.innerHTML = '<div class="hn-head"><span class="hn-cap">涓荤晫闈㈠鑸?/span>'
    + '<button class="hn-x" type="button" aria-label="鍏抽棴">脳</button></div>'
    + '<button type="button" class="hn-item" data-hn="top" role="menuitem"><span class="hn-i">鈬?/span><span>椤堕儴</span></button>'
    + '<button type="button" class="hn-item" data-hn="secBento" role="menuitem"><span class="hn-i">鈼?/span><span>瀛︿範姒傝</span></button>'
    + '<button type="button" class="hn-item" data-hn="nbHome" role="menuitem"><span class="hn-i">鈻?/span><span>鍏ㄩ儴棰樺簱</span></button>'
    + '<button type="button" class="hn-item" data-hn="secPapers" role="menuitem"><span class="hn-i">鈻?/span><span>涓存椂濂楀嵎</span></button>'
    + '<button type="button" class="hn-item" data-hn="secBackup" role="menuitem"><span class="hn-i">猡?/span><span>鏁版嵁澶囦唤</span></button>'
    + '<button type="button" class="hn-item" data-hn="bottom" role="menuitem"><span class="hn-i">鈬?/span><span>搴曢儴</span></button>';
  document.body.appendChild(fab);
  document.body.appendChild(menu);

  const POS_KEY = 'qbank.homenav.pos.v1';
  const M = 12;
  let side = 'right', top = 0, dragging = false, moved = false, start = null, startRect = null, skipClick = false;
  const vw = () => window.innerWidth || document.documentElement.clientWidth;
  const vh = () => window.innerHeight || document.documentElement.clientHeight;
  const fabW = () => fab.offsetWidth || 76;
  const fabH = () => fab.offsetHeight || 44;
  const clampTop = y => Math.max(72, Math.min(y, vh() - fabH() - 96));
  const isHome = () => { try { return typeof route === 'function' && route().name === 'home'; } catch (e) { return false; } };

  try {
    const p = JSON.parse(localStorage.getItem(POS_KEY) || 'null');
    if (p && (p.side === 'left' || p.side === 'right') && isFinite(p.top)) { side = p.side; top = +p.top; }
  } catch (e) {}
  if (!top) top = Math.round(vh() * 0.42);

  function place() {
    fab.style.left = ''; fab.style.right = '';
    if (side === 'left') fab.style.left = M + 'px'; else fab.style.right = M + 'px';
    top = clampTop(top);
    fab.style.top = top + 'px';
  }
  function savePos() {
    try { localStorage.setItem(POS_KEY, JSON.stringify({ side: side, top: clampTop(top) })); } catch (e) {}
  }
  function closeMenu() {
    menu.hidden = true;
    fab.classList.remove('open');
    fab.setAttribute('aria-expanded', 'false');
  }
  function openMenu() {
    menu.querySelectorAll('[data-hn]').forEach(function (b) {
      const id = b.dataset.hn;
      b.style.display = (id === 'top' || id === 'bottom' || document.getElementById(id)) ? '' : 'none';
    });
    menu.style.left = ''; menu.style.right = ''; menu.style.top = '';
    const r = fab.getBoundingClientRect();
    if (side === 'right') menu.style.right = Math.max(M, vw() - r.left + 10) + 'px';
    else menu.style.left = Math.max(M, r.right + 10) + 'px';
    menu.hidden = false;
    fab.classList.add('open');
    fab.setAttribute('aria-expanded', 'true');
    requestAnimationFrame(function () {
      const mh = menu.offsetHeight || 300;
      const y = Math.max(72, Math.min(r.top + r.height / 2 - mh / 2, vh() - mh - 88));
      menu.style.top = y + 'px';
    });
  }
  function toggleMenu() { if (menu.hidden) openMenu(); else closeMenu(); }
  function sync() {
    const home = isHome();
    fab.classList.toggle('show', home);
    if (!home) closeMenu();
  }

  place();
  sync();

  /* 鎷栧姩锛氭寜涓嬭璧风偣锛岀Щ鍔ㄨ秴杩?6px 鎵嶇畻鎷栵紱鏉炬墜鍚搁檮鍒版渶杩戠殑宸﹀彸杈?*/
  fab.addEventListener('pointerdown', function (e) {
    if (e.button != null && e.button !== 0) return;
    dragging = true; moved = false;
    start = { x: e.clientX, y: e.clientY };
    startRect = fab.getBoundingClientRect();
    try { fab.setPointerCapture(e.pointerId); } catch (err) {}
    fab.classList.add('dragging');
    document.body.classList.add('hn-dragging');
  });
  fab.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    const dx = e.clientX - start.x, dy = e.clientY - start.y;
    if (!moved && Math.abs(dx) + Math.abs(dy) > 6) {
      moved = true;
      closeMenu();
    }
    if (!moved) return;
    try { e.preventDefault(); } catch (err) {}
    const nx = Math.max(M, Math.min(startRect.left + dx, vw() - M - fabW()));
    const ny = Math.max(72, Math.min(startRect.top + dy, vh() - 96 - fabH()));
    fab.style.left = nx + 'px'; fab.style.right = '';
    fab.style.top = ny + 'px';
  });
  function endDrag(e) {
    if (!dragging) return;
    /* 鍏堣浣嶇疆鍐嶆挙 dragging锛氭挙浜嗕互鍚?left/top 鐨勮繃娓′細閲嶆柊鎵撳紑锛?       getBoundingClientRect 鍙兘杩樺仠鍦ㄦ棫浣嶇疆锛屽惛闄勬柟鍚戝氨浼氬垽閿欍€?*/
    const r = fab.getBoundingClientRect();
    const wasMoved = moved;
    dragging = false;
    fab.classList.remove('dragging');
    document.body.classList.remove('hn-dragging');
    try { if (e && e.pointerId != null) fab.releasePointerCapture(e.pointerId); } catch (err) {}
    if (!wasMoved) return;                   /* 娌℃嫋鍔細浜ょ粰 click 寮€鑿滃崟 */
    side = (r.left + r.width / 2 < vw() / 2) ? 'left' : 'right';
    top = clampTop(r.top);
    fab.classList.add('snapping');
    place(); savePos();
    setTimeout(function () { fab.classList.remove('snapping'); }, 240);
    skipClick = true;
    setTimeout(function () { skipClick = false; }, 400);
  }
  fab.addEventListener('pointerup', endDrag);
  fab.addEventListener('pointercancel', endDrag);
  fab.addEventListener('click', function (e) {
    e.stopPropagation();
    if (skipClick) { skipClick = false; return; }
    toggleMenu();
  });
  fab.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
      e.preventDefault(); e.stopPropagation(); toggleMenu();
    } else if (e.key === 'Escape') { closeMenu(); }
  });
  menu.querySelector('.hn-x').onclick = function () { closeMenu(); };
  menu.addEventListener('click', function (e) {
    const b = e.target.closest('[data-hn]');
    if (!b) return;
    const id = b.dataset.hn;
    const smooth = !(typeof uiMotionOK === 'function' && !uiMotionOK());
    if (id === 'top') {
      try { window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' }); } catch (err) { window.scrollTo(0, 0); }
    } else if (id === 'bottom') {
      const y = Math.max(0, (document.documentElement.scrollHeight || document.body.scrollHeight || 0) - window.innerHeight);
      try { window.scrollTo({ top: y, behavior: smooth ? 'smooth' : 'auto' }); } catch (err) { window.scrollTo(0, y); }
    } else {
      const el = document.getElementById(id);
      if (el) {
        const y2 = Math.max(0, el.getBoundingClientRect().top + (window.scrollY || 0) - 64);
        try { window.scrollTo({ top: y2, behavior: smooth ? 'smooth' : 'auto' }); } catch (err) { window.scrollTo(0, y2); }
      }
    }
    closeMenu();
  });
  document.addEventListener('click', function (e) {
    if (menu.hidden) return;
    if (menu.contains(e.target) || fab.contains(e.target)) return;
    closeMenu();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !menu.hidden) closeMenu();
  });
  window.addEventListener('scroll', closeMenu, { passive: true });
  window.addEventListener('resize', function () { top = clampTop(top); place(); closeMenu(); });
  window.addEventListener('hashchange', function () { setTimeout(sync, 0); });
  setTimeout(sync, 60);
}

/* ============================================================
   鈶?搴曟爮鍙嫋鍔?/ 鎷夊ぇ灏忥紙鐢ㄦ埛瑕佹眰锛氥€岀瓟棰樼晫闈㈠簳涓嬬殑瀵艰埅鏍忎篃鑳介殢鎰忔嫿鍔ㄥ彉褰€嶏級
   - 宸︿晶 鉅?鎶婃墜鎷栧姩鏁存潯搴曟爮锛涘彸涓嬭灏忔妸鎵嬫媺瀹?/ 鎷夐珮锛堟寜閽嚜鍔ㄦ崲琛屻€佸彉澶у皬锛?   - 鍙屽嚮鎶婃墜鍥炲埌搴曢儴鍘熸潵鐨勬牱瀛愶紱鍑犱綍瀛?qbank.bnavdock.v1锛屽埛鏂板悗杩樿寰?   - 涓嶆尅鐐瑰嚮锛氭妸鎵嬪彧鏈?16px 瀹斤紝鎸夐挳鐓у父鐐?   ============================================================ */
const BNV_KEY = 'qbank.bnavdock.v1';
function bnvState() { try { return JSON.parse(localStorage.getItem(BNV_KEY) || '{}') || {}; } catch (e) { return {}; } }
function bnvSave(st) { try { localStorage.setItem(BNV_KEY, JSON.stringify(st)); } catch (e) {} }
function uiBottomNavDock() {
  /* 搴曟爮鎭㈠鍘熸牱锛堢敤鎴?2026-10-24 鍙嶉锛氭嫋鍔?鎷夊ぇ灏忎笉瑕佷簡锛夈€?     浠ュ墠鎷栬繃銆佸瓨杩囨诞鍔ㄧ姸鎬佺殑璁惧锛岃繖閲屼竴娆℃€ф竻骞插噣锛岄伩鍏嶆畫鐣?inline 鏍峰紡鎶婂簳鏍忛《姝€?*/
  const nav = document.querySelector('.bnav');
  if (!nav) return;
  nav.classList.remove('bnv-float');
  nav.style.left = nav.style.top = nav.style.width = nav.style.height = '';
  nav.style.right = nav.style.bottom = '';
  const g = nav.querySelector('.bnv-grip'); if (g) g.remove();
  const r = nav.querySelector('.bnv-rz'); if (r) r.remove();
  try { localStorage.removeItem('qbank.bnavdock.v1'); } catch (e) {}
}
uiHomeNavInit();
uiBottomNavInit();
uiBottomNavDock();
/* 搂3.6-P0鈶?涓撴敞妯″紡锛歚body.focus` 鐢?applyLook() 缁熶竴鍔狅紙璁剧疆閲屼篃鑳藉紑鍏筹級锛岃繖閲屽彧绠″垏鐘舵€?+ 鎻愮ず銆?   绛旈椤电殑銆屸浂 涓撴敞銆嶆寜閽€佸彸涓嬭娴嚭鐨勩€岄€€鍑轰笓娉ㄣ€嶃€丒sc 閮借蛋杩欓噷銆?*/
function uiSetFocus(on, quiet) {
  const v = !!on;
  if (!!SET.focus === v) { if (!v && !quiet) applyLook(); return; }
  setLook('focus', v);                       /* 鍐?LS + applyLook锛坆ody.focus 涓€璧峰垏锛?*/
  if (!quiet) toast(v ? '涓撴敞妯″紡锛氶《鏍忓拰搴曟爮鏀惰捣鏉ヤ簡锛圗sc 閫€鍑猴級' : '宸查€€鍑轰笓娉ㄦā寮?, 1800, v ? '' : 'ok');
}
/* 搂8 瑙嗚 v2锛氱瓟棰橀〉鐨勩€屸嫰 鏇村銆嶆娊灞夛紙鏀硅В鏋?/ 鏀圭瓟妗?/ AI 瑙ｆ瀽 / AI 鍙樺紡棰?鏀惰繘鏉ワ級銆?   on 涓嶇粰灏辨寜褰撳墠鐘舵€佸弽鍒囷紱闈㈡澘鏈韩鐣欏湪 DOM 閲岋紝鎵€浠ユ帰閽堢敤 getElementById('doNote').click()
   鐓ф牱鐐瑰緱鍒帮紙display:none 涓嶅Θ纰嶇▼搴忓寲 click锛夈€?*/
function qSheetToggle(on) {
  const s = document.getElementById('qSheet');
  if (!s) return;
  const want = (on === undefined || on === null) ? s.hasAttribute('hidden') : !!on;
  if (want) s.removeAttribute('hidden'); else s.setAttribute('hidden', '');
  if (document.body) document.body.classList.toggle('sheet-open', want);
}
/* 鍒楄〃鍏ュ満锛氱粰銆岄敊棰樻湰 / 鏀惰棌 / 鎼滅储銆嶇殑鍗＄墖鎺掍笂鍏ュ満寤惰繜銆?  鍙畻鍓?12 涓紙闀垮垪琛ㄤ竴娆℃€у姩浼氭帀甯э級锛?-i 浜ょ粰 style.css 鐨?.stagger > * 鐢ㄣ€?*/
function staggerList(host) {
  const box = host || $('view');
  if (!box) return;
  const kids = [...box.querySelectorAll(':scope > .wi, :scope > .card.wi')];
  kids.forEach((el, i) => {
    if (i >= 12) { el.style.removeProperty('--i'); el.classList.remove('stagger-i'); return; }
    el.style.setProperty('--i', String(i));
    el.classList.add('stagger-i');
  });
}
window.addEventListener('animationend', e => {
  if (e.target && e.target.classList && e.target.classList.contains('stagger-i')) e.target.classList.remove('stagger-i');
});
function download(name, text, mime) {
  const blob = new Blob([text], { type: (mime || 'text/plain') + ';charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 4000);
}
function fmtTime(ts) {
  if (!ts) return '鈥?;
  const d = new Date(ts), p = n => String(n).padStart(2, '0');
  return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
}
function stamp() {
  const d = new Date(), p = n => String(n).padStart(2, '0');
  return '' + d.getFullYear() + p(d.getMonth() + 1) + p(d.getDate()) + '-' + p(d.getHours()) + p(d.getMinutes());
}
const safeName = s => String(s).replace(/[\\/:*?"<>|\s]+/g, '_').slice(0, 40);

/* ---------- 璺敱 ---------- */
function route() {
  const h = location.hash.replace(/^#\/?/, '');
  /* 鍦板潃鏍忕殑 hash 浼氳娴忚鍣ㄥ仛鐧惧垎鍙风紪鐮侊細棰樺簱 id 閲岃嫢甯︿腑鏂囷紙渚嬪鑷甫鐨?ttsx-鍐呯瀛?1
     浼氬彉鎴?ttsx-%E5%86%85%E7%A7%91%E5%AD%A6-1锛夛紝涓嶈В鐮佸氨鏌ヤ笉鍒伴搴擄紝
     鐐广€屽紑濮嬨€嶄細琚?renderQuiz 褰撴垚鏃犳晥棰樺簱寮瑰洖棣栭〉銆?*/
  const parts = h.split('/').map(p => { try { return decodeURIComponent(p); } catch (e) { return p; } });
  if (parts[0] === 'bank' && parts[1]) return { name: 'quiz', bankId: parts[1] };
  if (parts[0] === 'import') return { name: 'import' };
  if (parts[0] === 'wrong') return { name: 'wrong' };
  if (parts[0] === 'fav') return { name: 'fav' };
  if (parts[0] === 'exam' && parts[1]) return { name: 'exam', bankId: parts[1] };
  if (parts[0] === 'review') return { name: 'wrong' };   // 澶嶄範鍏ュ彛宸插苟鍏ラ敊棰樻湰
  if (parts[0] === 'search') return { name: 'search' };
  if (parts[0] === 'kb') return { name: 'kb' };
  if (parts[0] === 'sync') return { name: 'sync' };   /* 浜戝悓姝ワ紙sync.js锛夛細鐢佃剳 鈫?鎵嬫満鍏辩敤涓€浠借褰?*/
  if (parts[0] === 'stats') return { name: 'stats' };
  if (parts[0] === 'report') return { name: 'report' };       /* AI 瀛︽儏璇婃柇锛坮eport.js锛?*/
  if (parts[0] === 'qlist' && parts[1]) return { name: 'qlist', bankId: parts[1] };   /* 棰樼洰绠＄悊锛坈at.js锛夛細涓€寮犲紶璇婚 / 鎵归噺鍒犻 */
  if (parts[0] === 'chat') return { name: 'chat' };                                          /* AI 瀵硅瘽锛坈hat.js锛夛細鍑洪 / 闂煡璇嗙偣 / 鍒嗘瀽棰樺簱 */
  return { name: 'home' };
}
function go(hash) {
  if (location.hash === hash) render(); else location.hash = hash;
}

/* ---------- 銆岀户缁笂娆°€嶏細璁颁綇鏈€杩戝仛鐨勬槸鍝釜棰樺簱銆佸摢涓€棰?----------
   浠ュ墠姣忛鍙烽兘瀛樺湪 qbank.last.<棰樺簱id> 閲岋紝浣嗛椤典笉鐭ラ亾鏈€杩戝紑鐨勬槸鍝釜棰樺簱銆?   杩欓噷鍐嶈涓€鏉℃€荤殑锛岄椤靛氨鑳界洿鎺ユ妸銆岀户缁埛棰樸€嶆憜鍦ㄦ渶涓婇潰銆?*/
const LAST_BANK_KEY = 'qbank.lastbank.v1';
function rememberLast(bank, qid) {
  if (!bank || bank.paper) return;          // 涓存椂濂楀嵎闅忔椂鍙兘琚垹锛屼笉璁?  writeLS(LAST_BANK_KEY, { bankId: bank.id, qid: qid == null ? null : qid, ts: Date.now() });
}
function lastPos() {
  const v = readLS(LAST_BANK_KEY, null);
  if (!v || !v.bankId) return null;
  const b = bankById(v.bankId);
  if (!b || !b.questions || !b.questions.length) return null;
  let done = 0, ok = 0;
  b.questions.forEach(x => { const a = ANS[kOf(b, x)]; if (a && !a.redo) { done++; if (a.ok) ok++; } });
  let idx = b.questions.findIndex(x => String(x.id) === String(v.qid));
  if (idx < 0) idx = 0;
  return { bank: b, done: done, ok: ok, n: b.questions.length, idx: idx, ts: +v.ts || 0 };
}
window.addEventListener('hashchange', render);
/* 浠讳綍涓€涓剼鏈枃浠堕《灞傛姏閿欎篃鐣欎釜鎻愮ず锛岃€屼笉鏄櫧灞?*/
window.addEventListener('error', e => { if (e && e.message) showFatal(e.error || e.message); });
window.addEventListener('unhandledrejection', e => { if (e && e.reason) showFatal(e.reason); });

/* render 鍑洪敊涓嶅啀鐧藉睆锛氱暀涓€鏉￠敊璇彁绀猴紝鑳藉鍒惰兘閲嶈浇 */
let FATAL_SHOWN = false;
function showFatal(err) {
  const msg = (err && (err.stack || err.message)) || String(err == null ? '鏈煡閿欒' : err);
  try { console.error('[鍒烽绔橾', err); } catch (e) {}
  if (FATAL_SHOWN) return;
  FATAL_SHOWN = true;
  const bar = document.createElement('div');
  bar.id = 'fatalBar';
  bar.innerHTML = '<div class="fb-in"><b>椤甸潰鍑洪敊浜嗐€?/b><span class="fb-msg"></span>'
    + '<div class="fb-acts"><button class="btn tiny" id="fbCopy">澶嶅埗閿欒</button>'
    + '<button class="btn tiny primary" id="fbReload">閲嶆柊鍔犺浇</button>'
    + '<button class="btn tiny" id="fbClose">鍏虫帀</button></div>'
    + '<div class="small muted">甯歌鍘熷洜锛氶搴撴枃浠舵牸寮忎笉瀵癸紝鎴栨祻瑙堝櫒缂撳瓨鏄棫鐨勶紙鎸?Ctrl+F5 寮哄埛涓€娆★級銆備綘鐨勪綔绛旇褰曚笉浼氬洜涓鸿繖娆℃姤閿欎涪澶便€?/div></div>';
  document.body.appendChild(bar);
  const m = bar.querySelector('.fb-msg');
  if (m) m.textContent = ' ' + String(msg).split('\n')[0].slice(0, 300);
  const cp = bar.querySelector('#fbCopy');
  if (cp) cp.onclick = () => {
    const t = document.createElement('textarea');
    t.value = String(msg); document.body.appendChild(t); t.select();
    try { document.execCommand('copy'); toast('閿欒淇℃伅宸插鍒?); } catch (e) { toast('澶嶅埗澶辫触锛岃鎵嬪姩閫変腑'); }
    t.remove();
  };
  const rl = bar.querySelector('#fbReload');
  if (rl) rl.onclick = () => location.reload();
  const cl = bar.querySelector('#fbClose');
  if (cl) cl.onclick = () => { bar.remove(); FATAL_SHOWN = false; };
}
function render() {
  if (typeof richFlush === 'function') richFlush();          // 鏂规鍗侊細鎹㈤〉 / 閲嶇敾鍓嶅厛淇濆瓨灏卞湴缂栬緫
  try {
    const r = route();
    const sig = r.name + '/' + (r.bankId || '');
    /* 搂3.6-P2鈶ワ細鎹㈤〉 + 杩欓〉鐪熷彲鑳藉崱涓€涓?鈫?鍏堝悓姝ラ摵涓€灞傞鏋讹紝鐪熷唴瀹圭暀鍒颁笅涓€涓畯浠诲姟锛?       杩欐牱娴忚鍣ㄨ兘鍏堟妸楠ㄦ灦鐢诲嚭鏉ワ紙娓叉煋鐪熸參鐨勬椂鍊欙紝鐢ㄦ埛鐪嬪埌鐨勬槸楠ㄦ灦锛屼笉鏄櫧灞忥級 */
    if (sig !== _lastViewSig && skelNeeded(r) && skelPaint(r)) {
      setTimeout(() => { try { renderInner(); } catch (err) { showFatal(err); } }, 0);
      return;
    }
    renderInner();
  }
  catch (err) { showFatal(err); }
}
function renderInner() {
  const r = route();
  document.querySelectorAll('.mask').forEach(m => m.classList.remove('show'));
  const full = (r.name === 'quiz' || r.name === 'exam');
  document.body.classList.toggle('quiz', full);
  $('nav').style.display = r.name === 'quiz' ? 'flex' : 'none';
  $('chips').style.display = r.name === 'quiz' ? 'flex' : 'none';
  var sjc = $('subjchips'); if (sjc) sjc.style.display = r.name === 'quiz' ? 'flex' : 'none';
  /* 绗簩鎵癸細椤舵爮鐦﹁韩 鈥斺€?棰樺彿 / 璁剧疆 閮芥尓鍒颁笅闈簡锛堢瓟棰樺崱鐨勩€屼笂涓€棰?/ 绛旈鍗?/ 涓嬩竴棰樸€嶉噷鏈?#jumpInfo锛?     搴曢儴瀵艰埅閲屾湁 #btnSetAll锛夛紝鎵€浠ヨ繖涓や釜鑰佹寜閽粺涓€鏀惰捣鏉ワ紝鍙暀鍦?DOM 閲岀粰鑰佷唬鐮佸厹搴曘€?*/
  $('btnGrid').style.display = 'none';
  $('btnQuizSet').style.display = 'none';
  $('btnHome').style.display = r.name === 'home' ? 'none' : '';
  /* 鍥哄畾杩斿洖閿細闈為椤甸兘鏄剧ず锛涙尓鍒?body 涓嬫墠涓嶄細琚《鏍忕殑 backdrop-filter 闄愬埗鎴愰殢椤舵爮婊氳蛋 */
  var bfEl = $('backFix');
  if (bfEl && bfEl.parentNode !== document.body) document.body.appendChild(bfEl);
  if (bfEl) bfEl.style.display = r.name === 'home' ? 'none' : '';
  document.body.classList.toggle('has-back', r.name !== 'home');
  /* 搴曢儴瀵艰埅鐨勫叚涓幓澶勶細涓嶅垎椤甸潰锛屼竴鐩存樉绀?*/
  $('btnGoWrong').style.display = '';
  $('btnGoFav').style.display = '';
  $('btnGoSearch').style.display = '';
  if ($('btnGoKb')) $('btnGoKb').style.display = '';
  if ($('btnSetAll')) $('btnSetAll').style.display = '';

  /* 鑰冭瘯娌′氦鍗峰氨鎯宠烦璧帮細鍏堢‘璁わ紝鍏嶅緱鍊掕鏃跺湪鍚庡彴鑷繁璺?*/
  if (typeof examActive === 'function' && examActive() && r.name !== 'exam') {
    if (!confirm('鑰冭瘯杩樻病浜ゅ嵎銆傜寮€鐨勮瘽鍊掕鏃朵粛浼氱户缁紝纭畾绂诲紑锛?)) { go('#/exam/' + EX.id); return; }
    stopExamTimer();
  }

  if (r.name === 'home') renderHome();
  else if (r.name === 'import') renderImport();
  else if (r.name === 'wrong') { if (typeof renderWrong === 'function') renderWrong(); }
  else if (r.name === 'fav') { if (typeof renderFav === 'function') renderFav(); }
  else if (r.name === 'search') { if (typeof renderSearch === 'function') renderSearch(); }
  else if (r.name === 'stats') renderStats();
  else if (r.name === 'report') { if (typeof renderReport === 'function') renderReport(); }
  else if (r.name === 'kb') { if (typeof renderKb === 'function') renderKb(); }
  else if (r.name === 'sync') { if (typeof renderSync === 'function') renderSync(); }
  else if (r.name === 'exam') { if (typeof renderExam === 'function') renderExam(r.bankId); }
  else if (r.name === 'qlist') { if (window.CAT && CAT.qlistRender) CAT.qlistRender(r.bankId); else $('view').innerHTML = '<div class="card"><div class="empty">棰樼洰绠＄悊妯″潡娌″姞杞斤紙cat.js锛夈€?/div></div>'; }
  else if (r.name === 'chat') { if (window.CHAT && CHAT.render) CHAT.render(); else $('view').innerHTML = '<div class="card"><div class="empty">AI 瀵硅瘽妯″潡娌″姞杞斤紙chat.js锛夈€?/div></div>'; }
  else renderQuiz(r.bankId);
  markTop(r.name);
  try { uiPaintBadge(); } catch (e) {}
  viewEnter(r);
}

/* 瑙嗗浘绛惧悕瀹堝崼锛氬彧鏈夈€屾崲浜嗕釜椤甸潰銆嶆墠鎾叆鍦哄姩鐢汇€?   renderQuiz 姣忕瓟涓€棰樸€佹瘡缈讳竴棰橀兘浼氶噸鍐?#view锛屾墍浠ョ瓟棰橀〉鍙湅銆屽摢涓搴撱€嶏紝
   鏃犺剳鍔犲姩鐢讳細鍙樻垚姣忕瓟涓€棰樻暣椤甸棯涓€涓嬨€?*/
let _lastViewSig = '';
function viewEnter(r) {
  const sig = r.name + '/' + (r.bankId || '');
  if (sig === _lastViewSig) return;
  _lastViewSig = sig;
  skelDrop();                               /* 搂3.6-P2鈶ワ細鐪熷唴瀹瑰凡缁忓湪浜嗭紝杩樼暀鐫€楠ㄦ灦灏辨憳鎺?*/
  const v = $('view');
  if (!v) return;
  v.classList.remove('view-enter');
  void v.offsetWidth;                       /* 閲嶆帓涓€涓嬶紝璁╁悓涓€涓被鑳介噸鏂版挱 */
  v.classList.add('view-enter');
}
window.addEventListener('animationend', e => {
  if (e.target && e.target.id === 'view') e.target.classList.remove('view-enter');
});

/* ============================================================
   搂3.6-P2鈶?楠ㄦ灦灞忥細鎹㈤〉閭ｄ竴鐬棿鍏堢粰涓€屽舰鐘躲€嶏紝鍒灞忓箷鐧戒竴涓?   ------------------------------------------------------------
   路 棣栧睆閭ｅ眰鐩存帴鍐欏湪 index.html 鐨?#view 閲?鈥斺€?JS / 鐭ヨ瘑搴撹繕鍦ㄨВ鏋愭椂瀹冨氨鐪嬪緱瑙侊紝涓嶇敤绛変换浣曚汉锛?   路 杩欓噷鍙銆屾崲椤点€嶏細鍙湁鐪熷彲鑳藉崱涓€涓嬬殑鍦版柟鎵嶉摵锛堢煡璇嗗簱 / 鎼滅储鍏ㄩ儴 / 瀛︿範缁熻 / 澶ч搴擄級锛?     閾哄畬鎶婄湡鍐呭涓㈣繘涓嬩竴涓畯浠诲姟锛屾祻瑙堝櫒鎵嶆湁鏈轰細鍏堟妸楠ㄦ灦鐢诲嚭鏉ワ紱
   路 绛旈椤垫瘡绛斾竴棰橀兘浼氶噸鐢伙紝鎵€浠ュ彧鍦ㄣ€屾崲浜嗕釜棰樺簱銆嶆椂閾猴紙绛惧悕璺?viewEnter 閭ｄ竴濂椾竴鑷达級銆?   ============================================================ */
const SKEL_BIG_Q = 200;                 /* 棰樺簱瓒呰繃杩欎箞澶氶鎵嶅€煎緱閾轰竴灞?*/
function skelHtml(kind) {
  const bl = w => '<i class="sk-bl" style="width:' + w + '%"></i>';
  const card = ws => '<div class="sk-card">' + ws.map(bl).join('') + '</div>';
  if (kind === 'quiz') return '<div class="skel" aria-hidden="true">' + card([62, 100, 88, 74, 92]) + card([40, 70]) + '</div>';
  if (kind === 'stats') return '<div class="skel" aria-hidden="true">' + card([30, 100, 100]) + card([46, 100, 92, 84]) + '</div>';
  return '<div class="skel" aria-hidden="true">'
    + '<div class="sk-hero">' + bl(38) + bl(72) + bl(54) + '</div>'
    + card([100, 76])
    + '<div class="sk-grid">' + card([100, 62]) + card([100, 58]) + '</div></div>';
}
function skelNeeded(r) {
  if (!r || r.name === 'exam') return false;                    /* 鑰冭瘯鏈夎嚜宸辩殑鍊掕鏃讹紝鍒彃闃?*/
  if (r.name === 'quiz') {
    const b = (typeof bankById === 'function') ? bankById(r.bankId) : null;
    return !!(b && b.questions && b.questions.length >= SKEL_BIG_Q);
  }
  return r.name === 'kb' || r.name === 'search' || r.name === 'stats';
}
function skelPaint(r) {
  const v = $('view');
  if (!v) return false;
  v.innerHTML = skelHtml(r.name === 'quiz' ? 'quiz' : (r.name === 'kb' || r.name === 'stats') ? 'stats' : 'home');
  return true;
}
/* 鐪熷唴瀹圭敾濂戒簡锛氭妸杩樼暀鍦ㄩ偅鍎跨殑楠ㄦ灦鎽樻帀锛堟甯告儏鍐典笅 innerHTML 宸茬粡鎶婂畠椤舵帀浜嗭紝杩欐槸鍏滃簳锛?*/
function skelDrop() {
  const v = $('view');
  if (!v) return;
  const sk = v.querySelector('.skel');
  if (sk && sk.parentNode === v) sk.remove();
}

/* ============================================================
   棣栭〉
   ============================================================ */
/* 澶囦唤鎻愰啋锛氭湰鏈烘祻瑙堝櫒鏁版嵁涓€鏃﹁娓呭氨娌′簡锛屾病澶囦唤杩囨垨瓒呰繃 7 澶╁氨鎻愮ず涓€涓?*/
function backupHint() {
  const last = +readLS(BACKUP_KEY, 0) || 0;
  if (!last) return '<div class="note err" style="margin:0 0 10px">杩樻病鏈夊鍑鸿繃澶囦唤銆傛竻涓€娆℃祻瑙堝櫒缂撳瓨銆佹垨鑰呮崲璁惧锛屽埛棰樿褰曞氨鍏ㄦ病浜嗭紝寤鸿鐜板湪瀵煎嚭涓€浠姐€?/div>';
  const days = Math.floor((Date.now() - last) / 86400000);
  if (days >= 7) return '<div class="note" style="margin:0 0 10px">涓婃澶囦唤鏄?' + days + ' 澶╁墠锛? + fmtTime(last) + '锛夛紝寤鸿鍐嶅鍑轰竴浠姐€?/div>';
  return '<div class="small muted" style="margin:0 0 10px">涓婃澶囦唤锛? + fmtTime(last) + '</div>';
}

/* 浠婃棩瀛︿範鐪嬫澘锛氫粖鏃ュ凡绛?/ 浠婃棩姝ｇ‘鐜?/ 杩炵画鍒烽澶╂暟 */
function todayStats() {
  const dayOf = ts => { const d = new Date(ts); return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); };
  const today = dayOf(Date.now());
  const days = {};
  const weekAgo = Date.now() - 7 * 86400000;
  let dNum = 0, dOk = 0, weekN = 0;
  Object.keys(ANS).forEach(k => {
    const a = ANS[k]; if (!a || !a.ts) return;
    const d = dayOf(a.ts);
    days[d] = 1;
    if (a.ts >= weekAgo) weekN++;
    if (d === today) { dNum++; if (a.ok) dOk++; }
  });
  let streak = 0;
  const base = new Date(); base.setHours(0, 0, 0, 0);
  for (let i = 0; i < 3650; i++) {
    const d = dayOf(base.getTime() - i * 86400000);
    if (days[d]) streak++;
    else if (i > 0) break;      // 浠婂ぉ杩樻病鍋氫笉绠楁柇
  }
  return { dNum: dNum, dOk: dOk, streak: streak, weekN: weekN };
}

/* 搂3.6-P1鈶?瀛︿範鐑姏鍥撅細鎷跨幇鏈変綔绛旇褰曠殑鏃堕棿鎴筹紙ANS[k].ts锛夋寜澶╁垎妗讹紝涓嶆柊澧炰换浣曞瓨鍌ㄣ€?   杩斿洖 cells 鎸夋椂闂存搴忥紝姣忔牸 { ts, n, l }锛坙 = 0..4 鐨勬。浣嶏紝缁欓鑹茬敤锛夛紝澶栧姞 total / max / weeks銆?   鎺掑竷锛? 琛岋紙鍛ㄤ竴鈥﹀懆鏃ワ級脳 weeks 鍒楋紝鏈€鍚庝竴鍒楁槸鏈懆銆?*/
function heatStats(weeks) {
  const w = Math.max(4, Math.min(53, Math.round(+weeks || 12)));   /* 涓婇檺鏄竴骞达紙53 鍛級锛氭闈㈤椤佃閾烘弧鏁村紶鍗?*/
  const dayOf = ts => { const d = new Date(ts); return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); };
  const cnt = {};
  Object.keys(ANS).forEach(k => {
    const a = ANS[k]; if (!a || !a.ts) return;
    const d = dayOf(a.ts); cnt[d] = (cnt[d] || 0) + 1;
  });
  const base = new Date(); base.setHours(0, 0, 0, 0);
  const dow = (base.getDay() + 6) % 7;                       // 0 = 鍛ㄤ竴
  const start = base.getTime() - (dow + (w - 1) * 7) * 86400000;
  const cells = []; let total = 0, max = 0;
  for (let i = 0; i < w * 7; i++) {
    const ts = start + i * 86400000;
    const n = cnt[dayOf(ts)] || 0;
    total += n; if (n > max) max = n;
    cells.push({ ts: ts, n: n });
  }
  cells.forEach(c => {
    c.l = c.n <= 0 ? 0 : c.n <= 2 ? 1 : c.n <= 5 ? 2 : c.n <= 10 ? 3 : 4;
  });
  return { cells: cells, total: total, max: max, weeks: w };
}

/* 鍊欒ˉ姹?C锛氫竴棰橀兘杩樻病鏈夋椂鐨勩€屼笁姝ュ氨鑳藉紑濮嬨€嶅紩瀵煎崱锛堟湁棰樺簱浜嗚繑鍥炵┖涓诧級銆?   娉ㄦ剰锛氶椤垫鏂囧疄闄呯敱 cat.js 鐨勭洰褰曡鍥炬帴绠★紙瀹冧細鎶?app.js 娓叉煋鍑烘潵鐨勫崱鐗囨竻鎺夛級锛?   鎵€浠?cat.js 鐨?homeHtml() 涔熻皟杩欎釜鍑芥暟鍙栦竴娆★紱涓よ竟鍏辩敤锛屽埆鍚勫啓涓€浠姐€?*/
function firstGuideHtml() {
  if (typeof baseBanks === 'function' && baseBanks().length) return '';
  return `
    <div class="card guide" id="firstGuide">
      <div class="gname">涓夋灏辫兘寮€濮?/div>
      <div class="gstep"><b>鈶?/b><div><div class="gt">鎶婇搴撳杩涙潵</div><div class="small muted">鏀寔 JSON 棰樺簱锛屼篃鏀寔銆岄骞?/ 閫夐」 / 绛旀 / 瑙ｆ瀽銆嶈繖绉嶇函鏂囨湰锛岀矘璐存垨閫夋枃浠堕兘琛屻€?/div></div><button class="btn primary" data-g="#/import">鍘诲鍏?/button></div>
      <div class="gstep"><b>鈶?/b><div><div class="gt">鎯宠 AI 甯綘鍐欒В鏋?/div><div class="small muted">鍦ㄣ€孉I 涓庣煡璇嗗簱銆嶉噷濉湇鍔″晢鍦板潃 + API Key锛岀瓟瀹岄鐐广€孉I 瑙ｆ瀽銆嶅氨琛岋紱杩樿兘鎸備笂鑷繁鐨勮祫鏂欏簱銆?/div></div><button class="btn" data-g="#/kb">鍘昏缃?/button></div>
      <div class="gstep"><b>鈶?/b><div><div class="gt">鎵嬫満鍜岀數鑴戝叡鐢ㄤ竴浠借褰?/div><div class="small muted">鍦ㄣ€屼簯鍚屾銆嶉噷杩炰竴涓鏈変粨搴擄紝鍋氶璁板綍鑷姩浜掗€氾紱涓嶅仛涔熶笉褰卞搷鏈満浣跨敤銆?/div></div><button class="btn" data-g="#/sync">鍘诲悓姝?/button></div>
      <div class="small muted" style="margin-top:8px">鏁版嵁閮藉瓨鍦ㄦ湰鏈烘祻瑙堝櫒閲岋紝鎹㈢數鑴戞垨娓呯紦瀛樺墠鍏堝湪涓嬮潰銆屽鍑哄叏閮ㄦ暟鎹€嶅涓€浠姐€?/div>
    </div>`;
}
/* 寮曞鍗＄殑涓変釜鎸夐挳鐢ㄤ簨浠跺鎵橈紙cat.js 浼氶噸鐢婚椤碉紝閫愪釜缁戜細涓級 */
/* 瑙﹀睆涓娿€屾粦涓嶅姩銆嶇殑鍏滃簳锛氳В鏋愬潡/AI 杈撳嚭鏄?contenteditable 涓庡彲閫夋枃瀛楋紝
   鎵嬫寚钀藉湪涓婇潰鎷栨嫿浼氳褰撴垚銆岄€夋枃瀛椼€嶏紝椤甸潰灏辨粸浣忎簡銆傚彧瑕佹墜鎸囪惤鐐逛笉鍦ㄦ鍦ㄧ紪杈戠殑閭ｅ潡閲岋紝
   灏卞厛鎶婄劍鐐规斁寮€锛堥『甯︽敹閿洏锛夛紝鎶婃粴鍔ㄦ潈杩樼粰椤甸潰銆?   鈿?鍞嫭鏀捐鏍煎紡灏忔诞鏉★紙.fmt-bar锛岄€変腑鏂囧瓧鍚庣殑 鍔犵矖 / 棰滆壊鈥︼級锛氬畠鎸傚湪 body 涓娿€?   涓嶅湪缂栬緫鍧楅噷锛岀偣鑹茬偣鏃惰鏄厛鎶婄紪杈戝櫒澶辩劍锛屾墜鏈轰笂閫夊尯灏变涪浜?鈥斺€?   琛ㄧ幇鍑烘潵灏辨槸銆岄鑹叉敼涓嶄簡銆嶏紙2026-10-17 鐢ㄦ埛鎶ワ紝瀹炴祴鐐规诞鏉＄殑 pointerdown 鍚?activeElement 鍙?body锛夈€?*/
document.addEventListener('pointerdown', ev => {
  try {
    const ae = document.activeElement;
    if (!ae || !ae.isContentEditable) return;
    if (ev.target && ae.contains(ev.target)) return;
    if (ev.target && ev.target.closest && ev.target.closest('.fmt-bar')) return;   // 娴潯涓嶇畻銆岀偣鍒銆?    ae.blur();
  } catch (e) {}
}, true);

document.addEventListener('click', ev => {
  const t = ev.target && ev.target.closest ? ev.target.closest('#firstGuide [data-g]') : null;
  if (t) go(t.dataset.g);
});

function renderHome() {
  QZ.bankId = null;
  $('appTitle').textContent = '鍒烽绔?;

  const banks = baseBanks();
  const papers = allBanks().filter(b => b.paper);
  let totalQ = 0, totalDone = 0, totalOk = 0, wrongN = 0, dueN = 0;
  banks.forEach(b => b.questions.forEach(q => {
    totalQ++;
    const k = kOf(b, q), a = ANS[k];
    if (a && !a.redo) { totalDone++; if (a.ok) totalOk++; }
    if (a && (a.wrong || 0) > 0) wrongN++;
    if (isDue(k)) dueN++;
  }));
  const srsCap = +srsCfg().daily || 0;
  const favN = Object.keys(FAV).filter(k => FAV[k]).length;
  const TODAY = todayStats();

  const list = banks.map(b => {
    let done = 0, ok = 0, wr = 0;
    b.questions.forEach(q => {
      const a = ANS[kOf(b, q)];
      if (a && !a.redo) { done++; if (a.ok) ok++; }
      if (a && (a.wrong || 0) > 0) wr++;
    });
    const pct = b.questions.length ? Math.round(done / b.questions.length * 100) : 0;
    const acc = done ? Math.round(ok / done * 100) : 0;
    return `
      <div class="card bank">
        <div class="info">
          <div class="name">${esc(b.title)}${b.source === 'local' ? '<span class="pill local">鑷缓</span>' : '<span class="pill">鍐呯疆</span>'}</div>
          <div class="meta">${b.subtitle ? esc(b.subtitle) + '銆€' : ''}${b.questions.length} 棰樸€€${bankScoreText(b)}銆€宸茬瓟 ${done}${wr ? `銆€<span class="warn">閿欓 ${wr}</span>` : ''}銆€姝ｇ‘鐜?${acc}%</div>
          <div class="prog"><i style="width:${pct}%"></i></div>
        </div>
        <div class="acts">
          <button class="btn primary" data-start="${b.id}">${done ? '缁х画鍒烽' : '寮€濮嬪埛棰?}</button>
          <button class="btn" data-wrong="${b.id}">閿欓 ${wr}</button>
          <button class="btn" data-rand="${b.id}">闅忔満 30 棰?/button>
          <button class="btn" data-export="${b.id}">瀵煎嚭</button>
          ${b.source === 'local' ? `<button class="btn" data-edit="${b.id}">缂栬緫</button><button class="btn danger" data-del="${b.id}">鍒犻櫎</button>` : ''}
        </div>
      </div>`;
  }).join('');

  const paperList = papers.map(b => {
    let done = 0, ok = 0;
    b.questions.forEach(q => { const a = ANS[kOf(b, q)]; if (a && !a.redo) { done++; if (a.ok) ok++; } });
    return `
      <div class="card bank paper-card">
        <div class="info">
          <div class="name">${esc(b.title)}<span class="pill paper">${b.exam ? '妯℃嫙鑰冭瘯' : '涓存椂濂楀嵎'}</span></div>
          <div class="meta">${b.questions.length} 棰樸€€宸插仛 ${done}銆€姝ｇ‘鐜?${done ? Math.round(ok / done * 100) : 0}%</div>
          <div class="prog"><i style="width:${b.questions.length ? done / b.questions.length * 100 : 0}%"></i></div>
        </div>
        <div class="acts">
          <button class="btn primary" data-start="${b.id}">${done ? '缁х画' : '寮€濮?}${b.exam ? '鑰冭瘯' : '鍋氶'}</button>
          <button class="btn" data-renpaper="${b.id}" title="缁欒繖浠藉鍗?/ 璇曞嵎鏀逛釜鍚嶅瓧">鏀瑰悕</button>
          <button class="btn danger" data-delpaper="${b.id}">鍒犻櫎${b.exam ? '璇曞嵎' : '濂楀嵎'}</button>
        </div>
      </div>`;
  }).join('');

  /* 缁х画涓婃锛氭渶杩戝紑杩囩殑棰樺簱鏀惧埌鏈€涓婇潰锛屽厤鍘绘瘡娆＄炕鍒楄〃鎵句笂娆″仛鍒板摢 */
  const last = lastPos();
  const resumeHtml = last ? `
    <div class="resume">
      <div class="rinfo">
        <div class="rtitle">${esc(last.bank.title)}</div>
        <div class="rmeta">涓婃鍋氬埌 绗?${last.idx + 1} / ${last.n} 棰?路 宸茬瓟 ${last.done} 路 姝ｇ‘鐜?${last.done ? Math.round(last.ok / last.done * 100) : 0}%${last.ts ? ' 路 ' + fmtTime(last.ts) : ''}</div>
        <div class="prog"><i style="width:${last.n ? Math.round(last.done / last.n * 100) : 0}%"></i></div>
      </div>
      <button class="btn primary" id="toResume">缁х画鍒烽</button>
    </div>` : '';

  /* 鍊欒ˉ姹?C锛氫竴棰橀兘杩樻病鏈夋椂锛岀粰涓€鍧椼€屼笁姝ュ氨鑳藉紑濮嬨€嶇殑寮曞锛堟湁棰樹簡灏变笉鍐嶅嚭鐜帮級 */
  const guideHtml = firstGuideHtml();

  const bytes = storageBytes();
  $('view').innerHTML = `
    <div class="hero">
      <h1>鍒烽绔?/h1>
      <p>閫夋嫨棰樺嵆鏃跺垽鍒嗭紝閫夐敊绔嬪埢鍑鸿В鏋愩€傞敊棰樿嚜鍔ㄨ繘閿欓鏈紝鍙壒閲忔敹钘?/ 绉婚櫎 / 娓呯┖娆℃暟 / 缁勬垚濂楀嵎鍐嶅仛涓€閬嶏紝涔熻兘鏀硅В鏋愩€佹寜闇€瀵煎嚭銆?/p>
      <div class="hstat">
        <button class="hs" data-act="banks" title="寰€涓嬬湅鎴戠殑棰樺簱"><b>${banks.length}</b>涓搴?/button>
        <button class="hs" data-go="#/stats" title="瀛︿範缁熻"><b>${totalQ}</b>閬撻</button>
        <button class="hs" data-go="#/stats" title="瀛︿範缁熻"><b>${totalDone}</b>宸茬瓟</button>
        <button class="hs" data-go="#/stats" title="瀛︿範缁熻"><b>${totalDone ? Math.round(totalOk / totalDone * 100) : 0}%</b>姝ｇ‘鐜?/button>
        <button class="hs" data-go="#/wrong" title="鎵撳紑閿欓鏈?><b>${wrongN}</b>閿欓</button>
        <button class="hs" data-go="#/fav" title="鎵撳紑鏀惰棌"><b>${favN}</b>鏀惰棌</button>
        <button class="hs${dueN ? '' : ' off'}" data-act="review" title="${dueN ? '寮€濮嬩粖鏃ュ涔? : '浠婂ぉ娌℃湁璇ュ涔犵殑棰?}"><b>${dueN}</b>寰呭涔?/button>
      </div>
      <div class="hstat today">
        <div><b>${TODAY.dNum}</b>浠婃棩宸茬瓟</div>
        <div><b>${TODAY.dNum ? Math.round(TODAY.dOk / TODAY.dNum * 100) : 0}%</b>浠婃棩姝ｇ‘鐜?/div>
        <div><b>${TODAY.streak}</b>杩炵画澶╂暟</div>
        <div><b>${TODAY.weekN}</b>杩?7 澶?/div>
      </div>
    </div>
    ${resumeHtml}
    ${guideHtml}
    <div class="toolbar main">
      <button class="btn primary" id="toImport">锛?瀵煎叆 / 鏂板缓棰樺簱</button>
      ${dueN ? `<button class="btn primary" id="toReview">浠婃棩澶嶄範 ${srsCap && dueN > srsCap ? srsCap + ' / ' + dueN : dueN} 棰?/button>` : ''}
      <button class="btn" id="toRand">闅忔満鎶?30 棰?/button>
      <button class="btn" id="toUpload" title="涓婁紶棰樺簱鏂囦欢锛?json / 绾枃鏈級锛屼篃鍙互鐩存帴绮樿创棰樼洰">猬?涓婁紶棰樺簱</button>
    </div>
    <div class="toolbar sub">
      <button class="btn" id="toWrong">閿欓鏈?{wrongN ? '锛? + wrongN + (dueN ? ' 路 寰呭涔?' + dueN : '') + '锛? : ''}</button>
      <button class="btn" id="toFav">鏀惰棌${favN ? '锛? + favN + '锛? : ''}</button>
      <button class="btn" id="toSearch">鎼滅储棰樼洰<span class="kbd">/</span></button>
      <button class="btn" id="toStats">瀛︿範缁熻</button>
      <button class="btn" id="toHelp">蹇嵎閿?span class="kbd">?</span></button>
      <span class="small muted" id="storeUse" style="flex:1;min-width:180px">鏁版嵁瀛樺湪鏈満娴忚鍣紝鍏卞崰鐢ㄧ害 ${(bytes / 1024 / 1024).toFixed(2)} MB锛堟湰鍦颁及绠楋紝姝ｅ湪绠楃湡瀹炲崰鐢ㄢ€︼級銆?/span>
    </div>
    ${papers.length ? `<h2 class="sec">涓存椂濂楀嵎</h2>${paperList}` : ''}
    <h2 class="sec" id="secBanks">鎴戠殑棰樺簱</h2>
    ${list || '<div class="card"><div class="empty">杩樻病鏈夐搴擄紝鐐逛笂闈㈢殑鎸夐挳鍔犱竴涓惂銆?/div></div>'}
    <div class="card" style="margin-top:16px">
      <div class="name" style="font-weight:700;margin-bottom:6px">鏁版嵁澶囦唤</div>
      <div class="small muted" style="margin-bottom:10px">浣滅瓟璁板綍銆侀敊棰樸€佹敹钘忋€佽嚜瀹氫箟瑙ｆ瀽閮藉瓨鍦ㄦ湰鏈烘祻瑙堝櫒閲屻€傛崲鐢佃剳鎴栨竻缂撳瓨鍓嶏紝寤鸿瀵煎嚭澶囦唤銆?/div>
      ${backupHint()}
      <div class="row-inline">
        <button class="btn" id="expAll">瀵煎嚭鍏ㄩ儴鏁版嵁</button>
        <button class="btn" id="impAll">瀵煎叆鏁版嵁锛堟仮澶嶏級</button>
        <input type="file" id="impAllFile" accept=".json" style="display:none">
      </div>
    </div>`;

  $('stat').textContent = `${totalDone}/${totalQ}`;
  $('bar').style.width = (totalQ ? totalDone / totalQ * 100 : 0) + '%';
  on('toImport', () => go('#/import'));
  on('toUpload', () => go('#/import'));
  on('toWrong', () => go('#/wrong'));
  on('toFav', () => go('#/fav'));
  on('toSearch', () => go('#/search'));
  on('toRand', () => randomPaper(baseBanks(), 30));
  on('toStats', () => go('#/stats'));
  on('toHelp', showHelp);
  on('toReview', () => startReview(60));
  on('toResume', () => { if (last) startBank(last.bank.id); });
  on('expAll', exportAllData);
  on('impAll', () => $('impAllFile').click());
  on('impAllFile', importAllData, 'change');
  /* 棣栭〉涓婅皟鑹叉澘锛氱粺璁″潡鑳界洿鎺ョ偣杩涘幓 */
  document.querySelectorAll('.hstat [data-go]').forEach(el => el.onclick = () => go(el.dataset.go));
  /* 棣栨寮曞鍗′笂鐨勪笁涓寜閽細璧?document 涓婄殑浜嬩欢濮旀墭锛堣 firstGuideHtml 涓婇潰锛夛紝杩欓噷涓嶇敤鍐嶇粦 */
  document.querySelectorAll('.hstat [data-act]').forEach(el => el.onclick = () => {
    const a = el.dataset.act;
    if (a === 'banks') { const s = $('secBanks'); if (s) s.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    else if (a === 'review') { if (dueN) startReview(60); else toast('浠婂ぉ娌℃湁鍒版湡鐨勫涔犻锛屾帴鐫€鍒烽灏卞ソ'); }
  });

  document.querySelectorAll('[data-start]').forEach(el => el.onclick = () => startBank(el.dataset.start));
  document.querySelectorAll('[data-wrong]').forEach(el => el.onclick = () => { QZ.filter = 'wrong'; startBank(el.dataset.wrong); });
  document.querySelectorAll('[data-export]').forEach(el => el.onclick = () => exportBank(bankById(el.dataset.export)));
  document.querySelectorAll('[data-rand]').forEach(el => el.onclick = () => randomPaper([bankById(el.dataset.rand)], 30));
  document.querySelectorAll('[data-delpaper]').forEach(el => el.onclick = () => deletePaper(el.dataset.delpaper));
  document.querySelectorAll('[data-renpaper]').forEach(el => el.onclick = () => {
    const p = PAPERS.find(x => x.id === el.dataset.renpaper);
    if (!p) return;
    const t = (prompt('濂楀嵎鍚嶇О', p.title) || '').trim();
    if (!t || t === p.title) return;
    p.title = t; savePapers(); invalidateBanks(); render();
    toast('宸叉敼鍚嶏細' + t, 1600, 'ok');
  });
  document.querySelectorAll('[data-edit]').forEach(el => el.onclick = () => {
    const b = bankById(el.dataset.edit);
    SS.set('editing', b.id);
    SS.set('importText', JSON.stringify({ id: b.id, title: b.title, subtitle: b.subtitle, questions: b.questions }, null, 2));
    go('#/import');
  });
  document.querySelectorAll('[data-del]').forEach(el => el.onclick = () => {
    const b = bankById(el.dataset.del);
    if (!confirm(`鍒犻櫎棰樺簱銆?{b.title}銆嶏紵璇ラ搴撶殑浣滅瓟璁板綍銆佹敹钘忋€佽嚜瀹氫箟瑙ｆ瀽涔熶細涓€璧锋竻鎺夛紝涓嶅彲鎭㈠銆俙)) return;
    b.questions.forEach(q => {
      const k = kOf(b, q);
      delete ANS[k]; delete FAV[k]; delete NOTES[k];
      tombAdd('ans', k); tombAdd('fav', k); tombAdd('note', k);   // 璁板纰戯細鍒殑鏍囩椤典笉浼氭妸瀹冨悎骞跺洖鏉?    });
    LOCAL = LOCAL.filter(x => x.id !== b.id);
    try { localStorage.removeItem('qbank.last.' + b.id); } catch (e) {}   // 椤烘墜娓呮帀銆屼笂娆″仛鍒板摢銆嶇殑閿?    if (typeof dropTagsOfBank === 'function') { try { dropTagsOfBank(b.id); } catch (e) {} }   // 鑰冪偣鏍囩涔熶竴璧锋竻锛堣窡鏀惰棌涓€涓亾鐞嗭級
    invalidateBanks();
    writeLS(LS.banks, LOCAL); saveAns(); saveFav(); saveNotes();
    if (typeof BF !== 'undefined' && BF && BF.autoSave) { try { BF.autoSave(); } catch (e) {} }
    toast('宸插垹闄?); render();
  });
  /* 鐩綍寮忛搴撴祻瑙堬紙cat.js锛夛細鎶婇椤电殑缁熻鍗′箣鍚庢暣娈垫崲鎴愩€岀洰褰?+ 鍗＄墖銆嶈鍥?*/
  if (typeof CAT !== 'undefined' && CAT && CAT.renderHook) { try { CAT.renderHook(); } catch (err) { console.error('CAT', err); } }
  if (typeof BFF !== 'undefined' && BFF && BFF.boot) { try { BFF.boot(); } catch (err) { console.error('BFF', err); } }
  paintStorageUse();   // 鍗犵敤鏀规垚闂祻瑙堝櫒锛堝惈鐭ヨ瘑搴擄級锛屽洖鏉ュ啀鍥炲～鏁板瓧
}

/* 闅忔満鎶介锛氭妸棰樺簱鎵撲贡鍚庡彇鍓?n 閬擄紝缁勬垚涓存椂濂楀嵎鐩存帴鍋?*/
function randomPaper(banks, n) {
  const keys = [];
  (banks || []).forEach(b => { if (b && b.questions) b.questions.forEach(q => keys.push(kOf(b, q))); });
  if (!keys.length) { toast('杩樻病鏈夐鐩?); return; }
  for (let i = keys.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const t = keys[i]; keys[i] = keys[j]; keys[j] = t;
  }
  const c = Math.min(n, keys.length);
  makePaper('闅忔満 ' + c + ' 棰?, keys.slice(0, c));
}

function startBank(bankId) {
  const b = bankById(bankId); if (!b || !b.questions.length) return;
  QZ.order = null;
  QZ.focusCur = false;
  if (b.exam) { rememberLast(b, null); go('#/exam/' + b.id); return; }
  const last = readLS('qbank.last.' + b.id, null);
  QZ.cur = (last && b.questions.some(q => String(q.id) === String(last))) ? last : b.questions[0].id;
  rememberLast(b, QZ.cur);
  go('#/bank/' + b.id);
}

/* 涓存椂濂楀嵎 */
function makePaper(title, keys, opts) {
  opts = opts || {};
  keys = Array.from(new Set(keys));
  if (!keys.length) { toast('鍏堝嬀閫夐鐩?); return; }
  let id = (opts.exam ? 'exam-' : 'paper-') + Date.now().toString(36);
  while (PAPERS.some(p => p.id === id)) id += '-' + i2s();   // 闃叉挒杞?  const p = { id: id, title: title || ((opts.exam ? '妯℃嫙鑰冭瘯 路 ' : '濂楀嵎 路 ') + keys.length + ' 棰?), createdAt: Date.now(), keys: keys, exam: !!opts.exam, duration: opts.duration || 0 };
  if (opts.kind) p.kind = opts.kind;          // 'review' = 姣忔棩澶嶄範鍗凤紝鐢ㄦ潵闃插悓涓€澶╅噸澶嶇敓鎴?  if (opts.day) p.day = opts.day;
  if (opts.transient) {
    LIVE_PAPER = p;                           // 鍙繘鍐呭瓨锛氭瘡鏃ュ涔犱笉鍐嶅線濂楀嵎鍒楄〃閲屽鍗峰瓙
  } else {
    PAPERS.push(p);
    savePapers();
  }
  invalidateBanks();
  const mins = Math.round((opts.duration || 0) / 60);
  toast(opts.exam
    ? ('宸茬敓鎴愯瘯鍗凤細' + keys.length + ' 棰橈紝' + (mins ? '闄愭椂 ' + mins + ' 鍒嗛挓' : '涓嶉檺鏃?))
    : ('宸茬敓鎴愬鍗凤細' + keys.length + ' 棰橈紝鍋氬畬浼氳鍏ュ師鏉ョ殑閿欓娆℃暟'));
  go((opts.exam ? '#/exam/' : '#/bank/') + id);
}
function deletePaper(id) {
  const p = PAPERS.find(x => x.id === id);
  if (!p) return;
  if (!confirm('鍒犻櫎杩欎釜濂楀嵎锛熷鍗锋湰韬殑浣滅瓟璁板綍浼氭竻鎺夛紙鍘熸湰棰樺簱鐨勯敊棰樻鏁颁繚鐣欙級銆?)) return;
  const b = allBanks().find(x => x.id === id);
  if (b) b.questions.forEach(q => { const k = kOf(b, q); delete ANS[k]; tombAdd('ans', k); });
  PAPERS = PAPERS.filter(x => x.id !== id);
  tombAdd('paper', id);      // 璁板纰戯細鍒殑鏍囩椤?鍚堝苟鍐欏叆涓嶄細鎶婅繖涓鍗峰姞鍥炴潵
  savePapers(); saveAns();
  invalidateBanks();
  toast('宸插垹闄ゅ鍗?); render();
}

/* 鎵归噺鍒犲鍗凤紙涓存椂濂楀嵎鐨勬壒閲忕鐞嗙敤锛夛細涓€娆?confirm锛岄€愪釜娓呬綔绛?+ 璁板纰?*/
function deletePapers(ids) {
  const list = (ids || []).filter(Boolean);
  const hit = PAPERS.filter(p => list.indexOf(p.id) >= 0);
  if (!hit.length) { toast('娌￠€変腑濂楀嵎'); return 0; }
  const examN = hit.filter(p => p.exam).length;
  if (!confirm('鍒犻櫎閫変腑鐨?' + hit.length + ' 涓? + (examN ? '锛堝惈 ' + examN + ' 浠芥ā鎷熻瘯鍗凤級' : '') + '锛熷鍗锋湰韬殑浣滅瓟璁板綍浼氭竻鎺夛紙鍘熸湰棰樺簱鐨勯敊棰樻鏁颁繚鐣欙級銆?)) return 0;
  hit.forEach(p => {
    const b = allBanks().find(x => x.id === p.id);
    if (b) b.questions.forEach(q => { const k = kOf(b, q); delete ANS[k]; tombAdd('ans', k); });
    tombAdd('paper', p.id);
  });
  PAPERS = PAPERS.filter(p => list.indexOf(p.id) < 0);
  savePapers(); saveAns();
  invalidateBanks();
  toast('宸插垹闄?' + hit.length + ' 涓鍗?);
  return hit.length;
}
/* 閲嶅懡鍚嶅鍗?/ 璇曞嵎锛堜复鏃跺鍗锋壒閲忕鐞嗛〉涓庡崱鐗囬兘鐢ㄥ畠锛?*/
function renamePaper(id, title) {
  const p = PAPERS.find(x => x.id === id);
  if (!p) return false;
  const t = String(title == null ? '' : title).trim();
  if (!t) return false;
  p.title = t;
  savePapers();
  invalidateBanks();
  return true;
}
/* 瀵煎嚭閫変腑鐨勫鍗蜂负 JSON锛堥骞?/ 閫夐」 / 绛旀 / 瑙ｆ瀽锛屽甫涓婂師棰樺簱鍚嶏級 */
function exportPapers(ids) {
  const list = (ids || []).filter(Boolean);
  const out = [];
  list.forEach(pid => {
    const b = allBanks().find(x => x.id === pid);
    if (!b) return;
    out.push({
      title: b.title, exam: !!b.exam, createdAt: b.createdAt || 0,
      questions: b.questions.map(q => ({
        stem: q.stem, options: q.options, answer: q.answer,
        explain: (typeof explainOf === 'function') ? explainOf(q._srcKey || kOf(b, q), q) : q.explain
      }))
    });
  });
  if (!out.length) { toast('娌￠€変腑濂楀嵎'); return; }
  download('濂楀嵎瀵煎嚭-' + new Date().toISOString().slice(0, 10) + '.json',
    JSON.stringify({ app: 'shuati', version: 2, exported: new Date().toISOString(), papers: out }, null, 2));
  toast('宸插鍑?' + out.length + ' 涓鍗?);
}

/* ---------- 鍒犻锛氫粠銆愯嚜寤洪搴撱€戦噷绉婚櫎涓€閬撻 ----------
   鍦烘櫙锛氬埛棰樻椂瑙夊緱鏌愰亾棰樹笉濂斤紙閲嶅 / 鍑哄緱姝?/ 璺熻祫鏂欏涓嶄笂锛夛紝鎯崇洿鎺ユ墧鎺夈€?   鍏ュ彛锛氱瓟棰橀〉銆屸嫰 鏇村 鈫?鍒犻櫎鏈銆嶃€乧at.js 棰樼洰绠＄悊椤碉紙#/qlist锛夌殑鍕鹃€夊垹闄ゃ€?   鍐呯疆棰樺簱鏄?banks/*.js 閲岀殑鍙鏂囦欢锛屽垹涓嶄簡锛涜嚜寤洪搴撳瓨鍦?qbank.local.v2锛岃繖閲岀洿鎺ユ妸閭ｉ亾棰樻憳鎺夈€?   杩炲甫娓呮帀杩欓亾棰樼殑鏈満鐥曡抗锛堜綔绛?/ 鏀惰棌 / 鑷畾涔夎В鏋?/ 鍙傝€冭祫鏂?/ 鍙ｈ瘈渚跨 / 淇绛旀 / 鑰冪偣鏍囩锛夛紝
   璇ュ啓澧撶鐨勫啓澧撶 鈥斺€?鍏嶅緱琚彟涓€涓爣绛鹃〉鎴栦簯绔棫鍓湰澶嶆椿锛涘鍗烽噷寮曠敤瀹冪殑鍦版柟涔熶竴璧锋憳骞插噣銆?*/
function delTargetOf(bank, q) {
  if (!bank || !q) return null;
  if (bank.paper) {                              /* 濂楀嵎 / 妯¤€冮噷鐨勯锛氬垹鐨勬槸瀹冨師鏉ラ搴撻噷閭ｉ亾 */
    if (!q._srcKey) return null;
    const f = findQIn(baseBanks(), q._srcKey);
    if (!f || !f.bank || f.bank.source !== 'local') return null;
    return { bankId: f.bank.id, qid: f.q.id, title: f.bank.title };
  }
  if (bank.source !== 'local') return null;      /* 鍐呯疆棰樺簱锛氬彧璇?*/
  return { bankId: bank.id, qid: q.id, title: bank.title };
}
function delQTraces(k) {
  if (ANS[k] != null) { delete ANS[k]; tombAdd('ans', k); saveAns(); }
  if (FAV[k] != null) { delete FAV[k]; tombAdd('fav', k); saveFav(); }
  if (NOTES[k] != null) { delete NOTES[k]; tombAdd('note', k); saveNotes(); }   /* ai.js 鍖呰繃 tombAdd锛氬弬鑰冭祫鏂欐竻鍗曡窡鐫€涓€璧锋竻 */
  else if (typeof aiSrcFor === 'function' && typeof aiSrcDrop === 'function') {
    try { if (aiSrcFor(k).length) aiSrcDrop(k); } catch (e) {}                  /* 鍙墿鍙傝€冭祫鏂欐竻鍗曠殑鏃ф暟鎹篃娓呮帀 */
  }
  if (QTN[k] != null) { delete QTN[k]; tombAdd('qtn', k); saveQtn(); }
  if (FIX[k] != null) { delete FIX[k]; tombAdd('fix', k); saveFix(); }
  try { if (window.TAGS && TAGS.set) TAGS.set(k, []); } catch (e) {}
}
function delBankQuestion(bankId, qid) {
  if (!Array.isArray(LOCAL)) return { ok: false, reason: 'builtin' };
  const raw = LOCAL.find(x => x && x.id === bankId);
  if (!raw) return { ok: false, reason: 'builtin' };
  const qs = Array.isArray(raw.questions) ? raw.questions : (raw.questions = []);
  const idx = qs.findIndex(q => q && String(q.id) === String(qid));
  if (idx < 0) return { ok: false, reason: 'missing' };
  const srcKey = key(bankId, qid);
  /* 鍏堟竻濂楀嵎锛堣鍦ㄧ紦瀛樿繕璁ゅ緱鍑鸿繖閬撻鐨勬椂鍊欏仛锛夛細濂楀嵎鑷繁鐨勪綔绛旈敭銆佸鍗峰紩鐢ㄧ殑 keys */
  let paperTouched = false;
  try {
    allBanks().forEach(b => {
      if (!b.paper) return;
      b.questions.forEach(q => {
        if (q._srcKey !== srcKey) return;
        const pk = kOf(b, q);
        if (ANS[pk] != null) { delete ANS[pk]; tombAdd('ans', pk); paperTouched = true; }
      });
    });
    let changed = false;
    PAPERS.forEach(p => {
      if (Array.isArray(p.keys) && p.keys.indexOf(srcKey) >= 0) {
        p.keys = p.keys.filter(x => x !== srcKey);
        changed = true; paperTouched = true;
      }
    });
    if (changed) savePapers();
  } catch (e) {}
  qs.splice(idx, 1);
  delQTraces(srcKey);
  if (paperTouched) saveAns();
  writeLS(LS.banks, LOCAL);
  invalidateBanks();
  try { if (window.BF && BF.autoSync) BF.autoSync(); } catch (e) {}
  return { ok: true, left: qs.length };
}
window.delBankQuestion = delBankQuestion;   /* cat.js 鐨勯鐩鐞嗛〉瑕佽皟 */
window.delTargetOf = delTargetOf;

/* 绗?8 鏉★細鍦ㄧ瓟棰橀〉鐩存帴鏀归鐩紙棰樺共 / 閫夐」 / 绛旀 / 瑙ｆ瀽锛夈€傚彧瀵硅嚜寤洪搴撶敓鏁堬紝
   鍐呯疆棰樺簱鏄彧璇绘枃浠讹紱濂楀嵎閲岀殑棰樻敼瀹冨師棰樺簱閲岀殑閭ｉ亾銆?*/
function updateBankQuestion(bankId, qid, patch) {
  if (!Array.isArray(LOCAL)) return { ok: false, reason: 'builtin' };
  const raw = LOCAL.find(x => x && x.id === bankId);
  if (!raw) return { ok: false, reason: 'builtin' };
  const qs = Array.isArray(raw.questions) ? raw.questions : (raw.questions = []);
  const q = qs.find(x => x && String(x.id) === String(qid));
  if (!q) return { ok: false, reason: 'missing' };
  if (patch.stem != null) q.stem = patch.stem;
  if (patch.group != null) q.group = patch.group;
  if (patch.groupTitle != null) q.groupTitle = patch.groupTitle;
  if (Array.isArray(patch.options)) q.options = patch.options;
  if (Array.isArray(patch.answer)) q.answer = patch.answer;
  if (patch.explain != null) q.explain = patch.explain;
  writeLS(LS.banks, LOCAL);
  invalidateBanks();
  try { if (window.BF && BF.autoSync) BF.autoSync(); } catch (e) {}
  return { ok: true, q: q };
}
window.updateBankQuestion = updateBankQuestion;

function openQEditor(host, fk, q, target, done) {
  if (!host || !q || !target) return;
  const opts = (q.options || []).slice();
  const ans = (ansOf(fk, q) || []).slice();
  const letters = 'ABCDEFGH'.split('');
  host.innerHTML =
    '<div class="fixbox qeditbox">' +
    '<div class="small muted">鏀归搴撻噷鐨勮繖閬撻锛堥骞?/ 閫夐」 / 绛旀 / 瑙ｆ瀽锛夈€備繚瀛樺悗浼氬啓鍥為搴擄紝鍚屾鏃朵細涓€璧峰悓姝ュ嚭鍘汇€?/div>' +
    '<label class="small">棰樺共</label><textarea id="qeStem" rows="3" spellcheck="false">' + esc(q.stem || '') + '</textarea>' +
    '<label class="small">閫夐」锛堟瘡琛屼竴涓紝鏈€澶?8 涓紱绌鸿浼氬幓鎺夛紝瀛楁瘝鑷姩閲嶆帓锛?/label>' +
    opts.map((o, i) => '<div class="qe-opt"><span class="k">' + letters[i] + '</span><input data-qeo="' + i + '" value="' + esc(String(o == null ? '' : o)) + '"></div>').join('') +
    '<div class="actions"><button class="btn" id="qeAdd">锛?鍔犱竴涓€夐」</button></div>' +
    '<label class="small">姝ｇ‘绛旀</label>' +
    '<div class="fixrow">' + letters.map(L => '<label class="fixopt' + (ans.indexOf(L) >= 0 ? ' on' : '') + '"><input type="checkbox" data-qea="' + L + '"' + (ans.indexOf(L) >= 0 ? ' checked' : '') + '><span>' + L + '</span></label>').join('') + '</div>' +
    '<label class="small">瑙ｆ瀽锛堝彲鐣欑┖锛岀暀绌哄氨鍥炲埌棰樺簱鑷甫瑙ｆ瀽锛?/label><textarea id="qeExp" rows="3" spellcheck="false">' + esc(q.explain || '') + '</textarea>' +
    '<div class="actions"><button class="btn primary" id="qeOk">淇濆瓨鏀瑰姩</button><button class="btn" id="qeCancel">鍙栨秷</button></div></div>';
  host.querySelectorAll('.fixopt input').forEach(cb => cb.onchange = () => cb.parentNode.classList.toggle('on', cb.checked));
  const addOpt = host.querySelector('#qeAdd');
  if (addOpt) addOpt.onclick = () => {
    const inputs = host.querySelectorAll('[data-qeo]');
    if (inputs.length >= 8) { toast('鏈€澶?8 涓€夐」'); return; }
    const i = inputs.length, L = letters[i];
    const row = document.createElement('div');
    row.className = 'qe-opt';
    row.innerHTML = '<span class="k">' + L + '</span><input data-qeo="' + i + '" value="">';
    inputs[inputs.length - 1].closest('.qe-opt').after(row);
  };
  host.querySelector('#qeCancel').onclick = () => { host.innerHTML = ''; };
  host.querySelector('#qeOk').onclick = () => {
    const stem = host.querySelector('#qeStem').value.trim();
    const options = Array.from(host.querySelectorAll('[data-qeo]')).map(el => el.value.trim()).filter(t => t !== '');
    const ansL = Array.from(host.querySelectorAll('.fixopt input')).filter(cb => cb.checked).map(cb => cb.dataset.qea)
      .filter((L, i, arr) => arr.indexOf(L) === i && letters.indexOf(L) < options.length);
    const explain = host.querySelector('#qeExp').value;
    if (!stem) { toast('棰樺共涓嶈兘绌?); return; }
    if (!options.length) { toast('鑷冲皯鐣欎竴涓€夐」'); return; }
    if (!ansL.length) { toast('鑷冲皯鍕句竴涓纭瓟妗?); return; }
    const r = updateBankQuestion(target.bankId, target.qid, { stem: stem, options: options, answer: ansL, explain: explain });
    if (!r.ok) { toast(r.reason === 'builtin' ? '鍐呯疆棰樺簱鏄彧璇绘枃浠讹紝鏀逛笉浜? : '杩欓亾棰樺凡缁忎笉鍦ㄤ簡'); return; }
    host.innerHTML = '';
    toast('棰樼洰宸叉敼濂?, 1600, 'ok');
    if (done) done();
  };
}
window.openQEditor = openQEditor;


function storageBytes() {
  let n = 0;
  try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); n += (k || '').length + (localStorage.getItem(k) || '').length; } } catch (e) {}
  /* 绗旇/棰樺簱宸茬粡鎼埌 IndexedDB锛岃繖閲岃ˉ鍥炲幓锛屽惁鍒欎細鏄剧ず鎴愩€屾墠鐢ㄤ簡 1MB銆嶉獥浜?*/
  try {
    (window.__bigKeys || []).forEach(k => {
      const raw = window.__fpRaw ? window.__fpRaw(k) : null;
      if (raw) n += k.length + raw.length;
    });
  } catch (e) {}
  return n * 2;
}
/* 鐪熷疄鍗犵敤瑕侀棶娴忚鍣細鐭ヨ瘑搴撳瓨鍦?IndexedDB 閲岋紝localStorage 鏍规湰鏁颁笉鍑烘潵 */
async function storageUse() {
  try {
    if (navigator.storage && navigator.storage.estimate) {
      const e = await navigator.storage.estimate();
      if (e && (e.usage || e.quota)) return { used: e.usage || 0, quota: e.quota || 0, real: true };
    }
  } catch (err) {}
  return { used: storageBytes(), quota: 0, real: false };
}
async function paintStorageUse() {
  const u = await storageUse();
  const el = $('storeUse');
  if (!el) return;                       // 椤甸潰宸茬粡鐢诲埌鍒鍘讳簡
  const mb = x => (x / 1024 / 1024).toFixed(2);
  el.textContent = '鏁版嵁瀛樺湪鏈満娴忚鍣紝鍏卞崰鐢ㄧ害 ' + mb(u.used) + ' MB'
    + (u.quota ? '锛堟祻瑙堝櫒缁欑殑棰濆害绾?' + Math.round(u.quota / 1024 / 1024) + ' MB锛? : '')
    + (u.real ? '锛屽惈鐭ヨ瘑搴撱€? : '锛屽彧绠椾簡 localStorage锛岀煡璇嗗簱娌＄畻杩涙潵銆?);
}

function exportBank(b) {
  if (!b) return;
  if (typeof BF !== 'undefined' && BF && BF.exportBankHook) { try { BF.exportBankHook(b); return; } catch (e) {} }
  const data = { id: b.id, title: b.title, subtitle: b.subtitle, questions: b.questions.map(q => ({ id: q.id, stem: q.stem, options: q.options, answer: q.answer, explain: q.explain, group: q.group, groupTitle: q.groupTitle })) };
  download(safeName(b.title) + '.json', JSON.stringify(data, null, 2), 'application/json');
}

/* 椤跺眰鐨勫垎绫昏〃锛堟儼鎬у彇鍊硷細cat.js 杩樻病鍔犺浇鏃朵篃瀹夊叏锛?*/
function catRows() {
  try { if (typeof CAT !== 'undefined' && CAT && CAT.all) return CAT.all().map(c => ({ id: c.id, title: c.title, parent: c.parent, order: c.order })); } catch (e) {}
  return readLS(LS.cat, []) || [];
}

/* 鍏ㄩ噺澶囦唤 / 鎭㈠锛氱煡璇嗗簱姝ｆ枃涔熶竴璧峰甫璧帮紙鏉ヨ嚜 鐭ヨ瘑搴?js 鐨勬枃浠跺簱涓嶅湪閲岄潰锛?*/
async function exportAllData() {
  let tipCats = 0;
  const data = { app: 'shuati', version: 8, exportedAt: new Date().toISOString(), answers: ANS, banks: LOCAL, cats: catRows(), favs: FAV, notes: NOTES, papers: PAPERS, settings: SET, fixes: FIX, srs: SRS, qtn: QTN,
    aisrc: (typeof aiSrcNorm === 'function' ? aiSrcNorm() : readLS('qbank.aisrc.v1', {})),
    tags: (typeof window.tagsOf === 'function') ? window.TAGS.data() : readLS(LS.tag, {}),
    tagVocab: (typeof window.TAGS === 'object' && window.TAGS) ? window.TAGS.vocab() : readLS(LS.tagvocab, []),
    report: (window.REPORT && REPORT.data) ? REPORT.data() : readLS(LS.report, []) };
  let tip = '';
  try {
    if (typeof kbExportAll === 'function') {
      toast('姝ｅ湪鎵撳寘鐭ヨ瘑搴撯€?, 1200);
      const kb = await kbExportAll();
      if (kb && (kb.list || []).length) { data.kb = kb; tip = '锛屽惈 ' + kb.list.length + ' 涓嚜宸卞鍏ョ殑鐭ヨ瘑搴?; }
      if (kb && (kb.autoN || 0)) tip += '锛堝彟鏈?' + kb.autoN + ' 涓潵鑷?鐭ヨ瘑搴?js 鐨勬枃浠跺簱涓嶆墦鍖咃紝鎹㈢數鑴戝悗閲嶆柊鐢熸垚鎴栧鍒堕偅涓枃浠跺嵆鍙級';
    }
  } catch (err) { tip = '锛堢煡璇嗗簱鎵撳寘澶辫触锛? + (err.message || err) + '锛?; }
  download('鍒烽绔?鍏ㄩ儴鏁版嵁-' + stamp() + '.json', JSON.stringify(data), 'application/json');
  writeLS(BACKUP_KEY, Date.now());
  toast('宸插鍑哄浠? + tip, 3600);
}
function importAllData(e) {
  const f = e.target.files[0]; if (!f) return;
  const r = new FileReader();
  r.onload = () => {
    try {
      const d = JSON.parse(r.result);
      if (!d || typeof d !== 'object') throw new Error('鏍煎紡涓嶅');
      const cnt = k => Object.keys(d[k] || {}).length;
      const kbCnt = (d.kb && (d.kb.list || []).length) || 0;
      const tagCnt = Object.keys(d.tags || {}).length;
      const repCnt = Array.isArray(d.report) ? d.report.length : 0;
      if (!confirm(`鍗冲皢瀵煎叆锛氫綔绛?${cnt('answers')} 鏉°€佽嚜寤洪搴?${(d.banks || []).length} 涓€佹敹钘?${cnt('favs')} 鏉°€佽嚜瀹氫箟瑙ｆ瀽 ${cnt('notes')} 鏉°€佸彛璇€渚跨 ${cnt('qtn')} 鏉°€佽В鏋愬弬鑰冭祫鏂?${cnt('aisrc')} 閬撻銆佷慨姝ｇ瓟妗?${cnt('fixes')} 鏉?{tagCnt ? '銆佽€冪偣鏍囩 ' + tagCnt + ' 閬撻' : ''}${repCnt ? '銆佸鎯呮姤鍛?' + repCnt + ' 浠? : ''}${kbCnt ? '銆佺煡璇嗗簱 ' + kbCnt + ' 涓? : ''}銆俓n\n瀵煎叆浼氫笌鐜版湁鏁版嵁鍚堝苟锛堝悓涓€鏉′互瀵煎叆鐨勪负鍑嗭級锛屼笉浼氬垹闄ゅ叾瀹冭褰曘€傜户缁紵`)) return;
      Object.assign(ANS, d.answers || {});
      Object.assign(FAV, d.favs || {});
      Object.assign(NOTES, d.notes || {});
      Object.assign(FIX, d.fixes || {});
      if (d.qtn && typeof d.qtn === 'object') {                  // 鍙ｈ瘈渚跨锛氬悓涓€鏉′互鏃堕棿鎴虫柊鐨勪负鍑?        Object.keys(d.qtn).forEach(k => {
          const th = d.qtn[k], mi = QTN[k];
          if (th && typeof th === 'object' && (!mi || (+th.ts || 0) > (+mi.ts || 0))) QTN[k] = th;
        });
      }
      if (Array.isArray(d.banks)) d.banks.forEach(b => { if (b && b.id && !LOCAL.some(x => x.id === b.id)) LOCAL.push(b); });
      let tipCats = 0;                                          // 瀵煎叆杩涙潵鐨勫垎绫绘暟锛堝師鍏堟紡浜嗗０鏄庯紝瀵艰嚧瀵煎叆瀹屽脊銆屽鍏ュけ璐ワ細tipCats is not defined銆嶏級
      if (Array.isArray(d.cats) && d.cats.length) {            // 鍒嗙被鏍戣窡鐫€涓€璧锋仮澶?        if (typeof CAT !== 'undefined' && CAT && CAT.importCats) {
          try { const r = CAT.importCats(d.cats); tipCats = (r.added || 0) + (r.updated || 0); } catch (err) {}
        } else {
          const have = readLS(LS.cat, []) || [];
          const seen = {}; have.forEach(c => { if (c && c.id) seen[c.id] = 1; });
          let n = 0;
          d.cats.forEach(c => {
            if (!c || !c.id || seen[c.id]) return;
            have.push({ id: String(c.id), title: String(c.title || '鏈懡鍚嶅垎绫?), parent: (c.parent == null ? null : String(c.parent)), order: (c.order == null ? 999 : (+c.order || 0)) });
            seen[c.id] = 1; n++;
          });
          writeLS(LS.cat, have); tipCats = n;
        }
      }
      if (Array.isArray(d.papers)) d.papers.forEach(p => { if (p && p.id && !PAPERS.some(x => x.id === p.id)) PAPERS.push(p); });
      if (d.settings) Object.assign(SET, d.settings);
      if (d.srs) Object.assign(SRS, d.srs);
      let kbN = 0;
      if (d.kb && typeof kbImportAll === 'function') { try { kbN = kbImportAll(d.kb) || 0; } catch (err) {} }
      /* 鑰冪偣鏍囩锛氬悓涓€鏉′互瀵煎叆鐨勪负鍑嗭紙鎸夐鍚堝苟锛夈€傝€佸浠介噷鐨?syllabus锛堣€冪翰娓呭崟锛夊瓧娈靛凡缁忎笉鐢ㄤ簡锛屽拷鐣ュ嵆鍙?*/
      let tagN = 0;
      if (d.tags && typeof window.TAGS === 'object' && window.TAGS) {
        try {
          const mine = window.TAGS.data() || {};
          Object.keys(d.tags).forEach(k => { if (Array.isArray(d.tags[k])) { mine[k] = d.tags[k].slice(); tagN++; } });
          if (Array.isArray(d.tagVocab)) window.TAGS.rememberVocab(d.tagVocab);
          window.TAGS.save();
        } catch (err) {}
      }
      /* 瀛︽儏璇婃柇鐨勫巻鍙叉姤鍛婏細鎸?id 骞堕泦锛堝鍏ョ殑浼樺厛锛夛紝鏈€澶氱暀 20 浠?*/
      let repN = 0;
      if (Array.isArray(d.report) && window.REPORT && REPORT.data) {
        try {
          let mine = REPORT.data() || [];
          const seen = {};
          mine.forEach(r => { if (r && r.id) seen[r.id] = 1; });
          d.report.forEach(r => { if (r && r.id && r.text && !seen[r.id]) { mine.push(r); seen[r.id] = 1; repN++; } });
          mine = mine.sort((x, y) => (+y.ts || 0) - (+x.ts || 0)).slice(0, 20);
          if (typeof mergeWrite === 'function') mergeWrite(LS.report, mine, 'report'); else writeLS(LS.report, mine);
        } catch (err) {}
      }
      tombClear();   // 瀵煎叆锛濅互杩欎唤澶囦唤涓哄噯锛屾竻鎺夋湰鏈哄纰戯紝鍒妸瑕佹仮澶嶇殑璁板綍鎸″洖鍘?      /* 瑙ｆ瀽鍙傝€冭祫鏂欙細鏀惧湪 tombClear 涔嬪悗骞讹紙璧扮殑 mergeWrite 浼氱湅澧撶锛?/
      if (d.aisrc && typeof aiSrcMergeIn === 'function') { try { aiSrcMergeIn(d.aisrc); } catch (e) {} }
      migrate();
      invalidateBanks();
      saveAns(); saveFav(); saveNotes(); saveQtn(); writeLS(LS.banks, LOCAL); savePapers(); writeLS(LS.set, SET);
      saveFix(); writeLS(LS.srs, SRS);
      if (typeof BF !== 'undefined' && BF && BF.autoSave) { try { BF.autoSave(); } catch (e) {} }
      toast('瀵煎叆瀹屾垚' + (tipCats ? '锛堝惈 ' + tipCats + ' 涓垎绫伙級' : '') + (kbN ? '锛屽惈 ' + kbN + ' 涓煡璇嗗簱' : '')
        + (tagN ? '锛屽惈 ' + tagN + ' 閬撻鐨勮€冪偣鏍囩' : '')
        + (repN ? '锛屽惈 ' + repN + ' 浠藉鎯呮姤鍛? : '')); render();
    } catch (err) { alert('瀵煎叆澶辫触锛? + err.message); }
  };
  r.readAsText(f, 'utf-8');
  e.target.value = '';
}

/* ============================================================
   绛旈椤?   ============================================================ */
/* 棰樺共 / 鍏辩敤棰樺共 / 閫夐」鐨勬覆鏌擄細
   浠ュ墠鍙仛銆?鍏紡$ 鈫?KaTeX銆嶏紝markdown 鐨勮〃鏍笺€乣``mermaid銆佹€濈淮瀵煎浘鍦ㄩ骞查噷鍏ㄦ槸鍘熸牱鏂囧瓧銆?   鐜板湪鎸夊唴瀹瑰垽鏂細鐪嬬潃鍍?markdown锛堟湁鍥存爮 / 琛ㄦ牸鍒嗛殧琛?/ 鎻愮ず妗?/ 鏍囬锛夊氨璧?mdToHtml锛?   鍚﹀垯缁存寔鑰佽涓猴紙杞箟 + 鍙覆鍏紡锛夛紝鏅€氱函鏂囨湰棰樺共瀹屽叏涓嶅彈褰卞搷銆?*/
const stemLooksMd = t => {
  const s = String(t == null ? '' : t);
  if (!s) return false;
  if (/^\s*```/m.test(s)) return true;                 /* 浠ｇ爜鍥存爮锛歮ermaid / mindmap / diagram */
  if (/^\s*\|.*\|\s*$/m.test(s) && /^\s*\|[\s:|-]+\|\s*$/m.test(s)) return true;   /* 琛ㄦ牸锛堣鏈夊垎闅旇锛?*/
  if (/^\s*>\s*\[!(tip|warning|info|note|danger)\]/im.test(s)) return true;       /* 鎻愮ず妗?*/
  if (/^#{2,6}\s+\S/m.test(s)) return true;            /* 鏍囬 */
  return false;
};
const stemHtml = t => {
  if (typeof mdToHtml === 'function' && stemLooksMd(t)) {
    try { return mdToHtml(String(t == null ? '' : t)); } catch (e) {}
  }
  return (typeof renderMathText === 'function' ? renderMathText(t) : esc(t));
};
function renderQuiz(bankId) {
  if (typeof richFlush === 'function') richFlush();          // 鏂规鍗侊細閲嶇敾鍓嶅厛鎶婂氨鍦扮紪杈戠殑鏀瑰姩瀛樹簡
  const bank = bankById(bankId);
  if (!bank) { go('#/'); return; }
  if (bank.exam) { go('#/exam/' + bank.id); return; }   // 妯¤€冭蛋涓撶敤椤甸潰
  QZ.bankId = bankId;
  $('appTitle').textContent = bank.title;

  /* 鍏堟敹涓€涓嬪け鏁堢殑鍏绛涢€夊啀绠楅姹狅細鏍囧畬鏈€鍚庝竴棰樸€屾湭閫夈€?鎹㈢瓫娉曞悗锛?     鍚﹀垯 poolOf 浼氬厛鎸夋棫绉戠洰绠楀嚭绌烘睜锛岄〉闈㈠崱鍦ㄣ€岃繖閲屾殏鏃舵病鏈夐鐩€嶈€?chips 宸茬粡鍥炲叏閫夈€?*/
  if (QZ.subject && subjectCount(bank, QZ.subject) === 0) QZ.subject = '';
  const pool = poolOf(bank);
  if (!pool.length) {
    $('view').innerHTML = `<div class="card"><div class="empty">杩欓噷鏆傛椂娌℃湁棰樼洰锛屾崲涓垎绫荤湅鐪嬨€?/div></div>`;
    $('stat').textContent = ''; $('bar').style.width = '0%';
    renderChips(bank);
    return;
  }
  if (QZ.cur == null || !pool.some(q => String(q.id) === String(QZ.cur))) QZ.cur = pool[0].id;
  const q = pool.find(x => String(x.id) === String(QZ.cur));
  const k = kOf(bank, q);
  const speed = SET.quizMode === 'speed';
  const recite = SET.quizMode === 'recite';
  uiSpeedStop();                                  // 鎹㈤ / 閲嶇敾锛氬厛鎶婁笂涓€棰樼殑閫熷埛娴眰鍜屽緟璺宠鏃舵敹鎺?  const locked = !recite && answered(k);
  const rec = recOf(k);
  const picked = locked ? (rec.sel || []) : (recite ? [] : (QZ.pending[q.id] || []));
  const fk = favKey(bank, q);
  const faved = !!FAV[fk];
  const custom = !!noteOf(fk);
  const fixedAns = hasFix(fk);
  const delT = delTargetOf(bank, q);              /* 杩欓亾棰樿兘涓嶈兘鍒犮€佸垹鐨勬槸鍝釜棰樺簱閲岀殑鍝亾锛堝唴缃搴撲笉鑳藉垹锛?*/

  const opts = q.options.map((t, i) => {
    const K = 'ABCDEFGH'[i];
    let cls = 'opt';
    if (recite) {
      /* 鑳岄妯″紡锛氶€夐」鍙锛屾纭瓟妗堢洿鎺ラ珮浜紙鐐逛竴涓嬪彧缁欐彁绀猴紝涓嶅垽鍒嗐€佷笉鍐欒褰曪級 */
      cls += ' ro';
      if (ansOf(fk, q).includes(K)) cls += ' right';
    } else if (locked) {
      if (ansOf(fk, q).includes(K)) cls += ' right';
      else if (picked.includes(K)) cls += ' wrong';
    } else if (picked.includes(K)) cls += ' sel';
    if (!recite && !locked && (QZ.excl[q.id] || []).indexOf(K) >= 0) cls += ' excl';   /* 闀挎寜鎺掗櫎锛氬彉鐏般€佷笉鍙備笌閫夋嫨涓庡垽鍒?*/
    return `<button class="${cls}" data-k="${K}" ${locked ? 'disabled' : ''}><span class="k">${K}</span><span>${stemHtml(optText(t, K))}</span></button>`;
  }).join('');

  const pos = pool.findIndex(x => String(x.id) === String(q.id)) + 1;
  $('view').innerHTML = `
    <div class="card">
      <div class="qmode" role="tablist" aria-label="鍒烽妯″紡">
        ${QUIZ_MODES.map(([mk, mt]) => `<button class="chip qm${SET.quizMode === mk ? ' on' : ''}" data-qm="${mk}" title="${
          mk === 'normal' ? '鏅€氭ā寮忥細鐐归€夐」鍒ゅ垎锛岀湅瑙ｆ瀽' :
          mk === 'speed' ? '閫熷埛妯″紡锛氱瓟瀵圭害 1.2 绉掕嚜鍔ㄨ烦涓嬩竴棰橈紝绛旈敊鍋滀笅鐪嬭В鏋? :
          '鑳岄妯″紡锛氫笉瑕佹眰浣滅瓟锛岀洿鎺ョ湅绛旀鍜岃В鏋愶紙涓嶅啓浠讳綍浣滅瓟璁板綍锛屼笉鐔熷氨鐐?鈽?鏀惰棌锛?}">${mt}</button>`).join('')}
        ${speed && SET.speedSec > 0 && !locked ? `<span class="sp-clock" id="spClock" title="閫熷埛闄愭椂锛氳秴鏃剁畻绛旈敊">鈴?${SET.speedSec}s</span>` : ''}
        <span class="spacer-grow"></span>
        <span class="qm-hint small muted">${recite ? '鑳岄锛氱洿鎺ョ湅绛旀锛屼笉璁颁綔绛? : speed ? '閫熷埛锛氱瓟瀵硅嚜鍔ㄨ烦锛岀瓟閿欏仠涓? : ''}</span>
      </div>
