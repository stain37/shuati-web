        ${fixedAns ? `<span class="tag g" title="绛旀鏄綘鎵嬪姩鏀硅繃鐨勶紝鍙湪鏈満鐢熸晥">绛旀宸蹭慨姝?/span>` : ''}
        ${!recite && rec && rec.tries ? `<span class="tag g">鏈浣滅瓟 ${rec.tries} 娆?路 閿?${rec.wrong || 0} 娆?/span>` : ''}
        <span class="spacer-grow"></span>
        <button class="btn qn-open" id="btnQn" title="鍙ｈ瘈 / 鎬濊矾渚跨锛氱嫭绔嬫诞绐楋紝鍙嫋鍔ㄣ€佸彸涓嬭鍙媺澶у皬锛涘彧鍦ㄨ繖涓〉闈㈠嚭鐜?>鉁?鍙ｈ瘈</button>
        <button class="btn qd-grip" id="qdGrip" title="鎷栧姩棰樼洰鍖哄潡锛堝彸涓嬭鍙媺澶у皬锛夛紱鍐嶇偣涓€涓嬪洖鍒版甯告帓鐗?>鉅?/button>
        <button class="btn focus-btn${SET.focus ? ' on' : ''}" id="btnFocus" title="涓撴敞妯″紡锛氭妸椤舵爮鍜屽簳鏍忔敹璧锋潵锛屽彧鐪嬮鐩紙Esc 閫€鍑猴級">鉀?涓撴敞</button>
        <button class="btn fav-btn${faved ? ' on' : ''}" id="btnFav">${faved ? '鈽?宸叉敹钘? : '鈽?鏀惰棌'}</button>
      </div>
      <div class="vstrip" id="vStrip"></div>
