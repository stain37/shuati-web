    <details class="card" style="margin-top:14px">
      <summary style="cursor:pointer;font-weight:700">鏀寔鐨勬枃鏈牸寮忥紙鐐瑰紑鐪嬫ā鏉匡級</summary>
      <pre class="fmt"># 鐢熷寲 绗竴绔?铔嬬櫧璐?
1. 铔嬬櫧璐ㄥ垎瀛愪腑鍥涚骇缁撴瀯鐨勭壒寰佹槸
A. 鍦ㄤ笁绾х粨鏋勭殑鍩虹涓婅繘涓€姝ユ姌鍙犺€屾垚
B. 鍒嗗瓙涓繀瀹氬惈鏈夎緟鍥犲瓙
C. 渚濊禆鑲介敭缁寸郴绋冲畾鎬?D. 涓€瀹氱敱涓ゆ潯鎴栦袱鏉′互涓婄殑澶氳偨閾剧粍鎴?绛旀锛欴
瑙ｆ瀽锛氬洓绾х粨鏋勭敱涓ゆ潯浠ヤ笂澶氳偨閾撅紙浜氬熀锛夎仛鍚堣€屾垚銆?
2. 鍏充簬鏌愮柧鐥咃紝涓嬪垪璇存硶姝ｇ‘鐨勬湁
A. 鈥?B. 鈥?C. 鈥?D. 鈥?绛旀锛欰BD
瑙ｆ瀽锛氬閫夐绛旀杩炲啓鍗冲彲銆?/pre>
      <div class="hint" style="margin-top:10px">
        路 棰樺彿 <b>1.</b> / <b>1銆?/b> 鍙啓鍙渷锛涢€夐」琛屽繀椤荤敤 <b>A.</b> / <b>A銆?/b> / <b>A)</b> 寮€澶淬€?br>
        路 <b># 鍚嶇О</b> 璁句负棰樺簱鍚嶏紱<b>## 璇存槑</b> 浼氭垚涓哄悗闈㈤鐩殑銆屽叡鐢ㄩ骞层€嶏紙鐥呬緥棰樸€丅 鍨嬮寰堝ソ鐢級銆?br>
        路 <b>绛旀锛?/b> 鍗曢€夊啓 <b>D</b>锛屽閫夊啓 <b>ABD</b>锛?b>瑙ｆ瀽锛?/b> 鍚庨潰鍙互鍐欏琛屻€?br>
        路 涔熸敮鎸?JSON锛?b>[{"stem":"鈥?,"options":["鈥?],"answer":["D"],"explain":"鈥?}]</b>
      </div>
    </details>`;

  $('ta').value = remembered;
  /* 鎵归噺瀵煎叆鏁翠釜鏂囦欢澶癸紙bf-folder.js锛?*/
  if (typeof BFF !== 'undefined' && BFF && BFF.attach) { try { BFF.attach(); } catch (e) {} }
  on('pickFile', () => $('fileInput').click());
  on('fileInput', e => {
    const f = e.target.files[0]; if (!f) return;
    const r = new FileReader();
    r.onload = () => { $('ta').value = r.result; toast('宸茶鍙?' + f.name); };
    r.readAsText(f, 'utf-8');
  }, 'change');
  on('doFormat', () => { $('ta').value = SAMPLE; });
  on('aiFormat', doAiFormat);
  on('doPreview', doPreview);
  on('doSave', doSave);
}

function parseInput(text, nameHint) {
  const t = (text || '').trim();
  if (!t) return { error: '鍐呭鏄┖鐨? };
  if (t[0] === '{' || t[0] === '[') {
    try {
      const j = JSON.parse(t);
      const b = Array.isArray(j) ? { questions: j } : j;
      const qs = (b.questions || []).map((q, i) => normalizeQ(q, i + 1));
      if (!qs.length) return { error: 'JSON 閲屾病鎵惧埌棰樼洰锛堥渶瑕?questions 鏁扮粍锛? };
      return { bank: { title: b.title || nameHint || '鏈懡鍚嶉搴?, subtitle: b.subtitle || '', questions: qs }, warns: [] };
    } catch (e) { return { error: 'JSON 瑙ｆ瀽澶辫触锛? + e.message }; }
  }
  return parseText(t, nameHint);
}

const SAMPLE = `# 鎴戠殑棰樺簱

1. 涓嬪垪閫夐」涓彲浣块楠艰倢鏉惧紱鐨勬槸
A. 淇冧娇Ca2+杩涘叆杩愬姩绁炵粡鏈ⅱ
B. 鍑忓皯缁嗚優澶栨恫鐨凪g2+娴撳害
C. 鎶戝埗鑳嗙⒈閰叾鐨勬椿鎬?D. 闃绘柇缁堟澘鑶滈潪閫夋嫨鎬ч€氶亾
绛旀锛欴
瑙ｆ瀽锛氱粓鏉胯啘涓奛2鍨婣Ch鍙椾綋琚樆鏂悗锛孉Ch涓嶈兘寮曡捣缁堟澘鐢典綅锛岄楠艰倢鏉惧紱銆俙;

function parseText(text, nameHint) {
  const lines = text.split(/\r?\n/);
  const warns = [];
  const splitTags = s => String(s || '').split(/[,锛屻€?锛沑/|]+/).map(x => x.trim()).filter(Boolean).slice(0, 6);
  let bankTitle = '', group = '', cur = null;
  const out = [];
  const RE_OPT = /^\s*([A-Ha-h])\s*[.銆侊紟)锛?锛歖\s*(.+)$/;
  const RE_ANS = /^\s*(?:姝ｇ‘)?绛旀\s*[:锛歖?\s*([A-Ha-h][A-Ha-h\s,锛屻€乗/|]*)\s*$/;
  const RE_EXP = /^\s*(?:瑙ｆ瀽|瑙ｉ噴|鑰冪偣)\s*[:锛歖?\s*(.*)$/;
  const RE_TAG = /^\s*(?:鏍囩|鑰冪偣鏍囩)\s*[:锛歖\s*(.+)$/;                                     /* 鏍囩锛氱値鐥?鍏嶇柅搴旂瓟 */
  const RE_TAG2 = /^\s*鑰冪偣\s*[:锛歖\s*([^銆傦紱锛侊紵]{1,24})$/;                                    /* 鑰冪偣锛氱値鐥?鍏嶇柅搴旂瓟锛堢煭涓斿甫鍒嗛殧绗︽墠绠楁爣绛撅級 */
  const RE_NUM = /^\s*(?:绗琝s*)?(\d+)\s*(?:[.銆侊紟)锛?锛歖|\s)\s*(.+)$/;

  const finish = () => {
    if (!cur) return;
    cur.stem = cur.stem.trim();
    cur.explain = cur.explain.trim();
    if (!cur.stem) { cur = null; return; }
    if (cur.options.length < 2) warns.push(`銆?{cur.stem.slice(0, 14)}鈥︺€嶉€夐」灏戜簬2涓猔);
    if (!cur.answer.length) warns.push(`銆?{cur.stem.slice(0, 14)}鈥︺€嶆病鏈夌瓟妗堬紝宸茶烦杩嘸);
    const bad = cur.answer.some(a => 'ABCDEFGH'.indexOf(a) >= cur.options.length);
    if (bad) warns.push(`銆?{cur.stem.slice(0, 14)}鈥︺€嶇瓟妗堣秴鍑洪€夐」鑼冨洿`);
    if (cur.stem && cur.options.length >= 2 && cur.answer.length && !bad) {
      out.push({ id: out.length + 1, stem: cur.stem, options: cur.options, answer: cur.answer, explain: cur.explain, group: cur.group, groupTitle: cur.groupTitle, tags: cur.tags || [] });
    }
    cur = null;
  };
  const newQ = (stem, g) => ({ stem: stem, options: [], answer: [], explain: '', tags: [], group: g || '', groupTitle: g ? '鍏辩敤棰樺共' : '', mode: 'stem' });

  for (const raw of lines) {
    const s = raw.replace(/\s+$/, '').trim();
    if (!s) continue;
    const mG = s.match(/^#{2,}\s+(\S.*)$/) || s.match(/^#{2,}(?![\d#\s])(.+)$/);   /* ##鍏辩敤棰樺共 / ## 鍏辩敤棰樺共 閮借 */
    if (mG) { finish(); group = mG[1].trim(); continue; }
    const mT = s.match(/^#\s+(\S.*)$/) || s.match(/^#(?![\d#\s])(.+)$/);              /* #棰樺簱鍚?/ # 棰樺簱鍚?閮借锛?1 寮€澶寸殑涓嶇畻鏍囬 */
    if (mT) { if (!bankTitle) bankTitle = mT[1].trim(); continue; }
    const mAns = s.match(RE_ANS);
    if (mAns && cur) { cur.answer = Array.from(new Set(mAns[1].toUpperCase().replace(/[^A-H]/g, '').split(''))).sort(); cur.mode = 'explain'; continue; }
    const mTag = s.match(RE_TAG);
    if (mTag && cur) { cur.tags = (cur.tags || []).concat(splitTags(mTag[1])); cur.mode = 'explain'; continue; }
    const mTag2 = s.match(RE_TAG2);
    if (mTag2 && cur && /[,锛屻€?锛沑/|]/.test(mTag2[1])) { cur.tags = (cur.tags || []).concat(splitTags(mTag2[1])); cur.mode = 'explain'; continue; }
    const mExp = s.match(RE_EXP);
    if (mExp && cur) { cur.explain = mExp[1] || ''; cur.mode = 'explain'; continue; }
    const mOpt = s.match(RE_OPT);
    if (mOpt && cur && !cur.answer.length && cur.options.length < 8) { cur.options.push(mOpt[2].trim()); cur.mode = 'opt'; continue; }
    const mNum = s.match(RE_NUM);
    if (mNum && mNum[2] && mNum[2].trim().length > 1) {
      if (!cur) { cur = newQ(mNum[2].trim(), group); continue; }
      if (cur.answer.length || cur.options.length) { finish(); cur = newQ(mNum[2].trim(), group); continue; }
    }
    if (!cur) { cur = newQ(s, group); continue; }
    if (cur.mode === 'explain' || (cur.answer.length && cur.options.length)) cur.explain += (cur.explain ? '\n' : '') + s;
    else if (cur.mode === 'opt') { cur.explain += (cur.explain ? '\n' : '') + s; cur.mode = 'explain'; }
    else cur.stem += (cur.stem ? '\n' : '') + s;
  }
  finish();
  if (!out.length) return { error: '娌¤В鏋愬嚭棰樼洰锛屾鏌ヤ竴涓嬮€夐」鏄笉鏄敤 A. B. C. D. 寮€澶淬€佺瓟妗堟槸涓嶆槸鍐欐垚浜嗐€岀瓟妗堬細D銆? };
  return { bank: { title: bankTitle || nameHint || '鏈懡鍚嶉搴?, subtitle: '', questions: out }, warns: warns };
}

/* 涓€閿?AI 鏍囧噯鍖栵細鍙暣鐞嗘牸寮忥紝涓嶆敼绛旀锛涘け璐ヤ繚鐣欏師鏂?*/
async function doAiFormat() {
  const ta = $('ta'), btn = $('aiFormat'), host = $('preview');
  if (!ta || !btn) return;
  const raw = String(ta.value || '').trim();
  if (!raw) { toast('鍏堟妸瑕佹暣鐞嗙殑棰樼洰绮樿繘鏉?, 2200, 'warn'); return; }
  const cfg = (typeof aiCfg === 'function') ? aiCfg() : null;
  if (typeof aiChat !== 'function' || !cfg || !cfg.base || !cfg.model) {
    toast('杩樻病閰嶇疆 AI銆傚厛鍘汇€孉I 涓庣煡璇嗗簱銆嶅～鎺ュ彛鍜屾ā鍨嬶紝鍐嶅洖鏉ョ偣杩欎釜鎸夐挳', 3600, 'warn');
    return;
  }
  if (raw.length > 200000) {
    toast('鍐呭澶暱锛? + raw.length + ' 瀛楋級锛屼竴娆℃渶澶?20 涓囧瓧锛屽厛鍒嗕袱閮ㄥ垎', 3600, 'warn');
    return;
  }
  const titleHint = $('bankTitle') ? $('bankTitle').value.trim() : '';
  const sys = [
    '浣犳槸棰樺簱鏍煎紡鏁寸悊鍣ㄣ€傛妸鐢ㄦ埛缁欑殑鍘熷棰樼洰鏁寸悊鎴愬埛棰樼珯鑳界洿鎺ヨВ鏋愮殑绾枃鏈搴撱€?,
    '鍙緭鍑烘暣鐞嗗悗鐨勯搴撴枃鏈紱涓嶈瑙ｉ噴銆佷笉瑕?Markdown 浠ｇ爜鍧椼€佷笉瑕?JSON銆佷笉瑕佽〃鏍笺€?,
    '鏍囧噯鏍煎紡锛?,
    '# 棰樺簱鍚嶏紙鍘熸枃鏈夊氨娌跨敤锛屾病鏈夊氨鏍规嵁鍐呭璧蜂竴涓級',
    '',
    '1. 棰樺共锛堜繚鐣欏畬鏁撮鎰忥級',
    'A. 閫夐」',
    'B. 閫夐」',
    'C. 閫夐」',
    'D. 閫夐」',
    '绛旀锛欴',
    '瑙ｆ瀽锛氣€︹€?,
    '',
    '2. 鈥︹€?,
    '瑕佹眰锛?,
    '- 淇濈暀鍘熸枃鎵€鏈夐鐩紝涓嶅涓嶅噺锛涢骞层€侀€夐」銆佺瓟妗堛€佽В鏋愰兘涓嶈鏀瑰啓鍖诲鍚箟銆?,
    '- 澶氶€夐绛旀杩炲啓锛屽 ABD銆?,
    '- 绛旀鍜岃В鏋愬繀椤诲悇鑷崟鐙竴琛岋紝鍒嗗埆浠ャ€岀瓟妗堬細銆嶃€岃В鏋愶細銆嶅紑澶淬€?,
    '- 鍘熸枃娌℃湁瑙ｆ瀽灏辩暀绌猴紝涓嶈缂栭€狅紱鍘熸枃娌℃湁閫夐」涓嶈纭€犻€夐」銆?,
    '- 鍘绘帀銆屼緥棰樸€嶃€岀瓟妗堝湪涓嬫柟銆嶃€屾潵婧愩€嶇瓑涓庨鐩棤鍏崇殑鎺掔増鏂囧瓧銆?,
    '- 濡傛灉鍘熸枃鏄〃鏍?澶氭爮锛屾寜棰樺彿鎷嗘垚涓婇潰鐨勭嚎鎬ф牸寮忋€?
  ].join('\n');
  const user = (titleHint ? '棰樺簱鍚嶆彁绀猴細' + titleHint + '\n\n' : '') + '銆愬師濮嬪唴瀹广€慭n' + raw;
  const old = btn.textContent;
  btn.disabled = true; btn.textContent = 'AI 鏁寸悊涓€?;
  host.innerHTML = '<div class="note">姝ｅ湪璋冪敤 AI 鏁寸悊鏍煎紡锛涘彧鏀规帓鐗堬紝涓嶆敼绛旀銆?/div>';
  try {
    /* 绗?鈶?鏉★細闀垮唴瀹逛笉鍐嶆嫆鏀垛€斺€旀寜棰樺彿/绌鸿鍒囨垚 鈮?2000 瀛楃殑鍑犳锛岄€愭鏁寸悊鍐嶅悎骞躲€?       鍗曟鐩存帴涓€娆¤皟鐢紝琛屼负璺熶互鍓嶄竴鏍枫€?*/
    const CHUNK = 12000;
    const pieces = (function (s) {
      if (s.length <= CHUNK) return [s];
      const out = [];
      let rest = s;
      while (rest.length > CHUNK) {
        let cut = rest.lastIndexOf('\n\n', CHUNK);
        if (cut < CHUNK * 0.4) cut = rest.lastIndexOf('\n', CHUNK);
        if (cut < CHUNK * 0.3) cut = CHUNK;
        out.push(rest.slice(0, cut));
        rest = rest.slice(cut);
      }
      if (rest.trim()) out.push(rest);
      return out;
    })(raw);
    const askOne = async (body, idx, total) => {
      const user = (titleHint ? '棰樺簱鍚嶆彁绀猴細' + titleHint + '\n' : '')
        + (total > 1 ? '杩欐槸鏁翠唤鍐呭鐨勭 ' + idx + ' / ' + total + ' 娈碉細鍙暣鐞嗚繖涓€娈碉紝涓嶈琛ヤ笂涓€娈垫病鏈夌殑棰橈紱'
          + (idx > 1 ? '涓嶈閲嶅杈撳嚭棰樺簱鍚嶈繖涓€琛岋紙鍙繖涓€娈甸櫎澶栵級锛歕n' : '\n') : '')
        + '\n銆愬師濮嬪唴瀹广€慭n' + body;
      const out = await aiChat(
        [{ role: 'system', content: sys }, { role: 'user', content: user }],
        null, null, { stream: false, temp: 0.1 }
      );
      let t = String(out || '').trim();
      if (window.CHAT && typeof CHAT.normalizeBankText === 'function') t = CHAT.normalizeBankText(t);
      return t.replace(/^```[a-zA-Z]*\s*\n?/, '').replace(/```\s*$/, '').trim();
    };
    let text = '';
    if (pieces.length === 1) {
      text = await askOne(raw, 1, 1);
    } else {
      const got = [];
      for (let i = 0; i < pieces.length; i++) {
        btn.textContent = 'AI 鏁寸悊涓€?' + (i + 1) + '/' + pieces.length + ')';
        host.innerHTML = '<div class="note">姝ｅ湪鍒嗘鏁寸悊锛氱 ' + (i + 1) + ' / ' + pieces.length + ' 娈碉紙姣忔鍗曠嫭鏁寸悊锛屾渶鍚庢嫾璧锋潵锛夛紱鍙敼鎺掔増锛屼笉鏀圭瓟妗堛€?/div>';
        const one = await askOne(pieces[i], i + 1, pieces.length);
        if (one) got.push(one);
      }
      if (!got.length) throw new Error('AI 姣忔閮借繑鍥炵┖鍐呭');
      /* 鍚堝苟锛氱浜屾寰€鍚庡鏋滃張甯︿簡涓€閬嶃€? 棰樺簱鍚嶃€嶏紝鍘绘帀瀹?*/
      text = got.map((g, i2) => i2 === 0 ? g : g.replace(/^#\s*[^\n]*\n+/, '')).join('\n\n');
    }
    if (!text) throw new Error('AI 杩斿洖绌哄唴瀹?);
    ta.value = text;
    doPreview();
    const r = parseInput(text, titleHint);
    if (r.error) toast('AI 鏁寸悊瀹屾垚锛屼絾杩樻病瑙ｆ瀽鎴愰搴擄細' + r.error, 4200, 'warn');
    else toast('AI 鏁寸悊瀹屾垚锛? + r.bank.questions.length + ' 棰? + (pieces.length > 1 ? '锛堝垎 ' + pieces.length + ' 娈垫暣鐞嗭級' : '') + '锛屾鏌ュ悗淇濆瓨', 2600, 'ok');
  } catch (e) {
    host.innerHTML = '<div class="note err">AI 鏁寸悊澶辫触锛? + esc((e && e.message) || String(e)) + '</div>';
    toast('AI 鏁寸悊澶辫触锛屽師鏂囧凡淇濈暀', 3000, 'bad');
  } finally {
    btn.disabled = false; btn.textContent = old;
  }
}

function doPreview() {
  const r = parseInput($('ta').value, $('bankTitle').value.trim());
  const host = $('preview');
  if (r.error) { host.innerHTML = `<div class="note err">${esc(r.error)}</div>`; return; }
  const qs = r.bank.questions;
  if (!$('bankTitle').value.trim()) $('bankTitle').value = r.bank.title;
  const single = qs.filter(q => q.answer.length === 1).length;
  const dup = dupCheck(qs, EDIT_ID);
  /* 绗?鈶?鏉★細棰勮鍗℃妸淇℃伅缁欏叏鈥斺€旈鍨嬪垎甯?+ 寰呭涔犳鍐?+ 鍙互鍏堝仛鍑犻亾 */
  const tcount = { A1: 0, A2: 0, B1: 0, X: 0, C: 0 };
  const typed = qs.map(q => { const t = (typeof qTypeOf === 'function') ? qTypeOf(q) : 'A1'; tcount[t] = (tcount[t] || 0) + 1; return t; });
  const typedTxt = ['A1', 'A2', 'B1', 'X', 'C'].filter(t => tcount[t]).map(t => (TYPE_NAMES[t] || t) + ' ' + tcount[t]).join(' 路 ');
  const dueN = qs.length;   /* 鏂板叆搴撶殑棰橀兘绠椼€屽緟澶嶄範銆嶏紙SRS 閲屾病鏈夎褰?= 鍒版湡锛?*/
  const defN = Math.min(10, dueN);
  host.innerHTML = `
    <div class="note ok">瑙ｆ瀽鎴愬姛锛?b>${qs.length}</b> 棰橈紙鍗曢€?${single}锛屽閫?${qs.length - single}锛?/div>
    ${typedTxt ? `<div class="small muted">棰樺瀷锛?{esc(typedTxt)}</div>` : ''}
    <div class="small muted">寰呭涔狅細<b>${dueN}</b> 棰橈紙棰樺彿 ${qNo(qs[0], qs)}鈥?{qNo(qs[qs.length - 1], qs)}锛屾柊鍏ュ簱榛樿鍏ㄩ儴寰呭涔狅級</div>
    <div class="tools" style="margin:8px 0 2px">
      <span class="tl">淇濆瓨鍚庡厛澶嶄範</span>
      <input class="num" id="impRevN" type="number" min="1" max="${dueN}" value="${defN}" style="width:76px">
      <span class="tl">閬?/span>
      <button class="btn primary" id="impRevGo">淇濆瓨骞跺紑濮嬪涔?/button>
      <span class="small muted">鍙仛鎴愪复鏃跺鍗凤紝涓嶈繘濂楀嵎鍒楄〃</span>
    </div>
    ${r.warns.length ? `<div class="note">${r.warns.map(esc).join('<br>')}</div>` : ''}
    ${dupHtml(dup)}
    <div class="sec-t">鍓?3 棰橀瑙?/div>
    ${qs.slice(0, 3).map(q => `
      <div class="card" style="margin-bottom:10px">
        <div class="qno small">绗?${qNo(q, qs)} 棰?路 ${q.answer.length > 1 ? '澶氶€? : '鍗曢€?}${typed.length ? ' 路 ' + esc(TYPE_NAMES[typed[qs.indexOf(q)]] || typed[qs.indexOf(q)]) : ''}</div>
        ${q.group ? `<div class="gstem"><b>鍏辩敤棰樺共锛?/b>${stemHtml(q.group)}</div>` : ''}
        <div style="margin:6px 0">${stemHtml(q.stem)}</div>
        <div class="small">${q.options.map((o, i) => esc('ABCDEFGH'[i] + '. ') + stemHtml(o)).join('<br>')}</div>
        <div class="small" style="margin-top:6px;color:var(--ok)">绛旀锛?{q.answer.join('')}</div>
        ${q.explain ? `<div class="small muted" style="margin-top:4px">瑙ｆ瀽锛?{renderRich('', q.explain)}</div>` : ''}
      </div>`).join('')}`;
  const rv = $('impRevGo');
  if (rv) rv.onclick = () => {
    const n = Math.max(1, Math.min(dueN, +($('impRevN') && $('impRevN').value) || defN));
    doSave({ reviewN: n });
  };
}

/* 绗?鈶?鏉★細淇濆瓨鍚庡彲浠ョ洿鎺ュ紑濮嬪涔犲墠 N 閬擄紙涓存椂濂楀嵎锛屼笉杩涘鍗峰垪琛級 */
function startReviewOf(bank, n) {
  try {
    const qs = (bank && bank.questions) || [];
    if (!qs.length) return false;
    const k = Math.max(1, Math.min(qs.length, n || 10));
    makePaper(bank.title + ' 路 鍏堝涔?' + k + ' 閬?, qs.slice(0, k).map(q => kOf(bank, q)), { transient: true });
    return true;
  } catch (e) { return false; }
}

function doSave(opts) {
  opts = opts || {};
  const r = parseInput($('ta').value, $('bankTitle').value.trim());
  if (r.error) { $('preview').innerHTML = `<div class="note err">${esc(r.error)}</div>`; return; }
  const title = $('bankTitle').value.trim() || r.bank.title;
  const qs = r.bank.questions.map((q, i) => normalizeQ(q, i + 1));
  if (EDIT_ID) {
    const bank = LOCAL.find(b => b.id === EDIT_ID);
    if (bank) {
      bank.title = title;
      bank.subtitle = (r.bank.subtitle || '鑷缓棰樺簱') + ' 路 ' + qs.length + ' 棰?;
      bank.questions = qs;
      invalidateBanks();
      writeLS(LS.banks, LOCAL);
      applyBankTags(bank);
      toast('宸叉洿鏂帮細' + title);
      if (!(opts.reviewN > 0 && startReviewOf(bank, opts.reviewN))) go('#/bank/' + bank.id);
      return;
    }
  }
  let id = 'local-' + Date.now().toString(36);
  while (LOCAL.some(b => b.id === id)) id += '-' + i2s();    // 瀵煎叆鐨勯搴撻噷鑻ュ甫浜嗛噸澶?id 涔熶笉浼氫覆鍙?  const bank = { id: id, title: title, subtitle: (r.bank.subtitle || '鑷缓棰樺簱') + ' 路 ' + qs.length + ' 棰?, createdAt: Date.now(), questions: qs };
  LOCAL.push(bank);
  invalidateBanks();
  writeLS(LS.banks, LOCAL);
  applyBankTags(bank);
  if (typeof BF !== 'undefined' && BF && BF.autoSave) { try { BF.autoSave(); } catch (e) {} }
  toast('宸蹭繚瀛橈細' + title);
  if (!(opts.reviewN > 0 && startReviewOf(bank, opts.reviewN))) go('#/bank/' + bank.id);
}

/* 瀵煎叆鐨勯搴撹嫢鍐欎簡銆屾爣绛撅細鐐庣棁,鍏嶇柅搴旂瓟銆嶏紙parseText 璁ゅ嚭鏉ョ殑锛夛紝椤烘墜钀借繘鑰冪偣鏍囩锛屽埆璁╀汉鍐嶆墦涓€閬?*/
function applyBankTags(bank) {
  try {
    if (!bank || typeof window.TAGS !== 'object' || !window.TAGS || typeof kOf !== 'function') return 0;
    const vocab = [];
    let n = 0;
    (bank.questions || []).forEach(q => {
      if (!q || !Array.isArray(q.tags) || !q.tags.length) return;
      const k = kOf(bank, q);
      window.TAGS.set(k, window.TAGS.of(k).concat(q.tags), true);
      q.tags.forEach(t => vocab.push(t));
      n++;
    });
    if (n) {
      window.TAGS.rememberVocab(vocab);
      window.TAGS.save();
      setTimeout(() => toast('椤烘墜鎵撲簡 ' + n + ' 閬撻鐨勮€冪偣鏍囩'), 700);
    }
    return n;
  } catch (e) { return 0; }
}

/* ============================================================
   瀛︿範缁熻
   ============================================================ */
/* 杩?n 澶╂瘡澶╁仛浜嗗灏戦銆佸浜嗗嚑閬擄紙鍙畻鏈夋椂闂寸殑璁板綍锛岃€佹暟鎹?ts=0 褰掍笉鍒版煇澶╋級 */
function statsDaily(days) {
  const base = new Date(); base.setHours(0, 0, 0, 0);
  const out = [], idx = {};
  const dk = d => d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
  for (let i = days - 1; i >= 0; i--) {
    const d = new Date(base.getTime() - i * 86400000);
    const o = { key: dk(d), label: (d.getMonth() + 1) + '/' + d.getDate(), n: 0, ok: 0 };
    idx[o.key] = o; out.push(o);
  }
  Object.keys(ANS).forEach(k => {
    const a = ANS[k]; if (!a || !a.ts) return;
    const o = idx[dk(new Date(a.ts))];
    if (!o) return;
    o.n++; if (a.ok) o.ok++;
  });
  return out;
}

/* 浠婂ぉ璇ュ涔犵殑棰橈細鍒版湡鐨勯敊棰橈紝鏃╁埌鏈熺殑鎺掑墠闈?*/
function dueKeys(limit) {
  const out = [];
  baseBanks().forEach(b => b.questions.forEach(q => { const k = kOf(b, q); if (isDue(k)) out.push(k); }));
  out.sort((a, b) => (dueOf(a) || 0) - (dueOf(b) || 0));
  return limit ? out.slice(0, limit) : out;
}
function startReview(limit) {
  const cap = +srsCfg().daily || 0;                  // 0 = 涓嶉檺
  const max = Math.min(limit && limit > 0 ? limit : 9999, cap || 9999);
  const today = new Date().toISOString().slice(0, 10);
  /* 鍚屼竴澶╅噸澶嶇偣銆屼粖鏃ュ涔犮€嶏細鐩存帴鍥炲埌浠婂ぉ閭ｄ唤涓存椂澶嶄範鍗凤紙鍙湪鍐呭瓨閲岋紝涓嶈繘濂楀嵎鍒楄〃锛?*/
  if (LIVE_PAPER && LIVE_PAPER.kind === 'review' && LIVE_PAPER.day === today) {
    go('#/bank/' + LIVE_PAPER.id); return;
  }
  const ks = dueKeys(max);
  if (!ks.length) {
    /* 鐢ㄦ埛瑕佹眰锛坢03094锛夛細姣忔棩澶嶄範涓嶈鑷姩鐢熸垚濂楀嵎 鈥斺€?娌℃湁鍒版湡棰樺氨鍙彁绀猴紝涓嶇粍鍗?*/
    toast('浠婂ぉ娌℃湁鍒版湡鐨勫涔犻锛屾帴鐫€鍒烽灏卞ソ');
    return;
  }
  makePaper('浠婃棩澶嶄範 路 ' + ks.length + ' 棰?, ks, { kind: 'review', day: today, transient: true });
}

function renderStats() {
  $('appTitle').textContent = '瀛︿範缁熻';
  $('stat').textContent = ''; $('bar').style.width = '0%';

  const banks = baseBanks();
  let recN = 0, okN = 0, triesN = 0, undated = 0;
  Object.keys(ANS).forEach(k => {
    const a = ANS[k]; if (!a) return;
    if (!a.ts) { undated++; return; }
    recN++; triesN += (a.tries || 1); if (a.ok) okN++;
  });
  const T = todayStats();

  const days = statsDaily(14);
  const maxN = Math.max(1, ...days.map(d => d.n));
  const sumN = days.reduce((a, d) => a + d.n, 0), sumOk = days.reduce((a, d) => a + d.ok, 0);
  const dueN = dueKeys(0).length;

  const rows = banks.map(b => {
    let done = 0, ok = 0, wr = 0;
    b.questions.forEach(q => {
      const a = ANS[kOf(b, q)];
      if (a && !a.redo) { done++; if (a.ok) ok++; }
      if (a && (a.wrong || 0) > 0) wr++;
    });
    return { b: b, done: done, wr: wr, n: b.questions.length, acc: done ? Math.round(ok / done * 100) : 0 };
  });

  const tops = [];
  banks.forEach(b => b.questions.forEach(q => {
    const a = ANS[kOf(b, q)];
    if (a && (a.wrong || 0) > 0) tops.push({ b: b, q: q, a: a });
  }));
  tops.sort((x, y) => (y.a.wrong || 0) - (x.a.wrong || 0) || (y.a.tries || 0) - (x.a.tries || 0));

  const none = !recN && !sumN;
  $('view').innerHTML = `
    <div class="card">
      <div class="stats">
        <button class="hst" data-jump="secBanks" title="鐪嬩笅闈㈠悇棰樺簱鐨勬纭巼"><b>${recN}</b><span>绱鍋氶</span></button>
        <div class="hst-plain"><b>${triesN}</b><span>绱浣滅瓟娆℃暟</span></div>
        <button class="hst" data-jump="secBanks" title="鐪嬩笅闈㈠悇棰樺簱鐨勬纭巼"><b>${recN ? Math.round(okN / recN * 100) : 0}%</b><span>绱姝ｇ‘鐜?/span></button>
        <button class="hst" data-jump="secDays" title="鐪嬭繎 14 澶╃殑鏌卞瓙"><b>${T.dNum}</b><span>浠婃棩宸茬瓟</span></button>
        <button class="hst" data-jump="secDays" title="鐪嬭繎 14 澶╃殑鏌卞瓙"><b>${T.streak}</b><span>杩炵画澶╂暟</span></button>
        <button class="hst${dueN ? '' : ' off'}" ${dueN ? 'data-act="review"' : 'disabled'} title="${dueN ? '寮€濮嬩粖鏃ュ涔? : '浠婂ぉ娌℃湁璇ュ涔犵殑棰?}"><b>${dueN}</b><span>寰呭涔?/span></button>
      </div>
      ${none ? '<div class="note" style="margin-top:12px">杩樻病鏈変綔绛旇褰曪細鍥為椤垫寫涓€涓搴撳仛鍑犻亾锛岃繖閲屽氨鏈夋暟鎹簡銆?/div>' : ''}
      ${undated ? `<div class="small muted" style="margin-top:8px">鍙︽湁 ${undated} 鏉℃棭鏈熻褰曟病鏈夋棩鏈燂紙鑰佺増鏈暟鎹級锛屼笉璁″叆涓嬮潰鐨勮秼鍔垮浘銆?/div>` : ''}
    </div>

    ${typeof reportSectionHtml === 'function' ? reportSectionHtml() : ''}

    <h2 class="sec" id="secDays">杩?14 澶?/h2>
    <div class="card">
      <div class="tools" style="margin-top:0">
        <span class="mini-tag">鍏?${sumN} 棰?/span>
        ${sumN ? `<span class="mini-tag ok">骞冲潎姝ｇ‘鐜?${Math.round(sumOk / sumN * 100)}%</span>` : ''}
        <span class="spacer-grow"></span>
        <span class="tl" id="dayTip">鐐逛竴涓嬫煴瀛愶紝鐪嬮偅澶╃殑璇︽儏</span>
      </div>
      <div class="chart">
        ${days.map((d, i) => `<div class="cbar${d.n ? '' : ' zero'}" data-day="${i}" style="--i:${i}" title="${d.key}锛?{d.n} 棰?{d.n ? '锛屾纭巼 ' + Math.round(d.ok / d.n * 100) + '%' : ''}">
          <b>${d.n || ''}</b><i style="height:${Math.max(2, Math.round(d.n / maxN * 92))}px"></i><span>${d.label}</span>
        </div>`).join('')}
      </div>
      ${dueN ? `<div class="tools"><button class="btn primary" id="stReview">寮€濮嬩粖鏃ュ涔狅紙${dueN} 棰橈級</button></div>` : ''}
    </div>

    <details class="fold secfold" id="secBanks" open>
      <summary>鍚勯搴撴纭巼${rows.length ? `锛?{rows.length} 涓搴擄級` : ''}</summary>
      <div class="fold-body">
        ${rows.length ? rows.map(r => `<button class="srow srow-go" data-openbank="${esc(r.b.id)}" title="鍘诲埛杩欎釜棰樺簱">
        <span class="sname">${esc(r.b.title)}</span>
        <span class="sbar"><i style="width:${r.acc}%"></i></span>
        <span class="sval">${r.acc}%銆€宸茬瓟 ${r.done}/${r.n}銆€閿欓 ${r.wr}</span>
        <span class="chev">鈥?/span>
      </button>`).join('') : '<div class="empty">杩樻病鏈夐搴?/div>'}
      </div>
    </details>

    <h2 class="sec">閿欏緱鏈€澶氱殑棰?/h2>
    <div class="card">
      ${tops.length ? tops.slice(0, 12).map((t, i) => `<div class="srow srow-go" data-openbank="${esc(t.b.id)}" data-goto="${esc(String(t.q.id))}" title="鍘诲仛杩欓亾棰?>
        <span class="wno">${i + 1}</span>
        <span class="sname" style="flex:1 1 auto" title="${esc(t.q.stem)}">${esc(t.q.stem.slice(0, 40))}${t.q.stem.length > 40 ? '鈥? : ''}</span>
        <span class="sval">閿?${t.a.wrong || 0} / 鍋?${t.a.tries || 0}</span>
        <span class="chev">鈥?/span>
      </div>`).join('') : '<div class="empty">杩樻病鏈夐敊棰橈紝缁х画淇濇寔銆?/div>'}
    </div>

    ${typeof tagStatsHtml === 'function' ? `<h2 class="sec" id="secTags">鎸夎€冪偣锛堢煡璇嗙偣鏍囩锛?/h2>${tagStatsHtml()}` : ''}`;

  /* 缁熻椤电殑鐐瑰嚮锛氭暟瀛楀潡婊氬埌瀵瑰簲鍖哄潡銆侀搴撹鐩存帴杩涢搴撱€佹煴瀛愮湅褰撳ぉ璇︽儏 */
  document.querySelectorAll('#view [data-jump]').forEach(el => el.onclick = () => {
    const t = $(el.dataset.jump);
    if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  const rvBtn = document.querySelector('#view [data-act="review"]');
  if (rvBtn) rvBtn.onclick = () => startReview(60);
  document.querySelectorAll('#view [data-openbank]').forEach(el => el.onclick = () => {
    const b = bankById(el.dataset.openbank); if (!b) return;
    if (el.dataset.goto) { QZ.filter = 'wrong'; QZ.order = null; QZ.cur = el.dataset.goto; QZ.focusCur = true; }
    go('#/bank/' + b.id);
  });
  const bars = document.querySelectorAll('#view .cbar');
  bars.forEach(el => el.onclick = () => {
    const d = days[+el.dataset.day]; if (!d) return;
    bars.forEach(x => x.classList.remove('on'));
    el.classList.add('on');
    const tip = $('dayTip');
    if (tip) tip.innerHTML = `<b>${d.key}</b>锛?{d.n} 棰?{d.n ? '锛屾纭巼 ' + Math.round(d.ok / d.n * 100) + '%' : '锛堥偅澶╂病鍋氶锛?}`;
  });
  on('stReview', () => startReview(60));
  /* 銆屾寜鑰冪偣銆嶅尯鍧楋細鍒锋渶寮辫€冪偣 / 鑰冪偣璇嶈〃锛堝鍏ワ級/ AI 鎵撴爣绛?*/
  if (typeof bindTagStats === 'function') { try { bindTagStats($('view')); } catch (e) {} }
  /* 銆屽鎯呰瘖鏂€嶅尯鍧楋細鍒囨椂闂寸獥銆佺敓鎴愩€佸仠姝€佸巻鍙叉姤鍛?*/
  if (typeof bindReport === 'function') { try { bindReport($('view')); } catch (e) {} }
}

/* ============================================================
   瀵煎叆鏌ラ噸锛氱矘璐寸殑棰樺簱鍜屽凡鏈夐搴撱€佷互鍙婅嚜韬湁娌℃湁閲嶅棰樺共
   ============================================================ */
const normStem = s => String(s || '').replace(/\s+/g, '').replace(/[锛屻€傦紱锛氥€侊紵锛?.;:?!锛堬級()銆愩€慭[\]"'鈥溾€濃€樷€橾/g, '').toLowerCase();

function dupCheck(qs, excludeId) {
  const have = {};
  baseBanks().forEach(b => {
    if (b.id === excludeId) return;
    b.questions.forEach(q => {
      const k = normStem(q.stem); if (!k) return;
      (have[k] = have[k] || { titles: {} }).titles[b.title] = 1;
    });
  });
  const self = {}, dup = [], repeat = [];
  qs.forEach(q => {
    const k = normStem(q.stem); if (!k) return;
    if (have[k]) dup.push({ stem: q.stem, titles: Object.keys(have[k].titles) });
    if (self[k]) repeat.push(q.stem); else self[k] = 1;
  });
  return { dup: dup, repeat: repeat };
}
function dupHtml(d) {
  if (!d.dup.length && !d.repeat.length) return '';
  const cut = s => esc(String(s).slice(0, 44)) + (String(s).length > 44 ? '鈥? : '');
  return (d.dup.length ? `<div class="note">鏈?<b>${d.dup.length}</b> 棰樺拰鐜版湁棰樺簱閲岀殑棰樺共閲嶅锛堝彧鏄彁閱掞紝涓嶄細鑷姩鍚堝苟锛夛細<br>${d.dup.slice(0, 5).map(x => '路 ' + cut(x.stem) + ' <span class="muted">锛? + esc(x.titles.join('銆?)) + '锛?/span>').join('<br>')}${d.dup.length > 5 ? '<br>鈥? : ''}</div>` : '')
    + (d.repeat.length ? `<div class="note">绮樿创鐨勫唴瀹归噷鏈?<b>${d.repeat.length}</b> 棰橀骞查噸澶嶏細<br>${d.repeat.slice(0, 5).map(x => '路 ' + cut(x)).join('<br>')}</div>` : '');
}

/* ============================================================
   蹇嵎閿府鍔?   ============================================================ */
function showHelp() {
  let m = $('helpMask');
  if (!m) {
    m = document.createElement('div');
    m.className = 'mask'; m.id = 'helpMask';
    m.innerHTML = `<div class="sheet help-sheet">
      <div class="shead help-head"><h3>蹇嵎閿笌鎿嶄綔</h3><span class="spacer-grow"></span><button class="btn tiny" id="helpClose2">鍏抽棴</button></div>
      <div class="hint">鎵嬫満涓婄洿鎺ョ偣灏辫锛涗笅闈㈣繖浜涙槸鐢佃剳閿洏鐢ㄧ殑銆傞殢鏃舵寜 <span class="kbd">?</span> 鎵撳紑杩欓噷锛屾寜 <span class="kbd">Esc</span> 鍏虫帀銆?/div>

      <div class="help-card">
        <div class="sec-t">绛旈</div>
        <div class="help-row"><span class="kbd">A</span><span class="kbd">B</span><span class="kbd">C</span><span class="kbd">D</span><span class="spacer-grow"></span><span class="muted">閫夐€夐」锛堜篃鍙互鎸?1 2 3 4锛涘閫夐鍏堥兘閫変笂鍐嶆彁浜わ級</span></div>
        <div class="help-row"><span class="kbd">Enter</span><span class="spacer-grow"></span><span class="muted">澶氶€夐锛濇彁浜ょ瓟妗堬紱鍗曢€夋垨宸插垽鍒嗭紳涓嬩竴棰?/span></div>
        <div class="help-row"><span class="kbd">鈫?/span><span class="kbd">鈫?/span><span class="spacer-grow"></span><span class="muted">涓婁竴棰?/ 涓嬩竴棰橈紙鍒板ご浜嗘寜閽細鍙樼伆锛?/span></div>
        <div class="help-row"><span class="kbd">J</span><span class="kbd">K</span><span class="spacer-grow"></span><span class="muted">涓嬩竴棰?/ 涓婁竴棰橈紙Vim 閭ｅ锛涘拰 <span class="kbd">鈫?/span><span class="kbd">鈫?/span> 涓€鏍凤級</span></div>
        <div class="help-row"><span class="kbd">S</span><span class="spacer-grow"></span><span class="muted">鏀惰棌 / 鍙栨秷鏀惰棌褰撳墠棰橈紙鏀惰棌鎴愬姛浼氬脊涓€涓嬫彁绀猴級</span></div>
        <div class="help-row"><span class="kbd">O</span><span class="spacer-grow"></span><span class="muted">鎵撳紑绛旈鍗★細鍙寜銆屽仛閿?/ 娌″仛銆嶇瓫閫夛紝鐐归鍙风洿鎺ヨ烦杩囧幓</span></div>
      </div>

      <div class="help-card">
        <div class="sec-t">璺抽〉锛堥兘鏄厛鎸?<span class="kbd">g</span>锛屽啀鎸変竴涓嬶級</div>
        <div class="help-row"><span class="kbd">g</span><span class="kbd">h</span><span class="spacer-grow"></span><span class="muted">棣栭〉</span></div>
        <div class="help-row"><span class="kbd">g</span><span class="kbd">w</span><span class="spacer-grow"></span><span class="muted">閿欓鏈?/span></div>
        <div class="help-row"><span class="kbd">g</span><span class="kbd">s</span><span class="spacer-grow"></span><span class="muted">鎼滅储</span></div>
        <div class="help-row"><span class="kbd">g</span><span class="kbd">k</span><span class="spacer-grow"></span><span class="muted">鐭ヨ瘑搴?/span></div>
        <div class="help-row"><span class="kbd">g</span><span class="kbd">f</span><span class="spacer-grow"></span><span class="muted">鏀惰棌</span></div>
        <div class="help-row"><span class="kbd">g</span><span class="kbd">t</span><span class="spacer-grow"></span><span class="muted">瀛︿範缁熻</span></div>
        <div class="help-row"><span class="kbd">g</span><span class="kbd">g</span><span class="spacer-grow"></span><span class="muted">鍥炲埌鏈€涓婇潰锛堥暱椤甸潰鐢級</span></div>
      </div>

      <div class="help-card">
        <div class="sec-t">鎵鹃</div>
        <div class="help-row"><span class="kbd">/</span><span class="spacer-grow"></span><span class="muted">浠讳綍椤甸潰閮借兘璺冲埌鎼滅储妗?/span></div>
        <div class="help-row"><span class="kbd">Enter</span><span class="spacer-grow"></span><span class="muted">鍏夋爣鍦ㄦ悳绱㈡閲岋紳绔嬪埢鎼滐紙涓嶇敤绛夐偅 0.2 绉掞級</span></div>
        <div class="help-row"><span class="kbd">Esc</span><span class="spacer-grow"></span><span class="muted">鎼滅储妗嗛噷鏈夊瓧锛濇竻绌猴紱娌″瓧锛濆叧鎺夊脊绐?/span></div>
      </div>

      <div class="help-card">
        <div class="sec-t">鐣岄潰</div>
        <div class="help-row"><span class="kbd">?</span><span class="spacer-grow"></span><span class="muted">鎵撳紑 / 鏀惰捣杩欎釜甯姪</span></div>
        <div class="help-row"><span class="kbd">鈼?/span><span class="spacer-grow"></span><span class="muted">椤舵爮杩欎釜鎸夐挳锛氳窡闅忕郴缁?鈫?娴呰壊 鈫?娣辫壊</span></div>
      </div>

      <div class="sec-t">椤烘墜鎻愪竴鍙?/div>
      <div class="small muted help-tips">
        路 棣栭〉鏈€涓婇潰鏄€岀户缁埛棰樸€嶏紝鐩存帴鎺ョ潃涓婃鐨勯鍙枫€?br>
        路 棣栭〉閭ｆ帓鏁板瓧閮借兘鐐癸細鐐归敊棰樿繘閿欓鏈紝鐐瑰緟澶嶄範鐩存帴寮€濮嬪涔犮€?br>
        路 搴曟爮涓棿鐨勬暟瀛楃偣寮€灏辨槸绛旈鍗★紱绛斿畬鑷姩鎶婅В鏋愭粴鍒扮溂鍓嶃€?br>
        路 閿欓鏈€佹敹钘忛〉鐨勬壒閲忎笌瀵煎嚭鏀跺湪銆屾壒閲忔搷浣滀笌瀵煎嚭銆嶉噷锛岀偣涓€涓嬪睍寮€銆?br>
        路 椤舵爮銆屾枃浠躲€嶏紳鎶婅嚜寤洪搴撳瓨鎴愭湰鏈烘枃浠讹紝鎴栦粠鏂囦欢璇诲洖鏉ャ€?      </div>

      <div class="help-card">
        <div class="sec-t">绗竴娆＄敤 / 蹇樹簡鎬庝箞閰?/div>
        <div class="small muted help-tips">瀵煎叆棰樺簱銆佸埗浣滈搴撱€侀厤鐭ヨ瘑搴撱€佸～ API Key銆佷簯鍚屾 鈥斺€?閮芥湁涓€姝ヤ竴姝ョ殑寮曞锛岀偣鍝鐪嬪摢娈点€?/div>
        <div class="actions" style="margin-top:8px"><button class="btn primary" id="helpGuide">馃帗 鎵撳紑鏂版墜寮曞</button></div>
      </div>

      <div class="actions"><button class="btn primary" id="helpClose">鐭ラ亾浜?/button></div>
    </div>`;
    document.body.appendChild(m);
    m.addEventListener('click', ev => { if (ev.target === m) hideMask(m); });
  }
  m.classList.add('show');
  on('helpClose', () => hideMask(m));
  on('helpClose2', () => hideMask(m));
}

/* ============================================================
   浜嬩欢缁戝畾锛堝叏閮ㄨ蛋 on()锛屾煇涓?id 缂哄け涔熶笉浼氬奖鍝嶅叾瀹冩寜閽級
   ============================================================ */
on('prev', () => step(-1));
on('next', () => step(1));
on('btnGrid', () => { renderGrid(); $('gridMask').classList.add('show'); });
on('jumpInfo', () => { renderGrid(); $('gridMask').classList.add('show'); });
on('gridClose', closeAll);
on('btnHome', () => go('#/'));
/* 鍥哄畾杩斿洖閿細浼樺厛娴忚鍣ㄥ巻鍙诧紙hash 杩斿洖锛夛紝鐩存帴鎵撳紑鐨勫瓙椤靛氨鍥為椤?*/
on('backFix', () => { try { if (history.length > 1) history.back(); else go('#/'); } catch (e) { go('#/'); } });
on('bnHome', () => go('#/'));
on('appTitle', () => go('#/'));
on('btnGoWrong', () => go('#/wrong'));
on('btnFocusExit', () => uiSetFocus(false));
on('btnGoFav', () => go('#/fav'));
on('btnGoSearch', () => go('#/search'));
on('btnGoKb', () => go('#/kb'));
on('goKb2', () => { if (typeof closeAll === 'function') closeAll(); go('#/kb'); });
/* 璁剧疆闈㈡澘閲岀殑銆屽涔犳洸绾裤€峣d 鈫?鍙傛暟鍚?*/
const SRS_UI = { srsFirst: 'first', srsSecond: 'second', srsFactor: 'factor', srsEase0: 'ease0', srsEaseUp: 'easeUp', srsEaseDown: 'easeDown', srsMinEase: 'minEase', srsMaxIvl: 'maxIvl', srsWrongIvl: 'wrongIvl', srsDaily: 'daily' };
function srsPaintEls() {
  const c = srsCfg();
  const sel = $('srsMode');
  if (sel) {
    sel.innerHTML = Object.keys(SRS_PRESETS).map(m => '<option value="' + m + '">' + SRS_PRESETS[m].label + '</option>').join('');
    sel.value = c.mode;
  }
  Object.keys(SRS_UI).forEach(id => { const el = $(id); if (el) el.value = c[SRS_UI[id]]; });
  const f = $('srsFactor');
  if (f && f.value !== String(c.factor)) {
    const o = document.createElement('option');
    o.value = String(c.factor); o.textContent = '脳 ' + c.factor;
    f.appendChild(o); f.value = String(c.factor);
  }
  const wt = $('srsWrongToday'); if (wt) wt.checked = !!c.wrongToday;
  if ($('srsDesc')) $('srsDesc').textContent = c.desc;
  if ($('srsPreview')) $('srsPreview').textContent = srsPreviewText(c);
}
/* 鏀瑰姩鏃跺彧鍒锋柊璇存槑鍜岄瑙堬紝涓嶅姩姝ｅ湪杈撳叆鐨勯偅涓 */
function srsRepaint() {
  const c = srsCfg();
  if ($('srsDesc')) $('srsDesc').textContent = c.desc;
  if ($('srsPreview')) $('srsPreview').textContent = srsPreviewText(c);
  const sel = $('srsMode'); if (sel && sel.value !== c.mode) sel.value = c.mode;
}
function openSettings() {
  $('setExpOnOk').checked = SET.expOnOk;
  $('setAutoNext').checked = SET.autoNext;
  $('setShuffle').checked = SET.shuffle;
  $('setFxConfetti').checked = SET.fxConfetti !== false;
  $('setFxNormalBank').checked = !!SET.fxNormalBank;
  if ($('setFocus')) $('setFocus').checked = !!SET.focus;
  if ($('setSpeedSec')) $('setSpeedSec').value = SET.speedSec || 0;
  if ($('setReduceMotion')) $('setReduceMotion').checked = !!SET.reduceMotion;
  if ($('setMinimal')) $('setMinimal').checked = !!SET.minimal;
  if ($('setFrost')) $('setFrost').checked = SET.frost !== false;
  if ($('setFs')) $('setFs').value = SET.fs || 'm';
  if ($('setTextColor')) $('setTextColor').value = SET.textColor || 'auto';
  if ($('setTextColorPick')) $('setTextColorPick').value = SET.textColorPick || '#334155';
  if ($('setColor')) $('setColor').value = THEME_COLORS.indexOf(SET.color) >= 0 ? SET.color : 'teal';
  if ($('setBg')) $('setBg').value = BG_OPTIONS.indexOf(SET.bg) >= 0 ? SET.bg : 'default';
  const uiA = Math.round((isFinite(+SET.uiAlpha) && SET.uiAlpha != null ? +SET.uiAlpha : 1) * 100);
  if ($('setUiAlpha')) { $('setUiAlpha').value = uiA; if ($('setUiAlphaVal')) $('setUiAlphaVal').textContent = uiA + '%'; }
  const fpx = isFinite(+SET.frostPx) && SET.frostPx != null ? +SET.frostPx : 14;
  if ($('setFrostPx')) { $('setFrostPx').value = fpx; if ($('setFrostPxVal')) $('setFrostPxVal').textContent = fpx + 'px'; }
  if (!SRS_PRESETS[SRS.mode]) SRS.mode = 'sm2';
  srsPaintEls();
  $('setMask').classList.add('show');
}
on('btnQuizSet', openSettings);
on('btnSetAll', openSettings);
on('setTheme', e => { setLook('theme', e.target.value); paintThemeBtn(); }, 'change');
on('setFs', e => setLook('fs', e.target.value), 'change');
on('setTextColor', e => setLook('textColor', e.target.value), 'change');
on('setTextColorPick', e => { SET.textColorPick = e.target.value; setLook('textColor', 'custom'); }, 'input');
on('setColor', e => { setLook('color', e.target.value); toast('涓婚鑹叉崲鎴愩€? + (THEME_NAME[e.target.value] || '鍐烽潤闈?) + '銆?, 1400, 'ok'); }, 'change');
on('setBg', e => { const v = e.target.value; setLook('bg', v); if (v === 'custom') bgPick(); toast('鑳屾櫙鎹㈡垚銆? + (BG_NAME[v] || '榛樿寰厜') + '銆?, 1400, 'ok'); }, 'change');
on('setBgPick', bgPick);
on('setBgVideoPick', () => { const f = $('setBgVideo'); if (f) { f.value = ''; f.click(); } });
on('setBgVideo', e => { const f = e.target.files && e.target.files[0]; if (f) bgSetFromVideo(f); }, 'change');
on('setFrostPx', e => {
  SET.frostPx = +e.target.value;
  writeLS(LS.set, SET);
  applyLook();
  if ($('setFrostPxVal')) $('setFrostPxVal').textContent = e.target.value + 'px';
}, 'input');
on('setUiAlpha', e => {
  SET.uiAlpha = (+e.target.value) / 100;
  writeLS(LS.set, SET);
  applyLook();
  if ($('setUiAlphaVal')) $('setUiAlphaVal').textContent = e.target.value + '%';
}, 'input');
on('setFrost', e => { SET.frost = e.target.checked; writeLS(LS.set, SET); applyLook(); }, 'change');
on('setMinimal', e => { SET.minimal = e.target.checked; writeLS(LS.set, SET); applyLook(); }, 'change');
on('setBgClear', bgClearImage);
on('setBgFile', e => { const f = e.target.files && e.target.files[0]; if (f) bgSetFromFile(f); }, 'change');
on('closeSet', closeAll);
on('setExpOnOk', e => { SET.expOnOk = e.target.checked; writeLS(LS.set, SET); render(); }, 'change');
on('setAutoNext', e => { SET.autoNext = e.target.checked; writeLS(LS.set, SET); }, 'change');
/* 鏂规涔濓細鈿?閫熷埛闄愭椂锛堢 / 棰橈紝0 = 涓嶉檺鏃讹級鈥斺€?鍙湪閫熷埛妯″紡鐢熸晥锛屾敼瀹屽氨閲嶇敾 */
on('setSpeedSec', e => {
  SET.speedSec = Math.max(0, Math.min(300, Math.round(+e.target.value || 0)));
  e.target.value = SET.speedSec;
  writeLS(LS.set, SET);
  if (SET.quizMode === 'speed') render();
}, 'change');
on('setShuffle', e => { SET.shuffle = e.target.checked; writeLS(LS.set, SET); QZ.order = null; render(); }, 'change');
/* 搴嗙寮€鍏筹紙fx.js锛夛細鍏虫帀鏃舵妸姝ｅ湪鏀剧殑褰╁甫绔嬪埢鏀舵帀锛屽埆鐣欏湪灞忓箷涓?*/
on('setFxConfetti', e => {
  SET.fxConfetti = e.target.checked; writeLS(LS.set, SET);
  if (!SET.fxConfetti && window.FX && FX.stop) FX.stop();
}, 'change');
on('setFxNormalBank', e => {
  SET.fxNormalBank = e.target.checked; writeLS(LS.set, SET);
  if (!SET.fxNormalBank && window.FX && FX.stop) FX.stop();
}, 'change');
/* 搂3.6-P0鈶?涓撴敞妯″紡锛堣缃噷鐨勫紑鍏筹紝绛変环浜庣瓟棰橀〉鍙充笂瑙掗偅涓€屸浂 涓撴敞銆嶏級 */
on('setFocus', e => uiSetFocus(e.target.checked), 'change');
/* 鍑忓皯鍔ㄦ€佹晥鏋滐細鍕句笂/鍙栨秷绔嬪嵆鐢熸晥锛堝叧鎺夋椂鎶婃鍦ㄦ斁鐨勫僵甯︿篃鏀舵帀锛?*/
on('setReduceMotion', e => {
  setLook('reduceMotion', e.target.checked);
  if (SET.reduceMotion && window.FX && FX.stop) FX.stop();
}, 'change');
on('resetAll', () => {
  if (!confirm('娓呯┖鍏ㄩ儴棰樺簱鐨勪綔绛旇褰曪紵閿欓銆佹敹钘忋€佽嚜瀹氫箟瑙ｆ瀽銆佷复鏃跺鍗蜂細琚繚鐣欍€備笉鍙仮澶嶃€?)) return;
  tombWipe('ans'); ANS = {}; saveAns(); closeAll(); render(); toast('宸叉竻绌轰綔绛旇褰?);
});
/* 澶嶄範鏇茬嚎锛氭崲妗ｄ綅 / 閫愰」鏀瑰弬鏁?/ 涓€閿噸缃?/ 缁熶竴鏄撳害 / 鎸変慨姝ｇ瓟妗堥噸鍒?*/
on('srsMode', e => { setSrsMode(e.target.value); srsPaintEls(); }, 'change');
Object.keys(SRS_UI).forEach(id => on(id, e => {
  const f = SRS_UI[id];
  let v = e.target.value;
  if (f === 'factor') v = (v === 'ease' ? 'ease' : (+v || 2));
  else v = +v || 0;
  srsSetField(f, v);
  srsRepaint();
}, 'change'));
on('srsWrongToday', e => { srsSetField('wrongToday', !!e.target.checked); srsRepaint(); }, 'change');
on('srsReset', () => {
  const m = SRS_PRESETS[SRS.mode] ? SRS.mode : 'sm2';
  setSrsMode(m); srsPaintEls();
  toast('宸插～鍥炪€? + SRS_PRESETS[m].label + '銆嶇殑鎺ㄨ崘鍊?);
});
on('srsSyncEase', () => {
  const c = srsCfg(), n = Object.keys(ANS).length;
  if (!n) { toast('杩樻病鏈変綔绛旇褰?); return; }
  if (!confirm('鎶婄幇鏈?' + n + ' 鏉′綔绛旇褰曠殑鏄撳害缁熶竴鏀规垚 ' + c.ease0 + '锛熼棿闅斿拰鍒版湡鏃堕棿涓嶅彉銆?)) return;
  Object.keys(ANS).forEach(k => { ANS[k].ease = +c.ease0 || 2.5; });
  saveAns(); toast('宸茬粺涓€鏄撳害');
});
on('fixAllRe', () => {
  const n = Object.keys(FIX).length;
  if (!n) { toast('杩樻病鏈夋敼杩囦换浣曢鐨勭瓟妗?); return; }
  if (!confirm('鎸変慨姝ｅ悗鐨勭瓟妗堥噸鍒よ繖 ' + n + ' 閬撻鐨勫巻鍙茶褰曪紵閿欐鏁板拰澶嶄範鎺掓湡浼氫竴璧峰彉銆?)) return;
  const c = rejudgeAll();
  toast('宸查噸鍒?' + c + ' 閬撻');
  render();
});
on('expAll2', exportAllData);

/* ---------- 椤舵爮銆屸棎銆嶏細涓€閿垏鎹㈠瑙?---------- */
const THEME_ORDER = ['auto', 'light', 'dark'];
const THEME_ICON = { auto: '鈼?, light: '鈽€', dark: '鈽? };
const THEME_LABEL = { auto: '璺熼殢绯荤粺', light: '娴呰壊', dark: '娣辫壊' };
function paintThemeBtn() {
  const el = $('btnTheme'); if (!el) return;
  const t = THEME_LABEL[SET.theme] ? SET.theme : 'auto';
  el.textContent = THEME_ICON[t];
  el.title = '澶栬锛? + THEME_LABEL[t] + '锛堢偣涓€涓嬪垏鎹級';
}
on('btnTheme', () => {
  const cur = THEME_LABEL[SET.theme] ? SET.theme : 'auto';
  const next = THEME_ORDER[(THEME_ORDER.indexOf(cur) + 1) % THEME_ORDER.length];
  setLook('theme', next);
  const sel = $('setTheme'); if (sel) sel.value = next;
  paintThemeBtn();
  toast('澶栬宸插垏鎴愩€? + THEME_LABEL[next] + '銆?);
});
if (window.matchMedia) {
  try { window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => paintThemeBtn()); } catch (e) {}
}
paintThemeBtn();
document.querySelectorAll('.mask').forEach(m => m.onclick = e => { if (e.target === m) closeAll(); });

/* 搂3.6-P2鈶?鎵嬪娍澧炲己锛氱瓟棰橀〉宸﹀彸婊戝姩缈婚锛堝乏婊?= 涓嬩竴棰樸€佸彸婊?= 涓婁竴棰橈級
   涓夋潯绾緥锛氣憼 鍙湪瑙﹀睆涓婅锛坧ointerType 鏄?mouse 鐨勭洿鎺ヤ笉绠★級锛?   鈶?寰楀厛杩?30px 涓旀í鍚戞槑鏄惧ぇ浜庣旱鍚戞墠鎴愮珛 鈥斺€?涓嶇劧浼氳窡绾靛悜婊氬姩銆佺偣閫夐」銆佺偣棰樺彿鎵撴灦锛?   鈶?缈婚〉鍙皟鐜版垚鐨?step(卤1)锛屼笉鍙︾珛涓€濂椼€傚崱鐗囪窡鎵嬮偅鐐逛綅绉绘槸娆¤鐨勶紝reduced-motion 涓嬪共鑴嗕笉鍔ㄣ€?*/
const SWIPE_MIN = 30;
let _sw = null;                     /* 鎵嬩笂杩欎竴绗旓細{x,y,id,card,dx,ok} */
function uiSwipeBind() {
  const v = $('view');
  if (!v || v.dataset.swipe === '1') return;
  v.dataset.swipe = '1';
  v.addEventListener('pointerdown', e => {
    if (e.pointerType === 'mouse' || e.button) return;
    const card = e.target.closest('.card');
    if (!card || !card.querySelector('#qBody')) return;            /* 鍙棰樼洰鍗?*/
    if (e.target.closest('input, textarea, select, [contenteditable="true"], .vstrip, .qsheet, .mask')) return;
    _sw = { x: e.clientX, y: e.clientY, id: e.pointerId, card, dx: 0, ok: false };
  });
  v.addEventListener('pointermove', e => {
    if (!_sw || e.pointerId !== _sw.id) return;
    const dx = e.clientX - _sw.x, dy = e.clientY - _sw.y;
    if (!_sw.ok) {
      if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
      if (Math.abs(dx) <= Math.abs(dy)) { _sw = null; return; }    /* 寰€绾靛悜璧帮細浜ゅ洖缁欓〉闈㈡粴鍔?*/
      _sw.ok = true;
      _sw.card.classList.add('swiping');
    }
    _sw.dx = Math.max(-100, Math.min(100, dx));
    if (uiMotionOK()) _sw.card.style.transform = 'translateX(' + (_sw.dx * 0.45).toFixed(1) + 'px)';
  });
  const up = e => {
    if (!_sw || e.pointerId !== _sw.id) return;
    const st = _sw; _sw = null;
    st.card.classList.remove('swiping');
    /* 琚郴缁熸墦鏂紙pointercancel锛氭瘮濡傛祻瑙堝櫒鎶婅繖涓€绗斿綋鎴愭粴鍔ㄤ簡锛夊氨涓嶅綋缈婚〉锛?       鍏嶅緱銆屾兂婊氶〉闈㈢粨鏋滈璺充簡銆?*/
    const cut = e.type === 'pointercancel';
    if (!cut && st.ok && st.dx <= -SWIPE_MIN) { step(1); return; }  /* 宸︽粦 鈫?涓嬩竴棰?*/
    if (!cut && st.ok && st.dx >= SWIPE_MIN) { step(-1); return; }  /* 鍙虫粦 鈫?涓婁竴棰?*/
    if (st.card.style.transform) {                                  /* 娌¤繃闃堝€硷細寮瑰洖鍘熶綅 */
      if (uiMotionOK()) {
        st.card.classList.add('snapping');
        setTimeout(() => st.card.classList.remove('snapping'), 240);
      }
      st.card.style.transform = '';
    }
  };
  v.addEventListener('pointerup', up);
  v.addEventListener('pointercancel', up);
}
uiSwipeBind();

/* 搂3.6-P2鈶︼細g 鍚庨潰绗簩涓敭鍘诲摢鍎匡紙'top' 鏄洖鍒伴〉闈㈡渶涓婇潰锛屼笉鏄崲椤碉級 */
const GO_KEYS = {
  h: ['#/', '棣栭〉'],
  w: ['#/wrong', '閿欓鏈?],
  s: ['#/search', '鎼滅储'],
  k: ['#/kb', '鐭ヨ瘑搴?],
  f: ['#/fav', '鏀惰棌'],
  t: ['#/stats', '瀛︿範缁熻'],
  g: ['top', '鍥炲埌鏈€涓婇潰'],
};
let _gAt = 0;                       /* 涓婁竴娆℃寜 g 鐨勬椂闂达紝瓒呰繃 1.2 绉掑氨浣滃簾 */
document.addEventListener('keydown', e => {
  const tag = (e.target && e.target.tagName) || '';
  const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(tag) || !!(e.target && e.target.isContentEditable);
  /* 鍦ㄨ緭鍏ユ閲屾墦瀛椾竴寰嬩笉鍝嶅簲蹇嵎閿紙鍚腑鏂囪緭鍏ユ硶鐨勫€欓€夌姸鎬侊細鎷奸煶鎵撳瓧鏃舵寜绌烘牸/鍥炶溅閫夎瘝涔熶細鍐?keydown锛夈€?     杩欎竴鏉″繀椤绘斁鍦ㄦ渶鍓嶉潰 鈥斺€?鍚﹀垯鍦?AI 闈㈡澘閲屾暡瀛椾細琚綋鎴愮瓟棰橀敭锛圓鈥揌 / Enter / 鈫愨啋 / S / Esc锛夛紝
     涓€鎸夊氨鎶婃暣椤甸噸鐢汇€佹鍦ㄦ祦寮忕敓鎴愮殑瑙ｆ瀽闈㈡澘琚啿鎺夈€?*/
  if (typing || e.isComposing || e.keyCode === 229) return;
  /* ---------- 搂3.6-P2鈶?Vim 椋庢牸鍙岄敭锛氬厛鎸?g锛屽啀鎸変竴涓嬭烦椤?----------
     g h 棣栭〉 / g w 閿欓鏈?/ g s 鎼滅储 / g k 鐭ヨ瘑搴?/ g f 鏀惰棌 / g t 瀛︿範缁熻 / g g 鍥炲埌鏈€涓婇潰銆?     鍙銆?.2 绉掑唴銆嶇殑绗簩涓嬶紝涓€旀寜浜嗗埆鐨勯敭灏变綔搴燂紙涓嶄細璇激鍗曢敭锛夛紱
     椤甸潰涓婁細鍐掍竴鏉″皬鎻愮ず鍛婅瘔浣犺兘鎸変粈涔堬紝鐪佸緱璁般€?*/
  const gNow = Date.now();
  if (_gAt && gNow - _gAt >= 1200) _gAt = 0;          /* 涓婁竴鍥炵殑 g 宸茬粡杩囨湡锛屾竻鎺夊啀璁や笅涓€娆?*/
  if ((e.key === 'g' || e.key === 'G') && !e.ctrlKey && !e.metaKey && !e.altKey && !_gAt) {
    _gAt = gNow;
    if (typeof toast === 'function') toast('g 鍚庨潰鍐嶆寜涓€涓嬶細h 棣栭〉 路 w 閿欓 路 s 鎼滅储 路 k 鐭ヨ瘑搴?路 f 鏀惰棌 路 t 缁熻 路 g 椤堕儴', 1400);
    e.preventDefault();
    return;
  }
  if (_gAt && gNow - _gAt < 1200) {
    const hit = GO_KEYS[e.key.toLowerCase()];
    _gAt = 0;
    if (hit) {
      e.preventDefault();
      if (hit[0] === 'top') window.scrollTo({ top: 0, behavior: (typeof uiMotionOK === 'function' && !uiMotionOK()) ? 'auto' : 'smooth' });
      else go(hit[0]);
      return;
    }
    /* 绛夌浜屼笅鐨勬椂鍊欐寜浜嗗埆鐨勯敭锛氫粈涔堜篃涓嶅仛锛圴im 鐨勮鐭╋級鈥斺€?鍏嶅緱銆実 涔嬪悗鎵嬫粦鏁蹭簡 A銆嶆妸閫夐」閫変笂銆?       Esc 鏀捐锛岀敤鏉ヤ腑閫斿弽鎮斻€?*/
    if (e.key !== 'Escape') { e.preventDefault(); return; }
  }
  /* ? 鎵撳紑蹇嵎閿府鍔╋紙浠讳綍椤甸潰閮借兘鐢級 */
  if (e.key === '?' || (e.key === '/' && e.shiftKey)) {
    e.preventDefault();
    const hm = $('helpMask');
    if (hm && hm.classList.contains('show')) { hideMask(hm); return; }
    showHelp(); return;
  }
  if (e.key === 'Escape') { if (SET.focus) { uiSetFocus(false); return; } qSheetToggle(false); closeAll(); return; }
  const rn = route().name;
  /* 鎼滅储椤碉紙鎴栦换浣曢〉闈級锛氭寜 / 璺冲埌鎼滅储妗嗗苟鑱氱劍 */
  if (e.key === '/') {
    const focusSq = () => { const el = $('sq'); if (el) { el.focus(); el.select(); } };
    const nb = document.getElementById('nbSearch');       /* 棣栭〉閭ｄ釜鎼滅储妗嗭細灏卞湴鑱氱劍锛屼笉鐢ㄨ烦椤?*/
    if (nb) { e.preventDefault(); nb.focus(); nb.select(); return; }
    if (rn === 'search') focusSq();
    else { go('#/search'); setTimeout(focusSq, 60); }
    e.preventDefault();
    return;
  }
  if (rn !== 'quiz' && rn !== 'exam') return;
  /* AI 姝ｅ湪娴佸紡鐢熸垚锛氱瓟棰樺揩鎹烽敭鍏ㄩ儴璁╄矾锛堟暡 A鈥揌 / Enter / 鈫愨啋 / S / K 閮戒笉浼氬啀鎶婇潰鏉垮啿鎺夛級 */
  if (typeof aiBusy === 'function' && aiBusy()) return;
  const k = e.key.toUpperCase();
  if (/^[A-H]$/.test(k) || /^[1-8]$/.test(k)) {
    const K = /^[A-H]$/.test(k) ? k : 'ABCDEFGH'[+k - 1];
    const o = document.querySelector(`.opt[data-k="${K}"]`);
    if (o && !o.disabled) o.click();
    e.preventDefault(); return;
  }
  if (rn === 'exam') {
    if (e.key === 'Enter' || e.key === 'ArrowRight' || k === 'J') { if (typeof examStep === 'function') examStep(1); e.preventDefault(); return; }
    if (e.key === 'ArrowLeft' || k === 'K') { if (typeof examStep === 'function') examStep(-1); e.preventDefault(); return; }
    return;
  }
  const bank = bankById(QZ.bankId);
  const q = bank && bank.questions.find(x => String(x.id) === String(QZ.cur));
  /* S 鏀惰棌鏈銆丱 鎵撳紑绛旈鍗★紙鍘熸湰鏄?K锛岃缁?Vim 鐨勩€屼笂涓€棰樸€嶏級鈥斺€?涓嶇敤鍘诲榧犳爣锛圓鈥揌 鐣欑粰閫夐」锛?*/
  if (k === 'S' && bank && q) { toggleFav(favKey(bank, q)); e.preventDefault(); return; }
  if (k === 'O') { renderGrid(); const gm = $('gridMask'); if (gm) gm.classList.add('show'); e.preventDefault(); return; }
  /* 搂3.6-P2鈶︼細j 涓嬩竴棰?/ k 涓婁竴棰橈紙Vim 閭ｅ锛岃窡 鈫愨啋 绛変环锛?*/
  if (k === 'J') { step(1); e.preventDefault(); return; }
  if (k === 'K') { step(-1); e.preventDefault(); return; }
  if (e.key === 'Enter') {
    if (q && !answered(kOf(bank, q)) && qType(q, ansOf(favKey(bank, q), q)) === 'X' && (QZ.pending[q.id] || []).length) judge(bank, q, QZ.pending[q.id]);
    else step(1);
    e.preventDefault();
  }
  if (e.key === 'ArrowLeft') step(-1);
  if (e.key === 'ArrowRight') step(1);
});
