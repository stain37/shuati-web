    else document.documentElement.style.setProperty('--read-c',
      tc === 'ink' ? '#111827' : tc === 'blue' ? '#1d4ed8' : tc === 'brown' ? '#7c3a12'
        : tc === 'green' ? '#166534' : (SET.textColorPick || '#334155'));
